---
import { inTheWorks } from '~/data/projects';
---

<section id="in-the-works" class="relative pt-4 pb-8 sm:pt-10 sm:pb-20">
  <div class="container-x">
  <div class="reveal flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
    <div>
      <p class="eyebrow">Currently</p>
      <h3 class="h2 mt-4 flex flex-wrap items-baseline gap-x-3 gap-y-2 max-w-[24ch]">
        <span>in the</span>
        <span class="h-italic text-gradient-pink">works</span>
        <span class="imsg-dots translate-y-[-4px]" aria-label="typing">
          <span></span><span></span><span></span>
        </span>
      </h3>
    </div>
    <p class="max-w-xs text-sm" style="color: var(--ink-muted);">
      Documenting these properly soon — each one's a tab open in my head.
    </p>
  </div>

  <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
    {inTheWorks.map((h, i) => (
      <div
        class="card-lift reveal group relative aspect-[3/4] overflow-hidden rounded-2xl border border-dashed p-6 pb-10"
        style="border-color: var(--hair); background: var(--surface-soft);"
      >
        {/* Glow on hover */}
        <div class="pointer-events-none absolute inset-0 -z-0 opacity-0 transition-opacity duration-700 group-hover:opacity-100" style="background: radial-gradient(120% 80% at 50% 100%, rgba(220,155,181,0.35), transparent 60%);"></div>

        <span class="relative font-mono text-[10px]" style="color: var(--ink-faint);">{`0${i + 1}`}</span>

        <div class="relative mt-auto flex h-full flex-col justify-end gap-5 pb-4">
          <span class="relative inline-flex h-2 w-2">
            <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-cow-400 opacity-70"></span>
            <span class="relative inline-flex h-2 w-2 rounded-full bg-cow-500"></span>
          </span>
          <h4 class="font-display text-xl leading-tight tracking-tight" style="color: var(--ink);">{h.title}</h4>
          <p class="text-xs leading-relaxed" style="color: var(--ink-muted);">{h.hint}</p>
          <span class="mt-6 inline-flex items-center gap-1 text-[11px] uppercase tracking-[0.2em] text-cow-600 opacity-80 transition-opacity group-hover:opacity-100 dark:text-cow-300">
            Documenting soon
            <span class="inline-block transition-transform duration-300 group-hover:translate-x-0.5">→</span>
          </span>
        </div>
      </div>
    ))}
  </div>
  </div>
</section>
