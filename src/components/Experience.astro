---
import { roles, coursework } from '~/data/resume';
---

<section id="experience" class="relative pt-14 pb-4 sm:pt-20 sm:pb-8">
  {/* backdrop */}
  <div class="pointer-events-none absolute inset-x-0 top-1/2 -z-20 h-[120%] -translate-y-1/2 overflow-hidden">
    <div class="absolute left-1/2 top-1/2 h-[60rem] w-[60rem] -translate-x-1/2 -translate-y-1/2 rounded-full opacity-30" style="background: radial-gradient(circle, rgba(255,168,100,0.4), transparent 60%);"></div>
  </div>

  <div class="container-x">
    <div class="reveal mb-16">
      <p class="eyebrow">Experience</p>
      <div class="mt-4 flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
        <h2 class="h2">
          it's been a <span class="h-italic text-gradient-animated" style="padding-right: 0.1em;">long</span> time&nbsp;coming!
        </h2>
        <p class="max-w-sm text-sm sm:translate-y-1" style="color: var(--ink-muted);">
          A decade of receipts spanning all my eras. From running video production to repairing hardware to designing my own, I am always <em>ready for it</em>.
        </p>
      </div>
    </div>

    <ol class="relative space-y-12 border-l pl-8 sm:pl-12" style="border-color: var(--hair);">
      {roles.map((r) => (
        <li class="reveal group relative">
          {/* marker */}
          <span class="absolute -left-[35.5px] top-3 sm:-left-[51.5px]">
            <span class="marker-dot block"></span>
          </span>

          <div class="grid items-baseline gap-x-8 gap-y-2 sm:grid-cols-[1fr,2.5fr]">
            <div>
              <p class="font-mono text-xs" style="color: var(--ink-faint);">{r.years}</p>
              <p class="mt-2 text-[11px] uppercase tracking-[0.2em]" style={`color: ${r.kind === 'edu' ? 'var(--cow-pink)' : r.kind === 'volunteer' ? 'var(--ember-500)' : 'var(--ember-600)'};`}>
                {r.kind === 'edu' ? 'Education' : r.kind === 'volunteer' ? 'Volunteer' : 'Work'}
              </p>
              {r.location && (
                <p class="mt-1 text-xs" style="color: var(--ink-faint);">{r.location}</p>
              )}
            </div>
            <div>
              <h3 class="font-display text-xl tracking-tight sm:text-2xl" style="color: var(--ink);">
                {r.title}
              </h3>
              <p class="mt-1 text-sm font-medium" style="color: var(--ink-muted);">{r.org}</p>
              {r.body && (
                <p class="mt-4 max-w-2xl text-[15px] leading-relaxed" style="color: var(--ink-muted);">{r.body}</p>
              )}
              {r.bullets && (
                <ul class="mt-4 max-w-2xl list-disc space-y-2 pl-5 text-[15px] leading-relaxed marker:text-cow-600 dark:marker:text-cow-300" style="color: var(--ink-muted);">
                  {r.bullets.map((b) => (
                    <li>{b}</li>
                  ))}
                </ul>
              )}

              {/* coursework */}
              {r.kind === 'edu' && (
                <ul class="mt-3 grid max-w-xs gap-1.5 sm:grid-cols-2">
                  {coursework.map((c) => (
                    <li class="flex items-center justify-between gap-2 rounded-lg border px-2.5 py-1.5" style="border-color: var(--hair); background: var(--surface-soft);">
                      <span class="font-mono text-[11px] text-cow-600 dark:text-cow-300">{c.code}</span>
                      {c.grade ? (
                        <span class="inline-flex shrink-0 items-center rounded-full bg-cow-300/20 px-1.5 py-0.5 font-mono text-[9px] font-medium text-cow-700 dark:bg-cow-300/15 dark:text-cow-200">{c.grade}</span>
                      ) : (
                        <span class="inline-flex shrink-0 items-center rounded-full border px-1.5 py-0.5 font-mono text-[9px]" style="border-color: var(--hair); color: var(--ink-faint);" title="grade pending">…</span>
                      )}
                    </li>
                  ))}
                </ul>
              )}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
