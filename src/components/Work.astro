---
import ProjectCard from '~/components/ProjectCard.astro';
import WebShelf from '~/components/WebShelf.astro';
import { featured } from '~/data/projects';
---

<section id="work" class="relative py-20 sm:py-28">

  <div class="container-x">
    {/* Section header */}
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
      <div class="reveal">
        <p class="eyebrow">Selected works</p>
        <h2 class="h2 mt-4 max-w-[20ch]">
          Three projects I'm <span class="text-gradient">proud of</span>.
        </h2>
      </div>
      <p class="reveal max-w-sm text-sm text-ink/60">
        Hover anywhere on a card. I built each of these the long way — small,
        deliberate, never one weekend.
      </p>
    </div>

    {/* Featured grid */}
    <div class="mt-16 grid gap-7 lg:grid-cols-3">
      {featured.map((p, i) => (
        <ProjectCard project={p} index={i} />
      ))}
    </div>

    {/* Web shelf */}
    <WebShelf />
  </div>
</section>
