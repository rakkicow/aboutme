---
import ProjectCard from '~/components/ProjectCard.astro';
import WebShelf from '~/components/WebShelf.astro';
import { featured } from '~/data/projects';
---

<section id="eras" class="relative pt-6 pb-6 sm:pt-12 sm:pb-12">

  <div class="container-x">
    {/* header */}
    <div class="reveal">
      <p class="eyebrow">Selected works</p>
      <div class="mt-4 flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
        <h2 class="h2 max-w-[20ch]">
          welcome to my <span class="h-italic text-gradient-animated" style="padding-right: 0.12em;">eras</span>
        </h2>
        <p class="max-w-sm text-sm sm:translate-y-2" style="color: var(--ink-muted);">
          Good things take time; these took a while. Take a peek.
        </p>
      </div>
    </div>

    {/* grid */}
    <div class="mt-16 grid gap-12 lg:grid-cols-3 lg:gap-7">
      {featured.map((p, i) => (
        <ProjectCard project={p} index={i} />
      ))}
    </div>

    {/* shelf */}
    <WebShelf />
  </div>
</section>
