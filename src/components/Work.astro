---
import ProjectCard from '~/components/ProjectCard.astro';
import WebShelf from '~/components/WebShelf.astro';
import { featured } from '~/data/projects';
---

<section id="work" class="relative pt-6 pb-6 sm:pt-12 sm:pb-12">

  <div class="container-x">
    {/* Section header */}
    <div class="flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-center">
      <div class="reveal">
        <p class="eyebrow">Selected works</p>
        <h2 class="h2 mt-4 max-w-[20ch]">
          welcome to my <span class="h-italic text-gradient-animated" style="padding-right: 0.12em;">eras</span>
        </h2>
      </div>
      <p class="reveal max-w-sm text-sm" style="color: var(--ink-muted);">
        Good things take time; these took a while. Take a peek.
      </p>
    </div>

    {/* Featured grid */}
    <div class="mt-16 grid gap-7 lg:grid-cols-3">
      {featured.map((p, i) => (
        <ProjectCard project={p} index={i} />
      ))}
    </div>

    {/* Web shelf */}
    <WebShelf />
  </div>
</section>
