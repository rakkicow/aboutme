---
import Monogram from '~/components/Monogram.astro';
import { bio, skills, tools, languages, frameworks, coursework } from '~/data/resume';
---

<section id="about" class="relative pt-12 pb-6 sm:pt-28 sm:pb-12">
  <div class="container-x">
    <div class="grid gap-16 lg:grid-cols-[1fr,1.4fr] lg:gap-24">
      {/* zinger */}
      <div class="reveal">
        <p class="eyebrow">About <span class="h-script text-gradient-pink">me</span></p>
        <h2 class="h2 mt-4 max-w-[14ch]">
          long story <span class="text-gradient-pink-animated">short</span>.
        </h2>

        {/* cursive monogram */}
        <div class="relative mt-14">
          <Monogram size={168} stroke={1.1} withGlow />
        </div>

        {/* Quote */}
        <div class="mt-10 [container-type:inline-size]">
          <blockquote class="border-l-2 pl-5 font-display italic leading-tight whitespace-nowrap text-[clamp(1.25rem,6.3cqw,3rem)]" style="border-color: var(--cow-pink); color: var(--ink-soft);">
            "{bio.summary}"
          </blockquote>
        </div>
      </div>

      {/* Body */}
      <div class="reveal space-y-7 text-[17px] leading-relaxed sm:text-lg" style="color: var(--ink-muted);">
        <p>
          I'm Ria — a <span style="color: var(--ink);">Computer Engineering Technology</span> student
          at Purdue with minors in <span style="color: var(--ink);">Psychology, Entrepreneurship, and Computer Engineering</span>. My background is a strange but useful mix consisting of cell phone repair,
          professional video editing, full-stack project development, 3D modeling and printing, and customer service.
        </p>
        <p>
          My hands-on history made me meticulous about details. I care about user-friendly design, out-of-the-box thinking, and content that respects the person on the other side
          of the screen.
        </p>
        <p>
          Outside of class, I indulge myself in hobbies that sharpen my skills. My Etsy shop
          <a
            href="https://www.etsy.com/shop/CDIOfficial"
            target="_blank"
            rel="noopener noreferrer"
            class="underline decoration-1 underline-offset-4 transition-colors hover:text-ember-600 dark:hover:text-cow-300"
            style="color: var(--ink); text-decoration-color: var(--cow-pink);"
          >CowShopCo</a> is where I
          design and 3D print custom jewelry. I also work with local brands to increase their online presence through app/web development or content creation.
        </p>

        {/* Completed Coursework */}
        <div class="pt-6">
          <p class="text-[11px] uppercase tracking-[0.2em]" style="color: var(--ink-faint);">
            <span class="text-cow-600 dark:text-cow-300">relevant</span> Coursework
          </p>
          <ul class="mt-4 grid gap-2 sm:grid-cols-2">
            {coursework.map((c) => (
              <li class="flex items-center justify-between rounded-xl border px-3.5 py-2.5 text-sm" style="border-color: var(--hair); background: var(--surface-soft);">
                <span>
                  <span class="font-mono text-[11px] text-cow-600 dark:text-cow-300">{c.code}</span>
                  <span class="ml-2" style="color: var(--ink-soft);">{c.name}</span>
                </span>
                {c.grade ? (
                  <span class="ml-3 inline-flex items-center rounded-full bg-cow-300/20 px-2 py-0.5 font-mono text-[10px] font-medium text-cow-700 dark:bg-cow-300/15 dark:text-cow-200">{c.grade}</span>
                ) : (
                  <span class="ml-3 inline-flex items-center rounded-full border px-2 py-0.5 font-mono text-[10px]" style="border-color: var(--hair); color: var(--ink-faint);" title="grade pending">…</span>
                )}
              </li>
            ))}
          </ul>
        </div>

        {/* Languages */}
        <div id="languages" class="scroll-mt-28 pt-2">
          <p class="text-[11px] uppercase tracking-[0.2em]" style="color: var(--ink-faint);">Languages</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {languages.map((l) => (
              <span class="lang-pill inline-flex items-center gap-1.5 rounded-full border px-3 py-1 font-mono text-xs font-medium">{l}</span>
            ))}
          </div>
        </div>

        {/* Skills */}
        <div class="pt-2">
          <p class="text-[11px] uppercase tracking-[0.2em]" style="color: var(--ink-faint);">Skills</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {skills.map((s) => (
              <span class="pill">{s}</span>
            ))}
          </div>
        </div>

        <div class="pt-2">
          <p class="text-[11px] uppercase tracking-[0.2em]" style="color: var(--ink-faint);">Tools</p>
          <div class="mt-3 flex flex-wrap gap-2">
            {tools.map((t) => (
              <span class="pill !text-ember-700 dark:!bg-[#F6E0E9] dark:!border-[#DC9BB5]/60 dark:!text-[#9A4267]" style="border-color: rgba(255,168,100,0.4);">{t}</span>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
