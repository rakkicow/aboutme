---
import type { Project } from '~/data/projects';
import CardBubbles from '~/components/CardBubbles.astro';
import CardCamera from '~/components/CardCamera.astro';
import CardTerminal from '~/components/CardTerminal.astro';

interface Props {
  project: Project;
  index: number;
}

const { project, index } = Astro.props;

// Per-theme typography + chrome
type ThemeStyles = {
  index: string;
  years: string;
  title: string;
  tagline: string;
  blurb: string;
  pill: string;
  link: string;
  linkHover: string;
};
const themes: Record<Project['theme'], ThemeStyles> = {
  bubbles: {
    index: 'text-[#BBDDFF]',
    years: 'text-[#BBDDFF]',
    title: 'text-white',
    tagline: 'text-[#D5E9FF]',
    blurb: 'text-[#D5E9FF]',
    pill: 'bg-[#D8E8FF] border-[#1E7AFF]/35 text-[#0846B8]',
    link: 'text-[#E8F2FF]',
    linkHover: 'hover:text-white',
  },
  camera: {
    index: 'text-ink/55',
    years: 'text-ink/55',
    title: 'text-ink',
    tagline: 'text-ember-700',
    blurb: 'text-ink/75',
    pill: 'bg-[rgba(180,64,0,0.2)] border-ember-700/30 text-ember-800',
    link: 'text-ink/85',
    linkHover: 'hover:text-ember-700',
  },
  terminal: {
    index: 'text-cow-300/70',
    years: 'text-cow-300/70',
    title: 'text-white',
    tagline: 'text-cow-300',
    blurb: 'text-white/80',
    pill: 'bg-[#F6E0E9] border-[#DC9BB5]/45 text-[#9A4267]',
    link: 'text-white',
    linkHover: 'hover:text-cow-300',
  },
};
const s = themes[project.theme];
---

<article
  data-tilt
  data-card-theme={project.theme}
  data-card-open={project.theme === 'camera' ? '#reel' : project.theme === 'terminal' ? '#web-shelf' : undefined}
  class="project-card group reveal card-lift relative overflow-hidden rounded-[28px] p-7 sm:p-9"
  style="box-shadow: var(--shadow-glow-sm);"
>
  {/* Themed full-bleed background */}
  {project.theme === 'bubbles' && <CardBubbles />}
  {project.theme === 'camera' && <CardCamera />}
  {project.theme === 'terminal' && <CardTerminal />}

  {/* Index + years */}
  <div class={`relative flex items-start justify-between text-xs ${s.index}`}>
    <span class="font-mono">0{index + 1}</span>
    <span class={`text-right ${s.years}`}>{project.years}</span>
  </div>

  {/* Title block */}
  <div class="relative mt-8">
    <h3 class={`font-medium tracking-snug ${s.title} text-[28px] leading-[1.05] sm:text-[32px]`}>
      {project.title}
    </h3>
    <p class={`mt-2 text-sm ${s.tagline}`}>{project.tagline}</p>
  </div>

  {/* Role chip */}
  <div class="relative mt-4">
    <span class={`pill !${s.pill}`}>{project.role}</span>
  </div>

  {/* Blurb */}
  <p class={`relative mt-5 text-[15px] leading-relaxed ${s.blurb}`}>
    {project.blurb}
  </p>

  {/* Stack pills */}
  <div class="relative mt-6 flex flex-wrap gap-1.5">
    {project.stack.map((t) => (
      <span class={`inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-medium ${s.pill}`}>{t}</span>
    ))}
  </div>

  {/* Links — hash links (open the reel / shelf) render as a prominent, pulsing
      CTA so they read as an action; everything else is a plain text link. */}
  <div class="relative mt-7 flex flex-wrap items-center gap-x-5 gap-y-3">
    {project.links.map((l) => {
      const isCta = l.href.startsWith('#');
      const hasOwnArrow = /[→←↑↓↗↘↙↖]$/.test(l.label.trim());
      if (isCta) {
        return (
          <a href={l.href} class="card-cta group/cta" data-cursor-hover>
            {l.label.replace(/\s*[→↓]\s*$/, '')}
            <svg class="card-cta-arrow h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" />
            </svg>
          </a>
        );
      }
      return (
        <a
          href={l.href}
          target="_blank"
          rel="noopener noreferrer"
          class={`group/link inline-flex items-center gap-1.5 text-sm font-medium ${s.link} transition-colors ${s.linkHover}`}
        >
          {l.label}
          {!hasOwnArrow && (
            <span class="inline-block transition-transform duration-300 group-hover/link:translate-x-0.5 group-hover/link:-translate-y-0.5">↗</span>
          )}
        </a>
      );
    })}
  </div>
</article>

<script>
  // CDI (camera) and Archive (terminal) cards open their modal when clicked
  // anywhere — but real links/buttons inside still handle their own clicks.
  document.querySelectorAll<HTMLElement>('[data-card-open]').forEach((card) => {
    const sel = card.getAttribute('data-card-open');
    if (!sel) return;
    card.addEventListener('click', (e) => {
      if ((e.target as HTMLElement).closest('a, button')) return;
      (
        card.querySelector<HTMLElement>(`a[href="${sel}"]`) ??
        document.querySelector<HTMLElement>(`a[href="${sel}"]`)
      )?.click();
    });
  });
</script>
