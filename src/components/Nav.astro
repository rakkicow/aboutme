---
import Monogram from '~/components/Monogram.astro';
import ThemeToggle from '~/components/ThemeToggle.astro';

// nav links
const links = [
  { href: '#about', label: 'About' },
  { href: '#reel', label: 'Reel' },
  { href: '#web-shelf', label: 'Web Shelf' },
  { href: '#experience', label: 'Experience' },
];
---

<header
  data-nav
  data-scrolled="false"
  class="fixed inset-x-0 top-0 z-50 transition-all duration-500 py-4 sm:py-5"
>
  <div class="container-x">
    <div class="relative">
      <div
        class="liquid-glass flex items-center justify-between gap-3 rounded-full px-4 py-2 transition-all duration-500"
      >
        <a href="#top" class="group flex items-center gap-2.5 px-2 py-1 whitespace-nowrap">
          <Monogram size={34} stroke={1.1} className="nav-mono-rotate transition-transform duration-500" />
          {/* short name */}
          <span class="font-display text-xl tracking-tight transition-colors group-hover:text-ember-600 dark:group-hover:text-cow-300 max-[400px]:hidden min-[520px]:hidden" style="color: var(--ink);">Ria G.</span>
          <span class="hidden font-display text-xl tracking-tight transition-colors group-hover:text-ember-600 dark:group-hover:text-cow-300 max-[400px]:inline" style="color: var(--ink);">Ria</span>
          <span class="hidden font-display text-xl tracking-tight transition-colors group-hover:text-ember-600 dark:group-hover:text-cow-300 min-[520px]:inline" style="color: var(--ink);">Rakshita&nbsp;Gupta</span>
        </a>

        <nav class="hidden items-center gap-1 md:flex">
          {links.map((l) => (
            <a
              href={l.href}
              class="group relative whitespace-nowrap rounded-full px-3.5 py-1.5 text-sm font-medium transition-colors"
              style="color: var(--ink-soft);"
            >
              <span class="relative z-10">{l.label}</span>
              <span class="absolute inset-0 -z-0 scale-90 rounded-full bg-cow-100/60 opacity-0 transition-all duration-300 group-hover:scale-100 group-hover:opacity-100 dark:bg-cow-300/15"></span>
            </a>
          ))}
        </nav>

        <div class="flex items-center gap-2">
          {/* menu toggle */}
          <button
            type="button"
            data-menu-btn
            class="menu-btn md:!hidden"
            aria-label="Open menu"
            aria-expanded="false"
            aria-controls="mobile-menu"
            data-cursor-hover
          >
            <span class="menu-ico" aria-hidden="true"><span></span><span></span></span>
            <span class="menu-burger" aria-hidden="true">🍔</span>
          </button>

          <ThemeToggle />
          <a href="#contact" aria-label="Get in touch" class="btn-primary whitespace-nowrap !py-2 !px-4 !text-xs max-[400px]:!p-0 max-[400px]:!w-9 max-[400px]:!h-9 max-[400px]:justify-center max-[400px]:!rounded-full" data-magnetic="0.25">
            <span class="max-[400px]:hidden">Get in touch</span>
            <svg class="h-3 w-3 max-[400px]:hidden" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M7 2v10M3 8l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="hidden max-[400px]:grid place-items-center contact-icons--svg">
              <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path><polyline points="22,6 12,13 2,6"></polyline></svg>
            </span>
            <span class="hidden place-items-center contact-icons--emoji text-base leading-none">
              💌
            </span>
          </a>
        </div>
      </div>

      {/* dropdown */}
      <div
        id="mobile-menu"
        data-mobile-menu
        data-open="false"
        class="liquid-glass absolute inset-x-0 top-full z-40 mt-2 rounded-[26px] p-2 md:hidden"
      >
        <nav class="flex flex-col">
          {links.map((l) => (
            <a
              href={l.href}
              data-menu-link
              class="menu-row group relative flex items-center justify-center rounded-2xl px-4 py-3.5 text-center text-[15px] font-medium transition-colors"
              style="color: var(--ink-soft);"
            >
              <span class="relative z-10">{l.label}</span>
              <span class="absolute inset-0 -z-0 scale-[0.97] rounded-2xl bg-cow-100/60 opacity-0 transition-all duration-300 group-hover:scale-100 group-hover:opacity-100 group-active:scale-100 group-active:opacity-100 dark:bg-cow-300/15"></span>
            </a>
          ))}
        </nav>
      </div>
    </div>
  </div>
</header>

<style>
  /* menu toggle */
  .menu-btn {
    position: relative;
    display: inline-grid;
    place-items: center;
    height: 2.25rem;
    width: 2.25rem;
    border-radius: 999px;
    border: 1px solid var(--hair);
    background: var(--surface);
    color: var(--ink);
    transition: background 280ms ease, transform 280ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  @media (hover: hover) and (pointer: fine) {
    .menu-btn:hover {
      transform: translateY(-1px);
      background: var(--cow-pink-soft);
    }
  }

  .menu-ico {
    position: relative;
    width: 18px;
    height: 12px;
    transition: opacity 160ms ease;
  }
  .menu-ico > span {
    position: absolute;
    left: 0;
    right: 0;
    height: 1.6px;
    border-radius: 2px;
    background: currentColor;
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .menu-ico > span:first-child { top: 3px; }
  .menu-ico > span:last-child { bottom: 3px; }
  [aria-expanded='true'] .menu-ico > span:first-child {
    transform: translateY(2.2px) rotate(45deg);
  }
  [aria-expanded='true'] .menu-ico > span:last-child {
    transform: translateY(-2.2px) rotate(-45deg);
  }

  /* burger */
  .menu-burger {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    font-size: 1.05rem;
    opacity: 0;
    transform: scale(0.4);
    transition: opacity 180ms ease, transform 240ms cubic-bezier(0.16, 1, 0.3, 1);
    pointer-events: none;
  }
  /* hover burger */
  @media (hover: hover) and (pointer: fine) {
    .menu-btn[aria-expanded='false']:hover .menu-ico { opacity: 0; }
    .menu-btn[aria-expanded='false']:hover .menu-burger {
      opacity: 1;
      transform: scale(1);
    }
  }
  /* sticky burger */
  :global(html[data-menu-revealed]) .menu-btn[aria-expanded='false'] .menu-ico { opacity: 0; }
  :global(html[data-menu-revealed]) .menu-btn[aria-expanded='false'] .menu-burger {
    opacity: 1;
    transform: scale(1);
  }

  @media (max-width: 400px) {
    :global(html[data-menu-revealed]) .contact-icons--svg { display: none !important; }
    :global(html[data-menu-revealed]) .contact-icons--emoji { display: grid !important; }
  }

  /* dropdown */
  [data-mobile-menu] {
    transform-origin: top right;
    opacity: 0;
    visibility: hidden;
    /* closing */
    pointer-events: none;
    transform: translateY(-8px) scale(0.97);
    transition:
      opacity 300ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 300ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s linear 300ms;
  }
  [data-mobile-menu][data-open='true'] {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translateY(0) scale(1);
    transition:
      opacity 300ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 300ms cubic-bezier(0.16, 1, 0.3, 1),
      visibility 0s;
  }

  /* stagger */
  .menu-row {
    opacity: 0;
    transform: translateY(6px);
    transition:
      opacity 360ms cubic-bezier(0.16, 1, 0.3, 1),
      transform 360ms cubic-bezier(0.16, 1, 0.3, 1),
      color 200ms ease;
  }
  [data-open='true'] .menu-row {
    opacity: 1;
    transform: translateY(0);
  }
  [data-open='true'] .menu-row:nth-child(1) { transition-delay: 50ms; }
  [data-open='true'] .menu-row:nth-child(2) { transition-delay: 90ms; }
  [data-open='true'] .menu-row:nth-child(3) { transition-delay: 130ms; }
  [data-open='true'] .menu-row:nth-child(4) { transition-delay: 170ms; }
  .menu-row:hover,
  .menu-row:active { color: var(--ink); }
</style>

<script>
  const btn = document.querySelector<HTMLButtonElement>('[data-menu-btn]');
  const menu = document.querySelector<HTMLElement>('[data-mobile-menu]');
  if (btn && menu) {
    const setOpen = (open: boolean) => {
      menu.dataset.open = String(open);
      btn.setAttribute('aria-expanded', String(open));
      btn.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      // reveal burger
      if (open) document.documentElement.dataset.menuRevealed = 'true';
    };
    const isOpen = () => menu.dataset.open === 'true';

    btn.addEventListener('click', (e) => {
      e.stopPropagation();
      setOpen(!isOpen());
    });

    // close on tap
    menu.querySelectorAll('[data-menu-link]').forEach((a) => {
      a.addEventListener('click', () => setOpen(false));
    });

    // outside click
    document.addEventListener('click', (e) => {
      if (!isOpen()) return;
      const t = e.target as Node;
      if (!menu.contains(t) && !btn.contains(t)) setOpen(false);
    });

    // escape
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) {
        setOpen(false);
        btn.focus();
      }
    });

    // desktop reset
    const mq = window.matchMedia('(min-width: 768px)');
    mq.addEventListener('change', (e) => {
      if (e.matches) setOpen(false);
    });
  }
</script>
