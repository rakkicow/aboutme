---
// Reel — a TikTok/Shorts-style popup viewer.
// Opens from any `a[href="#reel"]` (CDI card "Reel ↓", nav link). A vertical
// scroll-snap scroller flips one video per gesture; the active video's embed
// mounts + autoplays while everything off-screen stays torn down. The loop is
// infinite (edge clones wrap seamlessly) and each slide hugs its own content
// so the panel stays tight instead of leaving big letterbox bars.
import { reel } from '~/data/projects';
---

<dialog id="reel" data-reel-modal aria-label="Video reel">
  {/* Backdrop — clicking it closes the reel */}
  <div data-reel-close class="absolute inset-0" style="background: rgba(10, 10, 16, 0.6); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);"></div>

  {/* Panel — height is set by JS to hug one slide */}
  <div class="relative w-full max-w-[560px]">
    <button type="button" data-reel-close class="reel-x absolute -right-3 -top-3 z-30" aria-label="Close reel">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" /></svg>
    </button>
    <div class="reel-panel relative flex w-full flex-col overflow-hidden rounded-[28px] border" style="border-color: var(--hair); background: var(--canvas); color: var(--ink); box-shadow: var(--shadow-glow-sm);">
    <div class="no-scrollbar reel-scroller" data-reel-scroller>
      {reel.map((v) => {
        const source = v.source ?? 'youtube';
        const isExternal = source === 'external';
        const thumbnail =
          v.thumbnail ??
          (source === 'youtube'
            ? `https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`
            : source === 'drive'
              ? `https://drive.google.com/thumbnail?id=${v.id}&sz=w1280`
              : '');
        const ytMaxres =
          source === 'youtube' ? `https://i.ytimg.com/vi/${v.id}/maxresdefault.jpg` : undefined;

        return (
          <section
            class="reel-slide"
            data-reel-slide
            data-source={source}
            data-id={v.id}
            data-title={v.title}
          >
            <div class="reel-slide-inner w-full px-4">
              {/* Video frame */}
              <div class="reel-frame relative w-full overflow-hidden rounded-2xl bg-black" style="aspect-ratio: 16 / 9;">
                <img
                  src={thumbnail}
                  data-maxres={ytMaxres}
                  alt={v.title}
                  loading="lazy"
                  decoding="async"
                  class="reel-thumb absolute inset-0 h-full w-full object-cover"
                />
                <div data-reel-mount class="absolute inset-0"></div>
                {isExternal && (
                  <a
                    href={v.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="absolute inset-0 z-10 grid place-items-center"
                    aria-label={`Open: ${v.title}`}
                  >
                    <span class="reel-play">
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  </a>
                )}
                {v.pill && (
                  <span class="reel-pill pointer-events-none absolute left-4 top-4 z-10 inline-flex items-center rounded-full bg-black/40 px-3 py-1 text-[10px] font-medium uppercase tracking-[0.2em] text-white/95 backdrop-blur-md ring-1 ring-white/20 transition-opacity duration-200">
                    {v.pill}
                  </span>
                )}
              </div>

              {/* Meta — title, then caption, then award badges */}
              <div class="reel-meta mt-5" data-reel-meta>
                <h3 class="font-display text-xl font-medium tracking-tight" style="color: var(--ink);">{v.title}</h3>
                <p class="mt-2 text-sm" style="color: var(--ink-muted);">{v.caption}</p>
                {v.stats && (
                  <div class="mt-3 flex flex-wrap justify-center gap-2">
                    {v.stats.map((s) => (
                      <span class="reel-stat">{s}</span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </section>
        );
      })}
    </div>
    </div>
    {/* Animated scroll cue — a bouncing chevron; fades out after the first scroll */}
    <div class="reel-cue" data-reel-cue aria-hidden="true">
      <svg class="reel-cue-chevron" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8l6 6 6-6" /></svg>
      <span>scroll · arrows · esc</span>
    </div>
  </div>
</dialog>

<style>
  /* Native <dialog> in the top layer — same treatment as the web shelf */
  dialog[data-reel-modal] {
    position: fixed;
    inset: 0;
    margin: 0;
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    padding: 1rem;
    border: 0;
    background: transparent;
    display: none;
    align-items: center;
    justify-content: center;
    overscroll-behavior: contain;
  }
  dialog[data-reel-modal][open] {
    display: flex;
  }
  dialog[data-reel-modal]::backdrop {
    background: transparent;
  }
  @media (min-width: 640px) {
    dialog[data-reel-modal] {
      padding: 2rem;
    }
  }

  .reel-panel {
    max-height: 92vh;
  }

  /* TikTok-style scroller: one full slide per gesture. Height is a JS-set
     px value (--slide-h) so the panel hugs the video + meta with no big bars. */
  .reel-scroller {
    height: var(--slide-h, 78vh);
    overflow-y: auto;
    scroll-snap-type: y mandatory;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }
  .reel-slide {
    display: grid;
    place-items: center;
    height: var(--slide-h, 78vh);
    scroll-snap-align: start;
    scroll-snap-stop: always;
    /* Clip so a slide's content can never bleed over its neighbours */
    overflow: hidden;
  }
  /* Once the player loads, fade the category pill out of the way */
  .reel-slide.is-playing .reel-pill {
    opacity: 0;
  }

  .reel-x {
    display: inline-grid;
    place-items: center;
    height: 38px;
    width: 38px;
    border-radius: 999px;
    border: 1px solid var(--hair);
    background: var(--surface);
    color: var(--ink);
    transition:
      transform 280ms cubic-bezier(0.16, 1, 0.3, 1),
      background 240ms ease;
  }
  .reel-x:hover {
    transform: translateY(-2px);
    background: var(--cow-pink-soft);
  }

  /* Scroll cue — sits just below the panel, bounces to invite a scroll */
  .reel-cue {
    position: absolute;
    left: 50%;
    bottom: -2.5rem;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    color: #ff7a1e;
    font-size: 9px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    pointer-events: none;
    transition: opacity 400ms ease;
  }
  .reel-cue.is-hidden {
    opacity: 0;
  }
  .reel-cue-chevron {
    width: 22px;
    height: 22px;
    animation: reel-cue-bounce 1.5s ease-in-out infinite;
  }
  @keyframes reel-cue-bounce {
    0%, 100% { transform: translateY(0); opacity: 0.55; }
    50% { transform: translateY(5px); opacity: 1; }
  }
</style>

<style is:global>
  /* Open/visit affordance — dark glass, pulsing orange ring */
  .reel-play {
    display: grid;
    place-items: center;
    height: 64px;
    width: 64px;
    border-radius: 999px;
    background: rgba(12, 12, 18, 0.55);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: #fff;
    border: 2px solid rgba(255, 122, 30, 0.9);
    animation: reel-play-glow 2.2s ease-in-out infinite;
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reel-play:hover {
    transform: scale(1.08);
  }
  @keyframes reel-play-glow {
    0%, 100% {
      box-shadow:
        0 0 18px rgba(255, 122, 30, 0.35),
        0 0 0 0 rgba(255, 122, 30, 0.35);
    }
    50% {
      box-shadow:
        0 0 32px rgba(255, 122, 30, 0.7),
        0 0 0 7px rgba(255, 122, 30, 0.12);
    }
  }

  /* Award chips */
  .reel-stat {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #ffb37a;
    background: rgba(255, 122, 30, 0.14);
    border: 1px solid rgba(255, 122, 30, 0.5);
    box-shadow: 0 0 14px rgba(255, 122, 30, 0.25);
  }
</style>

<script>
  // YouTube thumbnail upgrade — maxresdefault when it exists
  document.querySelectorAll<HTMLImageElement>('.reel-thumb').forEach((img) => {
    const maxres = img.dataset.maxres;
    if (!maxres) return;
    const probe = new Image();
    probe.onload = () => {
      if (probe.naturalWidth >= 480) img.src = maxres;
    };
    probe.src = maxres;
  });

  const modal = document.querySelector<HTMLDialogElement>('[data-reel-modal]');
  const scroller = modal?.querySelector<HTMLElement>('[data-reel-scroller]');
  if (modal && scroller) {
    const lenis = () => (window as unknown as { __lenis?: { stop(): void; start(): void } }).__lenis;
    const realSlides = [...scroller.querySelectorAll<HTMLElement>('[data-reel-slide]')];
    const n = realSlides.length;

    // Keep the custom cursor visible above the top-layer dialog
    const cursorFx = ['cursor', 'cursor-dot']
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el)
      .map((el) => ({ el, home: el.parentElement }));

    // ── Infinite loop via edge clones ────────────────────────────────
    // DOM order becomes: [lastClone, R0..R(n-1), firstClone].
    const makeClone = (src: HTMLElement) => {
      const c = src.cloneNode(true) as HTMLElement;
      c.setAttribute('data-clone', '');
      c.removeAttribute('data-reel-slide'); // observers/mount ignore it
      c.removeAttribute('data-id');
      return c;
    };
    const lastClone = makeClone(realSlides[n - 1]);
    const firstClone = makeClone(realSlides[0]);
    scroller.insertBefore(lastClone, realSlides[0]);
    scroller.appendChild(firstClone);

    let slideH = 0;
    let domIndex = 1; // start on the first real slide (index 0 is lastClone)

    // ── Mount / unmount players ──────────────────────────────────────
    const mount = (slide: HTMLElement) => {
      const target = slide.querySelector<HTMLElement>('[data-reel-mount]');
      const source = slide.dataset.source ?? 'youtube';
      if (!target || source === 'external' || target.querySelector('iframe')) return;
      const id = slide.dataset.id ?? '';
      const iframe = document.createElement('iframe');
      // Autoplay WITH sound. Browsers may still gate unmuted autoplay, but the
      // modal opens from a click and scrolling is an active gesture, so it
      // plays in practice.
      // No loop — the video plays through so we can auto-advance on end.
      // enablejsapi lets the YouTube player postMessage its state changes.
      iframe.src =
        source === 'drive'
          ? `https://drive.google.com/file/d/${id}/preview`
          : `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&mute=0&playsinline=1&rel=0&modestbranding=1&enablejsapi=1&origin=${encodeURIComponent(location.origin)}`;
      iframe.title = slide.dataset.title ?? '';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.className = 'absolute inset-0 h-full w-full border-0';
      iframe.addEventListener('load', () => {
        slide.classList.add('is-playing'); // hide the pill once the player is up
        if (source === 'youtube') {
          // Subscribe to the player's state changes (0 = ended → auto-advance)
          iframe.contentWindow?.postMessage(
            JSON.stringify({ event: 'command', func: 'addEventListener', args: ['onStateChange'] }),
            '*',
          );
        }
      });
      target.appendChild(iframe);
    };
    const unmount = (slide: HTMLElement) => {
      slide.querySelector('[data-reel-mount] iframe')?.remove();
      slide.classList.remove('is-playing');
    };

    // The real slide filling the viewport gets its player; the rest torn down
    const activeIO = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const slide = entry.target as HTMLElement;
          if (entry.isIntersecting && modal.open) mount(slide);
          else unmount(slide);
        });
      },
      { root: scroller, threshold: 0.6 },
    );
    realSlides.forEach((s) => activeIO.observe(s));

    // ── Responsive slide height — hug the video + meta, cap at the panel ──
    // Returns false when the scroller has no layout yet (dialog just opened),
    // so the caller can retry. The `next === slideH` guard stops the
    // ResizeObserver from looping (changing --slide-h resizes the scroller).
    const setSlideHeight = () => {
      const frameW = scroller.clientWidth - 32; // px-4 both sides
      if (frameW <= 0) return false;
      const videoH = (frameW * 9) / 16;
      // Size to the TALLEST caption so no slide's content is clipped or bleeds
      let maxMetaH = 0;
      realSlides.forEach((s) => {
        const h = s.querySelector('[data-reel-meta]')?.getBoundingClientRect().height ?? 0;
        if (h > maxMetaH) maxMetaH = h;
      });
      const contentH = videoH + (maxMetaH || 130) + 44; // gap + breathing room
      const next = Math.min(Math.round(contentH), Math.round(window.innerHeight * 0.9));
      if (next !== slideH) {
        slideH = next;
        scroller.style.setProperty('--slide-h', `${slideH}px`);
        scroller.scrollTop = slideH * domIndex; // stay anchored
      }
      return true;
    };

    // Re-measure whenever the scroller gets or changes size — this is what
    // reliably fixes the height once the dialog actually has a layout
    // (openModal's first frame can measure a zero-width scroller on mobile).
    new ResizeObserver(() => {
      if (modal.open) setSlideHeight();
    }).observe(scroller);

    // ── Seamless wrap when a clone settles into view ─────────────────
    const onSettle = () => {
      if (!slideH) return;
      const idx = Math.round(scroller.scrollTop / slideH);
      if (idx <= 0) {
        domIndex = n; // lastClone → real last
        scroller.scrollTop = slideH * n;
      } else if (idx >= n + 1) {
        domIndex = 1; // firstClone → real first
        scroller.scrollTop = slideH;
      } else {
        domIndex = idx;
      }
    };
    let settleTimer: number | null = null;
    scroller.addEventListener(
      'scroll',
      () => {
        if (settleTimer !== null) clearTimeout(settleTimer);
        settleTimer = window.setTimeout(onSettle, 90);
      },
      { passive: true },
    );
    if ('onscrollend' in window) scroller.addEventListener('scrollend', onSettle);

    // Fade the scroll cue away the first time the user moves the deck
    const cue = modal.querySelector<HTMLElement>('[data-reel-cue]');
    const hideCue = () => cue?.classList.add('is-hidden');
    scroller.addEventListener('scroll', hideCue, { passive: true });

    // Wheel — advance exactly ONE video per gesture no matter how hard the
    // trackpad is flicked (native momentum scroll is replaced by a controlled
    // step + cooldown). This also guarantees you can always move past every
    // slide, including the external (click-through) one. Touch still uses
    // native scroll-snap, which is already one-per-swipe.
    // One video per scroll — then a hard 1s cooldown that swallows all further
    // wheel input (including trackpad momentum), so a single flick can never
    // skip past a video. Touch uses native scroll-snap (already one-per-swipe).
    let wheelLocked = false;
    let wheelAcc = 0;
    scroller.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        if (!slideH) return;
        if (wheelLocked) {
          wheelAcc = 0; // keep momentum from banking a second step
          return;
        }
        wheelAcc += Math.abs(e.deltaY) >= Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
        if (Math.abs(wheelAcc) > 24) {
          const dir = wheelAcc > 0 ? 1 : -1;
          wheelAcc = 0;
          wheelLocked = true;
          scroller.scrollBy({ top: dir * slideH, behavior: 'smooth' });
          window.setTimeout(() => {
            wheelLocked = false;
            wheelAcc = 0;
          }, 1000);
        }
      },
      { passive: false },
    );

    // Auto-advance when a YouTube video finishes. Only the active slide has a
    // mounted player, so an ENDED (info 0) state change comes from the current
    // video → glide to the next one.
    window.addEventListener('message', (e) => {
      if (!modal.open || !slideH) return;
      if (!e.origin || !e.origin.includes('youtube')) return;
      if (typeof e.data !== 'string' || !e.data.includes('onStateChange')) return;
      try {
        const msg = JSON.parse(e.data);
        if (msg.event === 'onStateChange' && msg.info === 0) {
          scroller.scrollBy({ top: slideH, behavior: 'smooth' });
        }
      } catch {
        /* not a JSON YT message */
      }
    });

    // ── Open / close ─────────────────────────────────────────────────
    const openModal = (e: Event) => {
      e.preventDefault();
      modal.showModal();
      document.body.style.overflow = 'hidden';
      lenis()?.stop();
      cursorFx.forEach(({ el }) => modal.appendChild(el));
      cue?.classList.remove('is-hidden'); // show the cue again each open
      domIndex = 1;
      // Measure as soon as the dialog has a layout; retry until it does
      // (mobile can take a couple of frames), then land on the first slide.
      const prime = (tries = 0) => {
        if (setSlideHeight()) {
          scroller.scrollTop = slideH;
          mount(realSlides[0]);
        } else if (tries < 12) {
          requestAnimationFrame(() => prime(tries + 1));
        }
      };
      prime();
    };
    document.querySelectorAll<HTMLAnchorElement>('a[href="#reel"]').forEach((a) => {
      a.addEventListener('click', openModal);
    });
    modal.querySelectorAll('[data-reel-close]').forEach((el) => {
      el.addEventListener('click', () => modal.close());
    });
    modal.addEventListener('close', () => {
      document.body.style.overflow = '';
      lenis()?.start();
      cursorFx.forEach(({ el, home }) => home?.appendChild(el));
      realSlides.forEach(unmount);
    });

    // Arrow keys page through the reel while it's open
    modal.addEventListener('keydown', (e) => {
      if (!slideH) return;
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
        e.preventDefault();
        scroller.scrollBy({ top: slideH, behavior: 'smooth' });
      } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
        e.preventDefault();
        scroller.scrollBy({ top: -slideH, behavior: 'smooth' });
      }
    });

    window.addEventListener('resize', () => {
      if (modal.open) setSlideHeight();
    });
  }
</script>
