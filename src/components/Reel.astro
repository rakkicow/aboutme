---
import { reel } from '~/data/projects';
---

<section id="reel" class="relative pt-4 pb-6 sm:pt-10 sm:pb-12">
  <div class="container-x">
    <div class="reveal flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
      <div>
        <p class="eyebrow">Reel</p>
        <h2 class="h2 mt-4 max-w-[20ch]">
          lights... camera... <span class="h-italic text-gradient-pink-animated" style="padding-right: 0.18em;">action!</span>
        </h2>
      </div>
      <p class="max-w-sm text-sm" style="color: var(--ink-muted);">
        Experience my CDI Official era: featuring healthcare campaigns, educational content, and a few personal favorites. Swipe or use arrow keys.
      </p>
    </div>

    {/* Arrow controls */}
    <div class="reveal mt-10 flex items-center justify-end">
      <div class="flex items-center gap-2">
        <button
          type="button"
          data-reel-prev
          class="reel-arrow"
          aria-label="Scroll videos left"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <button
          type="button"
          data-reel-next
          class="reel-arrow"
          aria-label="Scroll videos right"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      </div>
    </div>

    {/* Card deck — flash-card style: the front card physically tucks to the back */}
    <div data-reel-deck class="reel-deck reveal mx-auto mt-8 w-full max-w-[640px]">
      {reel.map((v, i) => {
        const source = v.source ?? 'youtube';
        const isExternal = source === 'external';
        const thumbnail =
          v.thumbnail ??
          (source === 'youtube'
            ? `https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`
            : source === 'drive'
              ? `https://drive.google.com/thumbnail?id=${v.id}&sz=w1280`
              : '');
        const ytMaxres =
          source === 'youtube' ? `https://i.ytimg.com/vi/${v.id}/maxresdefault.jpg` : undefined;

        return (
          <article
            class="reel-card group w-full overflow-hidden rounded-3xl border bg-black/90"
            style="border-color: var(--hair); box-shadow: 0 24px 60px -20px rgba(15,15,16,0.35);"
          >
            {v.pill && (
              <span class="absolute left-4 top-4 z-10 inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1 text-[10px] font-medium uppercase tracking-[0.2em] text-white/95 backdrop-blur-md ring-1 ring-white/20">
                {v.pill}
              </span>
            )}

            {/* Click-to-play (or click-through) poster. YouTube + Drive mount
                an iframe on click and tear it down on scroll-off; external
                items navigate to v.href on click and never mount anything. */}
            <div
              class="reel-video-slot relative aspect-video w-full overflow-hidden"
              data-source={source}
              data-yt-id={v.id}
              data-yt-title={v.title}
            >
              {isExternal ? (
                <a
                  href={v.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="reel-poster group/poster absolute inset-0 block h-full w-full text-left"
                  aria-label={`Open: ${v.title}`}
                >
                  <img
                    src={thumbnail}
                    alt={v.title}
                    loading="lazy"
                    decoding="async"
                    class="reel-thumb absolute inset-0 h-full w-full object-cover"
                  />
                  <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/45 via-black/10 to-black/25"></span>
                  <span class="pointer-events-none absolute inset-0 grid place-items-center">
                    <span class="reel-play">
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  </span>
                </a>
              ) : (
                <button
                  type="button"
                  class="reel-poster group/poster absolute inset-0 block h-full w-full text-left"
                  aria-label={`Play: ${v.title}`}
                >
                  <img
                    src={thumbnail}
                    data-maxres={ytMaxres}
                    alt={v.title}
                    loading="lazy"
                    decoding="async"
                    class="reel-thumb absolute inset-0 h-full w-full object-cover"
                  />
                  <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/45 via-black/10 to-black/25"></span>
                  <span class="pointer-events-none absolute inset-0 grid place-items-center">
                    <span class="reel-play">
                      <svg class="h-8 w-8" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M9.5 6.5v11l8.5-5.5z" />
                      </svg>
                    </span>
                  </span>
                </button>
              )}
            </div>

            <div class="p-6">
              <h3 class="font-display text-xl font-medium tracking-tight text-white">{v.title}</h3>
              {v.stats && (
                <div class="mt-3 flex flex-wrap gap-2">
                  {v.stats.map((s) => (
                    <span class="reel-stat">{s}</span>
                  ))}
                </div>
              )}
              <p class="mt-2 text-sm text-white/70">{v.caption}</p>
            </div>
          </article>
        );
      })}

    </div>
  </div>
</section>

<style>
  .reel-arrow {
    display: inline-grid;
    place-items: center;
    height: 40px;
    width: 40px;
    border-radius: 999px;
    border: 1px solid var(--hair);
    background: var(--surface);
    color: var(--ink);
    transition:
      transform 280ms cubic-bezier(0.16, 1, 0.3, 1),
      background 240ms ease,
      box-shadow 240ms ease;
  }
  .reel-arrow:hover {
    transform: translateY(-2px);
    background: var(--cow-pink-soft);
    box-shadow: 0 12px 28px -10px rgba(220, 155, 181, 0.45);
  }
  .reel-arrow:active {
    transform: translateY(0);
  }

  /* ── 3D flash-card deck ──────────────────────────────────────────
     TikTok-style: the front card lifts toward the viewer in the swipe
     direction, then recedes into depth behind the stack while the card
     underneath physically draws forward to take its place. */
  .reel-deck {
    position: relative;
    perspective: 1200px;
  }
  .reel-deck :global(.reel-card) {
    position: absolute;
    inset-inline: 0;
    top: 0;
    transform-origin: center center;
    transition:
      transform 680ms cubic-bezier(0.3, 1.15, 0.35, 1),
      opacity 500ms ease,
      filter 500ms ease;
    will-change: transform;
    /* Horizontal swipes drag the card; vertical swipes still scroll the page */
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
  }
  .reel-deck :global(.reel-card img) {
    -webkit-user-drag: none;
    user-select: none;
    pointer-events: none;
  }
  .reel-deck :global(.deck-pos-0) {
    transform: translate3d(0, 0, 0);
    opacity: 1;
    z-index: 30;
    filter: brightness(1);
  }
  .reel-deck :global(.deck-pos-1) {
    transform: translate3d(0, -20px, -70px);
    opacity: 1;
    z-index: 20;
    filter: brightness(0.6);
    cursor: pointer;
  }
  .reel-deck :global(.deck-pos-2) {
    transform: translate3d(0, -38px, -140px);
    opacity: 1;
    z-index: 10;
    filter: brightness(0.38);
    cursor: pointer;
  }
  .reel-deck :global(.deck-rest) {
    transform: translate3d(0, -38px, -140px);
    opacity: 0;
    z-index: 0;
    filter: brightness(0.38);
    pointer-events: none;
  }
  /* Cycling — one continuous arc: the card lifts toward the viewer, sweeps
     around the corner, and recedes into the back of the deck (z-index flips
     halfway so it slots behind). Quizlet flash-card feel. */
  .reel-deck :global(.deck-cycling-right),
  .reel-deck :global(.deck-cycling-left),
  .reel-deck :global(.deck-cycling-up) {
    animation-duration: 760ms;
    animation-timing-function: cubic-bezier(0.42, 0.02, 0.22, 1);
    animation-fill-mode: both;
  }
  .reel-deck :global(.deck-cycling-right) {
    animation-name: deck-cycle-right;
  }
  .reel-deck :global(.deck-cycling-left) {
    animation-name: deck-cycle-left;
  }
  .reel-deck :global(.deck-cycling-up) {
    animation-name: deck-cycle-up;
  }
  .reel-deck :global(.deck-uncycling) {
    animation: deck-uncycle 760ms cubic-bezier(0.42, 0.02, 0.22, 1) both;
  }
  .reel-deck :global(.deck-instant) {
    transition: none !important;
  }
</style>

<style is:global>
  @keyframes deck-cycle-right {
    0% {
      transform: translate3d(0, 0, 0);
      z-index: 40;
      filter: brightness(1);
    }
    45% {
      transform: translate3d(44%, -16%, 80px) rotateY(14deg) rotateZ(5deg);
      z-index: 40;
      filter: brightness(1);
    }
    55% {
      z-index: 0;
    }
    100% {
      transform: translate3d(0, -38px, -140px);
      z-index: 0;
      filter: brightness(0.38);
    }
  }
  @keyframes deck-cycle-left {
    0% {
      transform: translate3d(0, 0, 0);
      z-index: 40;
      filter: brightness(1);
    }
    45% {
      transform: translate3d(-44%, -16%, 80px) rotateY(-14deg) rotateZ(-5deg);
      z-index: 40;
      filter: brightness(1);
    }
    55% {
      z-index: 0;
    }
    100% {
      transform: translate3d(0, -38px, -140px);
      z-index: 0;
      filter: brightness(0.38);
    }
  }
  @keyframes deck-cycle-up {
    0% {
      transform: translate3d(0, 0, 0);
      z-index: 40;
      filter: brightness(1);
    }
    45% {
      transform: translate3d(8%, -52%, 80px) rotateX(9deg) rotateZ(3deg);
      z-index: 40;
      filter: brightness(1);
    }
    55% {
      z-index: 0;
    }
    100% {
      transform: translate3d(0, -38px, -140px);
      z-index: 0;
      filter: brightness(0.38);
    }
  }
  @keyframes deck-uncycle {
    0% {
      transform: translate3d(0, -38px, -140px);
      opacity: 0;
      z-index: 40;
      filter: brightness(0.38);
    }
    18% {
      opacity: 1;
    }
    50% {
      transform: translate3d(42%, -18%, 80px) rotateY(12deg) rotateZ(4deg);
      z-index: 40;
      filter: brightness(1);
    }
    100% {
      transform: translate3d(0, 0, 0);
      z-index: 40;
      filter: brightness(1);
    }
  }

  /* ── Play / open button — hidden until the card is hovered, orange glow ── */
  :global(.reel-play) {
    display: grid;
    place-items: center;
    height: 64px;
    width: 64px;
    border-radius: 999px;
    background: rgba(12, 12, 18, 0.55);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: #fff;
    border: 2px solid rgba(255, 122, 30, 0.9);
    opacity: 0;
    transform: scale(0.82);
    transition:
      opacity 300ms ease,
      transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
    animation: reel-play-glow 2.2s ease-in-out infinite;
  }
  :global(.deck-pos-0:hover .reel-play) {
    opacity: 1;
    transform: scale(1);
  }
  :global(.reel-poster:hover .reel-play) {
    transform: scale(1.08);
  }
  @keyframes reel-play-glow {
    0%, 100% {
      box-shadow:
        0 0 18px rgba(255, 122, 30, 0.35),
        0 0 0 0 rgba(255, 122, 30, 0.35);
    }
    50% {
      box-shadow:
        0 0 32px rgba(255, 122, 30, 0.7),
        0 0 0 7px rgba(255, 122, 30, 0.12);
    }
  }
  /* Touch devices can't hover — keep the affordance visible */
  @media (hover: none) {
    :global(.reel-play) {
      opacity: 1;
      transform: scale(1);
    }
  }

  /* ── Award chips ── */
  :global(.reel-stat) {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #ffb37a;
    background: rgba(255, 122, 30, 0.14);
    border: 1px solid rgba(255, 122, 30, 0.5);
    box-shadow: 0 0 14px rgba(255, 122, 30, 0.25);
  }
</style>

<script>
  // YouTube thumbnail upgrade — try maxresdefault.jpg, fall back to hqdefault
  // if YouTube returned the 120×90 "not available" placeholder.
  document.querySelectorAll<HTMLImageElement>('.reel-thumb').forEach((img) => {
    const maxres = img.dataset.maxres;
    if (!maxres) return;
    const probe = new Image();
    probe.onload = () => {
      // Real thumbnails are 1280×720; placeholders are 120×90.
      if (probe.naturalWidth >= 480) img.src = maxres;
    };
    probe.src = maxres;
  });

  // Click to play, scroll-away to unload. The poster stays in the DOM and the
  // iframe sits next to it — we toggle which is visible and tear the iframe
  // down entirely when the card leaves the viewport. External-source slots
  // skip the mount/unmount path and let the anchor's native click navigate.
  document.querySelectorAll<HTMLElement>('.reel-video-slot').forEach((slot) => {
    const source = (slot.dataset.source ?? 'youtube') as
      | 'youtube'
      | 'drive'
      | 'external';
    if (source === 'external') return;

    const id = slot.dataset.ytId;
    const title = slot.dataset.ytTitle ?? '';
    const poster = slot.querySelector<HTMLElement>('.reel-poster');
    if (!id || !poster) return;

    const buildSrc = () => {
      if (source === 'drive') {
        return `https://drive.google.com/file/d/${id}/preview`;
      }
      return `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
    };

    const mount = () => {
      if (slot.querySelector('iframe')) return;
      const iframe = document.createElement('iframe');
      iframe.src = buildSrc();
      iframe.title = title;
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.className = 'absolute inset-0 h-full w-full border-0';
      slot.appendChild(iframe);
      poster.style.display = 'none';
    };

    const unmount = () => {
      const iframe = slot.querySelector('iframe');
      if (!iframe) return;
      iframe.remove();
      poster.style.display = '';
    };

    poster.addEventListener('click', (e) => {
      e.preventDefault();
      mount();
    });

    // The deck fires this when the card leaves the front position.
    slot.addEventListener('reel:unmount', unmount);

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) unmount();
        },
        { rootMargin: '250px' },
      );
      io.observe(slot);
    }
  });

  // ── Flash-card deck ──────────────────────────────────────────────
  // Arrows (or tapping a card behind) cycle the deck. The front card
  // physically drops, tilts, and glides up behind the stack.
  const deck = document.querySelector<HTMLElement>('[data-reel-deck]');
  if (deck) {
    const cards = [...deck.querySelectorAll<HTMLElement>('.reel-card')];
    let order = cards.map((_, i) => i);
    let busy = false;

    const POS = [
      'deck-pos-0',
      'deck-pos-1',
      'deck-pos-2',
      'deck-rest',
      'deck-cycling-up',
      'deck-cycling-left',
      'deck-cycling-right',
      'deck-uncycling',
      'deck-instant',
    ];
    const setPos = (card: HTMLElement, cls: string) => {
      card.classList.remove(...POS);
      card.classList.add(cls);
    };
    const posClass = (pos: number) =>
      pos === 0 ? 'deck-pos-0' : pos === 1 ? 'deck-pos-1' : pos === 2 ? 'deck-pos-2' : 'deck-rest';

    const assign = (except?: HTMLElement) => {
      order.forEach((cardIdx, pos) => {
        if (cards[cardIdx] === except) return;
        setPos(cards[cardIdx], posClass(pos));
      });
    };

    // Deck height = tallest card + room for the stacked peek
    const sizeDeck = () => {
      const h = Math.max(...cards.map((c) => c.offsetHeight));
      deck.style.height = `${h + 40}px`;
    };

    const unmountBehind = () => {
      cards.forEach((card, i) => {
        if (i === order[0]) return;
        card.querySelector('.reel-video-slot')?.dispatchEvent(new Event('reel:unmount'));
      });
    };

    // Cycle the front card to the back in ONE fluid keyframe arc (via the
    // corner) while the stack draws forward underneath it at the same time.
    const settle = (card: HTMLElement, cls: string) => {
      let done = false;
      const finish = () => {
        if (done) return;
        done = true;
        card.classList.remove(cls);
        assign();
        busy = false;
      };
      card.addEventListener('animationend', finish, { once: true });
      window.setTimeout(finish, 950); // safety net if the animation is interrupted
    };

    const tuck = (cycleClass: string) => {
      if (busy) return;
      busy = true;
      const front = cards[order[0]];
      front.style.transition = '';
      front.style.transform = '';
      front.style.opacity = '';
      order.push(order.shift()!);
      assign(front); // the card underneath draws forward immediately
      front.classList.remove(...POS);
      front.classList.add(cycleClass);
      unmountBehind();
      settle(front, cycleClass);
    };
    const next = () => tuck('deck-cycling-up');

    const prev = () => {
      if (busy) return;
      busy = true;
      const incoming = cards[order[order.length - 1]];
      order.unshift(order.pop()!);
      assign(incoming); // the current front recedes while the card arcs back in
      incoming.classList.remove(...POS);
      incoming.classList.add('deck-uncycling');
      unmountBehind();
      settle(incoming, 'deck-uncycling');
    };

    // Clicking a card that isn't in front advances the deck instead of playing
    cards.forEach((card, i) => {
      card.addEventListener(
        'click',
        (e) => {
          if (order[0] === i) return;
          e.preventDefault();
          e.stopPropagation();
          next();
        },
        true,
      );
    });

    document.querySelector('[data-reel-next]')?.addEventListener('click', next);
    document.querySelector('[data-reel-prev]')?.addEventListener('click', prev);

    // ── Drag-to-flick ────────────────────────────────────────────
    // The front card follows the pointer; release past the threshold
    // flings it off in the drag direction and tucks it to the back,
    // otherwise it springs back. Small drags still count as clicks.
    const DRAG_START = 8;
    const FLING_AT = 90;
    let drag: { card: HTMLElement; x: number; y: number; dx: number; dy: number; live: boolean } | null = null;
    let suppressClick = false;

    deck.addEventListener('pointerdown', (e) => {
      if (busy || drag) return;
      const card = cards[order[0]];
      const target = e.target as HTMLElement;
      if (!card.contains(target) || target.closest('iframe')) return;
      drag = { card, x: e.clientX, y: e.clientY, dx: 0, dy: 0, live: false };
      card.setPointerCapture(e.pointerId);
    });

    deck.addEventListener('pointermove', (e) => {
      if (!drag) return;
      drag.dx = e.clientX - drag.x;
      drag.dy = e.clientY - drag.y;
      if (!drag.live && Math.hypot(drag.dx, drag.dy) > DRAG_START) {
        drag.live = true;
        drag.card.style.transition = 'none';
      }
      if (drag.live) {
        e.preventDefault();
        drag.card.style.transform = `translate(${drag.dx}px, ${drag.dy}px) rotate(${drag.dx * 0.05}deg)`;
      }
    });

    const endDrag = () => {
      if (!drag) return;
      const { card, dx, dy, live } = drag;
      drag = null;
      if (!live) return; // plain click — poster handles it
      suppressClick = true;
      window.setTimeout(() => (suppressClick = false), 80);

      const dist = Math.hypot(dx, dy);
      if (dist > FLING_AT) {
        // Cycle in the swipe direction; swiping down brings the previous card back
        card.style.transition = '';
        card.style.transform = '';
        if (Math.abs(dx) > Math.abs(dy)) {
          tuck(dx < 0 ? 'deck-cycling-left' : 'deck-cycling-right');
        } else if (dy < 0) {
          tuck('deck-cycling-up');
        } else {
          prev();
        }
      } else {
        // Spring back to the front slot
        card.style.transition = '';
        card.style.transform = '';
      }
    };
    deck.addEventListener('pointerup', endDrag);
    deck.addEventListener('pointercancel', endDrag);
    // Native image ghost-drag would fight the pointer drag — flatten it
    deck.addEventListener('dragstart', (e) => e.preventDefault());

    // Desktop: scrolling over the deck flips through it TikTok-style — one
    // card per gesture. Scroll down / swipe left = next (card lifts away),
    // scroll up / swipe right = previous card returns.
    let wheelCooling = false;
    let wheelAcc = 0;
    deck.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        e.stopPropagation(); // keep it away from the page's smooth-scroller
        if (wheelCooling || busy) return;
        const horizontal = Math.abs(e.deltaX) > Math.abs(e.deltaY);
        wheelAcc += horizontal ? e.deltaX : e.deltaY;
        if (Math.abs(wheelAcc) > 50) {
          const positive = wheelAcc > 0;
          wheelAcc = 0;
          wheelCooling = true;
          window.setTimeout(() => (wheelCooling = false), 800);
          if (positive) tuck(horizontal ? 'deck-cycling-left' : 'deck-cycling-up');
          else prev();
        }
      },
      { passive: false },
    );

    // Arrow keys flip the deck while it's on screen
    let deckVisible = false;
    new IntersectionObserver(([entry]) => (deckVisible = entry.isIntersecting), {
      threshold: 0.25,
    }).observe(deck);
    window.addEventListener('keydown', (e) => {
      if (!deckVisible) return;
      const t = e.target as HTMLElement;
      if (t.closest?.('input, textarea, [contenteditable]')) return;
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        tuck('deck-cycling-left');
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        prev();
      }
    });

    // A drag that ends on the poster must not trigger its click-to-play
    deck.addEventListener(
      'click',
      (e) => {
        if (suppressClick) {
          e.preventDefault();
          e.stopPropagation();
        }
      },
      true,
    );

    assign();
    sizeDeck();
    window.addEventListener('resize', sizeDeck);
    window.addEventListener('load', sizeDeck);
  }
</script>
