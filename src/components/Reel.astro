---
// reel
import { reel } from '~/data/projects';
---

<dialog id="reel" data-reel-modal aria-label="Video reel">
  {/* backdrop */}
  <div data-reel-close class="absolute inset-0" style="background: rgba(10, 10, 16, 0.6); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);"></div>

  {/* panel */}
  <div class="relative" style="width: min(90vw, 1100px, 100vh); max-width: 100%;">
    <button type="button" data-reel-close class="reel-x absolute -right-3 -top-3 z-30" aria-label="Close reel">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" /></svg>
    </button>
    <div class="reel-panel relative flex w-full flex-col overflow-hidden rounded-[28px] border" style="border-color: var(--hair); background: var(--canvas); color: var(--ink); box-shadow: var(--shadow-glow-sm);">
    <div class="no-scrollbar reel-scroller" data-reel-scroller>
      {reel.map((v) => {
        const source = v.source ?? 'youtube';
        const isExternal = source === 'external';
        const thumbnail =
          v.thumbnail ??
          (source === 'youtube'
            ? `https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`
            : source === 'drive'
              ? `https://drive.google.com/thumbnail?id=${v.id}&sz=w1280`
              : '');
        const ytMaxres =
          source === 'youtube' ? `https://i.ytimg.com/vi/${v.id}/maxresdefault.jpg` : undefined;

        return (
          <section
            class="reel-slide"
            data-reel-slide
            data-source={source}
            data-id={v.id}
            data-title={v.title}
          >
            <div class="reel-slide-inner w-full px-4">
              {/* video */}
              <div class="reel-frame relative w-full overflow-hidden rounded-2xl bg-black" style={`aspect-ratio: ${v.aspect ?? '16 / 9'};`}>
                <img
                  src={thumbnail}
                  data-maxres={ytMaxres}
                  alt={v.title}
                  loading="lazy"
                  decoding="async"
                  class="reel-thumb absolute inset-0 h-full w-full object-cover"
                />
                <div data-reel-mount class="absolute inset-0"></div>
                {isExternal && (
                  <a
                    href={v.href}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="absolute inset-0 z-10 grid place-items-center"
                    aria-label={`Open: ${v.title}`}
                  >
                    <span class="reel-play">
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  </a>
                )}
                {v.pill && (
                  <span class="reel-pill pointer-events-none absolute left-4 top-4 z-10 inline-flex items-center rounded-full bg-black/40 px-3 py-1 text-[10px] font-medium uppercase tracking-[0.2em] text-white/95 backdrop-blur-md ring-1 ring-white/20 transition-opacity duration-200">
                    {v.pill}
                  </span>
                )}
              </div>

              {/* meta */}
              <div class="reel-meta mt-5" data-reel-meta>
                <h3 class="font-display text-xl font-medium tracking-tight" style="color: var(--ink);">{v.title}</h3>
                <p class="mt-2 text-sm" style="color: var(--ink-muted);">{v.caption}</p>
                {v.stats && (
                  <div class="mt-3 flex flex-wrap justify-center gap-2">
                    {v.stats.map((s) => (
                      <span class="reel-stat">{s}</span>
                    ))}
                  </div>
                )}
              </div>
            </div>
          </section>
        );
      })}
    </div>
    </div>
    {/* nav buttons */}
    <button type="button" data-reel-up class="reel-nav-btn absolute bottom-[100%] mb-2 sm:mb-3 left-1/2 -translate-x-1/2 z-50 text-[#ff7a1e] hover:text-[#ff9043] transition-colors" aria-label="Previous video">
      <svg class="reel-cue-chevron reel-cue-chevron-up h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 15l6-6 6 6" /></svg>
    </button>
    <button type="button" data-reel-down class="reel-nav-btn absolute top-[100%] mt-2 sm:mt-3 left-1/2 -translate-x-1/2 z-50 text-[#ff7a1e] hover:text-[#ff9043] transition-colors" aria-label="Next video">
      <svg class="reel-cue-chevron reel-cue-chevron-down h-8 w-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 9l6 6 6-6" /></svg>
    </button>
  </div>
  
  {/* hint */}
  <div class="absolute bottom-2 left-1/2 -translate-x-1/2 z-50 pointer-events-none">
    <span data-reel-hint class="opacity-100 text-[#ff7a1e] text-[10px] font-semibold uppercase tracking-[0.25em] whitespace-nowrap transition-opacity duration-500" style="text-shadow: 0 1px 6px rgba(0, 0, 0, 0.55);">
      <span class="hidden sm:inline">scroll</span><span class="sm:hidden">swipe</span> · arrows
    </span>
  </div>
  </div>
</dialog>

<style>
  /* dialog */
  dialog[data-reel-modal] {
    position: fixed;
    inset: 0;
    margin: 0;
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    padding: 1rem;
    border: 0;
    background: transparent;
    display: none;
    align-items: center;
    justify-content: center;
    overscroll-behavior: contain;
  }
  dialog[data-reel-modal][open] {
    display: flex;
  }
  dialog[data-reel-modal]::backdrop {
    background: transparent;
  }
  @media (min-width: 640px) {
    dialog[data-reel-modal] {
      padding: 2rem;
    }
  }

  .reel-panel {
    max-height: 92vh;
  }

  /* scroller */
  .reel-scroller {
    height: var(--slide-h, 78vh);
    overflow-y: auto;
    scroll-snap-type: y mandatory;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }
  .reel-slide {
    display: grid;
    place-items: center;
    height: var(--slide-h, 78vh);
    scroll-snap-align: start;
    scroll-snap-stop: always;
    /* clip */
    overflow: hidden;
  }
  /* hide pill */
  .reel-slide.is-playing .reel-pill {
    opacity: 0;
  }

  .reel-x {
    display: inline-grid;
    place-items: center;
    height: 38px;
    width: 38px;
    border-radius: 999px;
    border: 1px solid var(--hair);
    background: var(--surface);
    color: var(--ink);
    transition:
      transform 280ms cubic-bezier(0.16, 1, 0.3, 1),
      background 240ms ease;
  }
  .reel-x:hover {
    transform: translateY(-2px);
    background: var(--cow-pink-soft);
  }

  /* nav buttons */
  .reel-nav-btn {
    display: inline-grid;
    place-items: center;
    cursor: pointer;
  }
  .reel-cue-chevron {
    filter: drop-shadow(0 1px 4px rgba(0, 0, 0, 0.45));
  }
  .reel-cue-chevron-up {
    animation: reel-cue-pulse-up 1.4s ease-in-out infinite;
  }
  .reel-cue-chevron-down {
    animation: reel-cue-pulse-down 1.4s ease-in-out infinite;
  }
  @keyframes reel-cue-pulse-up {
    0%, 100% { opacity: 0.4; transform: translateY(3px); }
    50% { opacity: 1; transform: translateY(-1px); }
  }
  @keyframes reel-cue-pulse-down {
    0%, 100% { opacity: 0.4; transform: translateY(-3px); }
    50% { opacity: 1; transform: translateY(1px); }
  }
</style>

<style is:global>
  /* play button */
  .reel-play {
    display: grid;
    place-items: center;
    height: 64px;
    width: 64px;
    border-radius: 999px;
    background: rgba(12, 12, 18, 0.55);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
    color: #fff;
    border: 2px solid rgba(255, 122, 30, 0.9);
    animation: reel-play-glow 2.2s ease-in-out infinite;
    transition: transform 320ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .reel-play:hover {
    transform: scale(1.08);
  }
  @keyframes reel-play-glow {
    0%, 100% {
      box-shadow:
        0 0 18px rgba(255, 122, 30, 0.35),
        0 0 0 0 rgba(255, 122, 30, 0.35);
    }
    50% {
      box-shadow:
        0 0 32px rgba(255, 122, 30, 0.7),
        0 0 0 7px rgba(255, 122, 30, 0.12);
    }
  }

  /* chips */
  .reel-stat {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    padding: 0.3rem 0.7rem;
    border-radius: 999px;
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.04em;
    color: #ffb37a;
    background: rgba(255, 122, 30, 0.14);
    border: 1px solid rgba(255, 122, 30, 0.5);
    box-shadow: 0 0 14px rgba(255, 122, 30, 0.25);
  }
</style>

<script>
  // thumbnail
  document.querySelectorAll<HTMLImageElement>('.reel-thumb').forEach((img) => {
    const maxres = img.dataset.maxres;
    if (!maxres) return;
    const probe = new Image();
    probe.onload = () => {
      if (probe.naturalWidth >= 480) img.src = maxres;
    };
    probe.src = maxres;
  });

  const modal = document.querySelector<HTMLDialogElement>('[data-reel-modal]');
  const scroller = modal?.querySelector<HTMLElement>('[data-reel-scroller]');
  if (modal && scroller) {
    const lenis = () => (window as unknown as { __lenis?: { stop(): void; start(): void } }).__lenis;
    const realSlides = [...scroller.querySelectorAll<HTMLElement>('[data-reel-slide]')];
    const n = realSlides.length;

    // cursor
    const cursorFx = ['cursor', 'cursor-dot']
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el)
      .map((el) => ({ el, home: el.parentElement }));

    // infinite loop
    const makeClone = (src: HTMLElement) => {
      const c = src.cloneNode(true) as HTMLElement;
      c.setAttribute('data-clone', '');
      c.removeAttribute('data-reel-slide'); // ignore
      c.removeAttribute('data-id');
      return c;
    };
    const lastClone = makeClone(realSlides[n - 1]);
    const firstClone = makeClone(realSlides[0]);
    scroller.insertBefore(lastClone, realSlides[0]);
    scroller.appendChild(firstClone);

    let slideH = 0;
    let domIndex = 1; // first slide

    // mount
    const mount = (slide: HTMLElement) => {
      const target = slide.querySelector<HTMLElement>('[data-reel-mount]');
      const source = slide.dataset.source ?? 'youtube';
      if (!target || source === 'external' || target.querySelector('iframe') || target.querySelector('video')) return;
      const id = slide.dataset.id ?? '';
      
      if (source === 'drive') {
        const iframe = document.createElement('iframe');
        iframe.src = `https://drive.google.com/file/d/${id}/preview`;
        iframe.className = 'absolute top-0 left-0 border-0 rounded-2xl overflow-hidden';
        iframe.style.width = '200%';
        iframe.style.height = '200%';
        iframe.style.transform = 'scale(0.5)';
        iframe.style.transformOrigin = '0 0';
        iframe.addEventListener('load', () => {
          slide.classList.add('is-playing');
        });
        target.appendChild(iframe);
        return;
      }

      const iframe = document.createElement('iframe');
      // autoplay
      iframe.src = `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&mute=0&playsinline=1&rel=0&modestbranding=1&enablejsapi=1&origin=${encodeURIComponent(location.origin)}`;
      iframe.title = slide.dataset.title ?? '';
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.className = 'absolute inset-0 h-full w-full border-0';
      iframe.addEventListener('load', () => {
        slide.classList.add('is-playing'); // hide pill
        // track state
        iframe.contentWindow?.postMessage(
          JSON.stringify({ event: 'command', func: 'addEventListener', args: ['onStateChange'] }),
          '*',
        );
      });
      target.appendChild(iframe);
    };
    const unmount = (slide: HTMLElement) => {
      slide.querySelector('[data-reel-mount] iframe')?.remove();
      slide.querySelector('[data-reel-mount] video')?.remove();
      slide.classList.remove('is-playing');
    };

    // active only
    const activeIO = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          const slide = entry.target as HTMLElement;
          if (entry.isIntersecting && modal.open) mount(slide);
          else unmount(slide);
        });
      },
      { root: scroller, threshold: 0.6 },
    );
    realSlides.forEach((s) => activeIO.observe(s));

    // slide height
    const setSlideHeight = () => {
      const frameW = scroller.clientWidth - 32; // padding
      if (frameW <= 0) return false;
      // tallest frame
      let videoH = 0;
      let maxMetaH = 0;
      realSlides.forEach((s) => {
        const fh = s.querySelector('.reel-frame')?.getBoundingClientRect().height ?? 0;
        if (fh > videoH) videoH = fh;
        const mh = s.querySelector('[data-reel-meta]')?.getBoundingClientRect().height ?? 0;
        if (mh > maxMetaH) maxMetaH = mh;
      });
      if (videoH <= 0) videoH = (frameW * 9) / 16; // fallback
      const contentH = videoH + (maxMetaH || 130) + 44; // spacing
      const next = Math.min(Math.round(contentH), Math.round(window.innerHeight * 0.9));
      if (next !== slideH) {
        slideH = next;
        scroller.style.setProperty('--slide-h', `${slideH}px`);
        scroller.scrollTop = slideH * domIndex; // keep position
      }
      return true;
    };

    // re-measure
    new ResizeObserver(() => {
      if (modal.open) setSlideHeight();
    }).observe(scroller);

    // wrap
    const onSettle = () => {
      if (!slideH) return;
      const idx = Math.round(scroller.scrollTop / slideH);
      if (idx <= 0) {
        domIndex = n; // real last
        scroller.scrollTop = slideH * n;
      } else if (idx >= n + 1) {
        domIndex = 1; // real first
        scroller.scrollTop = slideH;
      } else {
        domIndex = idx;
      }
    };
    let settleTimer: number | null = null;
    scroller.addEventListener(
      'scroll',
      () => {
        if (settleTimer !== null) clearTimeout(settleTimer);
        settleTimer = window.setTimeout(onSettle, 90);
      },
      { passive: true },
    );
    if ('onscrollend' in window) scroller.addEventListener('scrollend', onSettle);

    // wheel
    let wheelLocked = false;
    let wheelAcc = 0;
    scroller.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        if (!slideH) return;
        if (wheelLocked) {
          wheelAcc = 0; // reset
          return;
        }
        wheelAcc += Math.abs(e.deltaY) >= Math.abs(e.deltaX) ? e.deltaY : e.deltaX;
        if (Math.abs(wheelAcc) > 24) {
          const dir = wheelAcc > 0 ? 1 : -1;
          wheelAcc = 0;
          wheelLocked = true;
          scroller.scrollBy({ top: dir * slideH, behavior: 'smooth' });
          window.setTimeout(() => {
            wheelLocked = false;
            wheelAcc = 0;
          }, 1000);
        }
      },
      { passive: false },
    );

    // auto advance
    window.addEventListener('message', (e) => {
      if (!modal.open || !slideH) return;
      if (!e.origin || !e.origin.includes('youtube')) return;
      if (typeof e.data !== 'string' || !e.data.includes('onStateChange')) return;
      try {
        const msg = JSON.parse(e.data);
        if (msg.event === 'onStateChange' && msg.info === 0) {
          scroller.scrollBy({ top: slideH, behavior: 'smooth' });
        }
      } catch {
        /* ignore */
      }
    });

    // open
    const openModal = (e: Event) => {
      e.preventDefault();
      modal.showModal();
      document.body.style.overflow = 'hidden';
      lenis()?.stop();
      cursorFx.forEach(({ el }) => modal.appendChild(el));
      domIndex = 1;
      // measure
      const prime = (tries = 0) => {
        if (setSlideHeight()) {
          scroller.scrollTop = slideH;
          mount(realSlides[0]);
        } else if (tries < 12) {
          requestAnimationFrame(() => prime(tries + 1));
        }
      };
      prime();
    };
    document.querySelectorAll<HTMLAnchorElement>('a[href="#reel"]').forEach((a) => {
      a.addEventListener('click', openModal);
    });
    modal.querySelectorAll('[data-reel-close]').forEach((el) => {
      el.addEventListener('click', () => modal.close());
    });
    modal.addEventListener('close', () => {
      document.body.style.overflow = '';
      lenis()?.start();
      cursorFx.forEach(({ el, home }) => home?.appendChild(el));
      realSlides.forEach(unmount);
    });

    // arrows
    modal.querySelectorAll('[data-reel-up]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!slideH) return;
        scroller.scrollBy({ top: -slideH, behavior: 'smooth' });
      });
    });
    modal.querySelectorAll('[data-reel-down]').forEach((btn) => {
      btn.addEventListener('click', () => {
        if (!slideH) return;
        scroller.scrollBy({ top: slideH, behavior: 'smooth' });
      });
    });

    // arrow keys
    modal.addEventListener('keydown', (e) => {
      if (!slideH) return;
      if (e.key === 'ArrowDown' || e.key === 'ArrowRight') {
        e.preventDefault();
        scroller.scrollBy({ top: slideH, behavior: 'smooth' });
      } else if (e.key === 'ArrowUp' || e.key === 'ArrowLeft') {
        e.preventDefault();
        scroller.scrollBy({ top: -slideH, behavior: 'smooth' });
      }
    });

    window.addEventListener('resize', () => {
      if (modal.open) setSlideHeight();
    });

    const hint = modal.querySelector<HTMLElement>('[data-reel-hint]');
    if (hint) {
      // delay
      setTimeout(() => {
        scroller.addEventListener('scroll', () => {
          hint.style.opacity = '0';
        }, { once: true });
      }, 1000);
    }
  }
</script>
