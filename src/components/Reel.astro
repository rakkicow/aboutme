---
import { reel } from '~/data/projects';
---

<section id="reel" class="relative pt-4 pb-6 sm:pt-10 sm:pb-12">
  {/* Warm backdrop */}
  <div class="pointer-events-none absolute inset-x-0 top-1/2 -z-20 h-[120%] -translate-y-1/2 overflow-hidden">
    <div class="absolute left-1/2 top-0 h-[40rem] w-[40rem] -translate-x-1/2 rounded-full opacity-30" style="background: radial-gradient(circle, rgba(255,168,100,0.4), transparent 60%);"></div>
    <div class="absolute right-0 bottom-0 h-[28rem] w-[28rem] rounded-full opacity-40" style="background: radial-gradient(circle, rgba(220,155,181,0.45), transparent 65%);"></div>
  </div>

  <div class="container-x">
    <div class="reveal flex flex-col items-start justify-between gap-6 sm:flex-row sm:items-end">
      <div>
        <p class="eyebrow">Reel</p>
        <h2 class="h2 mt-4 max-w-[20ch]">
          lights... camera... <span class="h-italic text-gradient-pink-animated" style="padding-right: 0.18em;">action!</span>
        </h2>
      </div>
      <p class="max-w-sm text-sm" style="color: var(--ink-muted);">
        Experience my CDI Official era: featuring healthcare campaigns, educational content, and a few personal favorites.
      </p>
    </div>

    {/* Arrow controls */}
    <div class="reveal mt-10 flex items-center justify-between">
      <div class="flex items-center gap-2 text-xs" style="color: var(--ink-faint);">
        <span class="inline-flex h-1.5 w-1.5 rounded-full bg-cow-400"></span>
        <span>{reel.length} videos</span>
      </div>
      <div class="flex items-center gap-2">
        <button
          type="button"
          data-reel-prev
          class="reel-arrow"
          aria-label="Scroll videos left"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <button
          type="button"
          data-reel-next
          class="reel-arrow"
          aria-label="Scroll videos right"
        >
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      </div>
    </div>

    {/* Horizontal scroll-snap carousel */}
    <div
      data-reel-track
      class="no-scrollbar reveal mt-6 flex snap-x snap-mandatory gap-6 overflow-x-auto overflow-y-hidden scroll-smooth pb-6 pt-4"
      style="scroll-padding-left: 1.5rem; overscroll-behavior-x: contain; overscroll-behavior-y: auto;"
    >
      {reel.map((v, i) => {
        const source = v.source ?? 'youtube';
        const isExternal = source === 'external';
        const thumbnail =
          v.thumbnail ??
          (source === 'youtube'
            ? `https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`
            : source === 'drive'
              ? `https://drive.google.com/thumbnail?id=${v.id}&sz=w1280`
              : '');
        const ytMaxres =
          source === 'youtube' ? `https://i.ytimg.com/vi/${v.id}/maxresdefault.jpg` : undefined;

        return (
          <article
            class="snap-start shrink-0 w-[88vw] sm:w-[560px] lg:w-[640px] group relative overflow-hidden rounded-3xl border bg-black/90"
            style="border-color: var(--hair); box-shadow: 0 24px 60px -20px rgba(15,15,16,0.35);"
          >
            {v.pill && (
              <span class="absolute left-4 top-4 z-10 inline-flex items-center gap-1.5 rounded-full bg-white/15 px-3 py-1 text-[10px] font-medium uppercase tracking-[0.2em] text-white/95 backdrop-blur-md ring-1 ring-white/20">
                {v.pill}
              </span>
            )}
            <span class="absolute right-4 top-4 z-10 font-mono text-[10px] text-white/60">{`0${i + 1} / 0${reel.length}`}</span>

            {/* Click-to-play (or click-through) poster. YouTube + Drive mount
                an iframe on click and tear it down on scroll-off; external
                items navigate to v.href on click and never mount anything. */}
            <div
              class="reel-video-slot relative aspect-video w-full overflow-hidden"
              data-source={source}
              data-yt-id={v.id}
              data-yt-title={v.title}
            >
              {isExternal ? (
                <a
                  href={v.href}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="reel-poster group/poster absolute inset-0 block h-full w-full text-left"
                  aria-label={`Open: ${v.title}`}
                >
                  <img
                    src={thumbnail}
                    alt={v.title}
                    loading="lazy"
                    decoding="async"
                    class="reel-thumb absolute inset-0 h-full w-full object-cover"
                  />
                  <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/45 via-black/10 to-black/25"></span>
                  <span class="pointer-events-none absolute inset-0 grid place-items-center">
                    <span class="grid h-16 w-16 place-items-center rounded-full bg-white/95 text-black shadow-[0_12px_40px_-8px_rgba(0,0,0,0.6)] transition-transform duration-300 group-hover/poster:scale-110">
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                        <path d="M7 17L17 7M9 7h8v8" stroke-linecap="round" stroke-linejoin="round" />
                      </svg>
                    </span>
                  </span>
                </a>
              ) : (
                <button
                  type="button"
                  class="reel-poster group/poster absolute inset-0 block h-full w-full text-left"
                  aria-label={`Play: ${v.title}`}
                >
                  <img
                    src={thumbnail}
                    data-maxres={ytMaxres}
                    alt={v.title}
                    loading="lazy"
                    decoding="async"
                    class="reel-thumb absolute inset-0 h-full w-full object-cover"
                  />
                  <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-black/45 via-black/10 to-black/25"></span>
                  <span class="pointer-events-none absolute inset-0 grid place-items-center">
                    <span class="grid h-16 w-16 place-items-center rounded-full bg-white/95 text-black shadow-[0_12px_40px_-8px_rgba(0,0,0,0.6)] transition-transform duration-300 group-hover/poster:scale-110">
                      <svg class="ml-1 h-6 w-6" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M8 5v14l11-7z" />
                      </svg>
                    </span>
                  </span>
                </button>
              )}
            </div>

            <div class="p-6">
              <h3 class="font-display text-xl font-medium tracking-tight text-white">{v.title}</h3>
              <p class="mt-2 text-sm text-white/70">{v.caption}</p>
            </div>
          </article>
        );
      })}

    </div>
  </div>
</section>

<style>
  .reel-arrow {
    display: inline-grid;
    place-items: center;
    height: 40px;
    width: 40px;
    border-radius: 999px;
    border: 1px solid var(--hair);
    background: var(--surface);
    color: var(--ink);
    transition:
      transform 280ms cubic-bezier(0.16, 1, 0.3, 1),
      background 240ms ease,
      box-shadow 240ms ease;
  }
  .reel-arrow:hover {
    transform: translateY(-2px);
    background: var(--cow-pink-soft);
    box-shadow: 0 12px 28px -10px rgba(220, 155, 181, 0.45);
  }
  .reel-arrow:active {
    transform: translateY(0);
  }
</style>

<script>
  // YouTube thumbnail upgrade — try maxresdefault.jpg, fall back to hqdefault
  // if YouTube returned the 120×90 "not available" placeholder.
  document.querySelectorAll<HTMLImageElement>('.reel-thumb').forEach((img) => {
    const maxres = img.dataset.maxres;
    if (!maxres) return;
    const probe = new Image();
    probe.onload = () => {
      // Real thumbnails are 1280×720; placeholders are 120×90.
      if (probe.naturalWidth >= 480) img.src = maxres;
    };
    probe.src = maxres;
  });

  // Click to play, scroll-away to unload. The poster stays in the DOM and the
  // iframe sits next to it — we toggle which is visible and tear the iframe
  // down entirely when the card leaves the viewport. External-source slots
  // skip the mount/unmount path and let the anchor's native click navigate.
  document.querySelectorAll<HTMLElement>('.reel-video-slot').forEach((slot) => {
    const source = (slot.dataset.source ?? 'youtube') as
      | 'youtube'
      | 'drive'
      | 'external';
    if (source === 'external') return;

    const id = slot.dataset.ytId;
    const title = slot.dataset.ytTitle ?? '';
    const poster = slot.querySelector<HTMLElement>('.reel-poster');
    if (!id || !poster) return;

    const buildSrc = () => {
      if (source === 'drive') {
        return `https://drive.google.com/file/d/${id}/preview`;
      }
      return `https://www.youtube-nocookie.com/embed/${id}?autoplay=1&rel=0&modestbranding=1&playsinline=1`;
    };

    const mount = () => {
      if (slot.querySelector('iframe')) return;
      const iframe = document.createElement('iframe');
      iframe.src = buildSrc();
      iframe.title = title;
      iframe.allow =
        'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';
      iframe.className = 'absolute inset-0 h-full w-full border-0';
      slot.appendChild(iframe);
      poster.style.display = 'none';
    };

    const unmount = () => {
      const iframe = slot.querySelector('iframe');
      if (!iframe) return;
      iframe.remove();
      poster.style.display = '';
    };

    poster.addEventListener('click', (e) => {
      e.preventDefault();
      mount();
    });

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver(
        ([entry]) => {
          if (!entry.isIntersecting) unmount();
        },
        { rootMargin: '250px' },
      );
      io.observe(slot);
    }
  });

  const track = document.querySelector<HTMLElement>('[data-reel-track]');
  if (track) {
    const step = () => {
      const card = track.querySelector<HTMLElement>('article');
      return (card?.offsetWidth ?? 400) + 24; // gap-6
    };

    document.querySelector('[data-reel-next]')?.addEventListener('click', () => {
      track.scrollBy({ left: step(), behavior: 'smooth' });
    });
    document.querySelector('[data-reel-prev]')?.addEventListener('click', () => {
      track.scrollBy({ left: -step(), behavior: 'smooth' });
    });

    // Drag-to-scroll on desktop
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;
    track.addEventListener('mousedown', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('iframe') || target.closest('button')) return;
      isDown = true;
      startX = e.pageX - track.offsetLeft;
      scrollLeft = track.scrollLeft;
      track.style.cursor = 'grabbing';
    });
    const release = () => {
      isDown = false;
      track.style.cursor = '';
    };
    track.addEventListener('mouseleave', release);
    track.addEventListener('mouseup', release);
    track.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - track.offsetLeft;
      track.scrollLeft = scrollLeft - (x - startX) * 1.4;
    });

    // Wheel — convert vertical/diagonal trackpad scroll into horizontal carousel
    // movement. Prevents page scroll bleed when user is mid-scrub.
    track.addEventListener('wheel', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('iframe')) return;
      const horizontal = Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
      if (horizontal !== 0) {
        e.preventDefault();
        track.scrollBy({ left: horizontal * 1.2, behavior: 'auto' });
      }
    }, { passive: false });
  }
</script>
