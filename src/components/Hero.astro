---
import MeshGradient from '~/components/MeshGradient.astro';
---

<section id="top" class="relative isolate min-h-[100svh] overflow-hidden pb-16 pt-32 sm:pb-0 sm:pt-40">
  <MeshGradient />


  <div class="container-x relative">
    {/* Status pill — green available beacon */}
    <div class="mb-10 inline-flex">
      <div class="group relative" data-cursor-hover>
        <span class="inline-flex items-center justify-center gap-2.5 rounded-full border px-3.5 py-1.5 text-xs font-medium backdrop-blur" style="border-color: var(--hair); background: var(--surface-soft); color: var(--ink-soft);">
          {/* Fancy green pulse-radar beacon */}
          <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <defs>
              <radialGradient id="beacon-glow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#22C55E" stop-opacity="0.7"/>
                <stop offset="100%" stop-color="#22C55E" stop-opacity="0"/>
              </radialGradient>
            </defs>

            {/* Soft glow halo */}
            <circle cx="12" cy="12" r="10" fill="url(#beacon-glow)"/>

            {/* Outer pulse ring — expands + fades */}
            <circle cx="12" cy="12" r="4" fill="none" stroke="#22C55E" stroke-width="1.5">
              <animate attributeName="r" values="4;11;11" dur="2.4s" repeatCount="indefinite"/>
              <animate attributeName="opacity" values="0.85;0;0" dur="2.4s" repeatCount="indefinite"/>
            </circle>

            {/* Inner pulse ring — offset by 1.2s */}
            <circle cx="12" cy="12" r="4" fill="none" stroke="#22C55E" stroke-width="1.5">
              <animate attributeName="r" values="4;11;11" dur="2.4s" begin="1.2s" repeatCount="indefinite"/>
              <animate attributeName="opacity" values="0.85;0;0" dur="2.4s" begin="1.2s" repeatCount="indefinite"/>
            </circle>

            {/* Core dot with breathing scale */}
            <circle cx="12" cy="12" r="3.5" fill="#16A34A">
              <animate attributeName="r" values="3.5;4;3.5" dur="1.6s" repeatCount="indefinite"/>
            </circle>

            {/* Spec highlight */}
            <circle cx="10.8" cy="10.8" r="1" fill="#86EFAC" opacity="0.95"/>
          </svg>

          <span>Open to Summer '26 SWE internships</span>
        </span>
      </div>
    </div>

    {/* Resume-style name + title */}
    <div class="mb-6 flex flex-col gap-1">
      <p class="font-display text-base tracking-tight sm:text-lg" style="color: var(--ink-soft);">Rakshita Gupta · <span class="font-sans text-xs tracking-snug" style="color: var(--ink-faint);">she/her</span></p>
      <p class="text-[11px] uppercase tracking-[0.32em]" style="color: var(--ink-faint);">Computer Engineer</p>
    </div>

    {/* Display */}
    <h1 class="display max-w-none pr-4" style="color: var(--ink); padding-bottom:0.12em;">
      <span class="block" data-scramble="Hi, I'm">Hi, I'm</span>
      <span class="hero-name mt-1 block text-[clamp(4.5rem,12vw,10rem)]">
        <span>R</span><span>i</span><span>a</span>
      </span>
    </h1>

    <p class="mt-10 max-w-2xl text-lg leading-relaxed sm:text-xl" style="color: var(--ink-muted);">
      Junior in <span style="color: var(--ink);">Computer Engineering</span> at
      <span style="color: var(--ink);">Purdue University</span> with minors in <span style="color: var(--ink);">Psychology</span> and <span style="color: var(--ink);">Entrepreneurship</span>. <span data-typewriter style="color: var(--ink);">I write code.</span><span class="typewriter-caret" aria-hidden="true">|</span>
    </p>

    {/* CTAs */}
    <div class="mt-12 flex flex-wrap items-center gap-4">
      <a href="#work" class="btn-primary" data-magnetic="0.18">
        See selected works
        <svg class="h-3.5 w-3.5" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M7 2v10M3 8l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <a href="#contact" class="btn-ghost" data-magnetic="0.18">
        Say hi
      </a>
    </div>

    <style>
      .typewriter-caret {
        display: inline-block;
        margin-left: 1px;
        color: var(--cow-pink);
        font-weight: 300;
        animation: tw-blink 1.05s steps(1, end) infinite;
      }
      @keyframes tw-blink {
        50% { opacity: 0; }
      }
    </style>

    <script>
      (() => {
        const target = document.querySelector<HTMLElement>('[data-typewriter]');
        if (!target) return;

        const phrases = [
          'I write code.',
          'I edit videos.',
          'I take pictures.',
          'I film movies.',
          'I make apps.',
          'I like cows.',
          'I write code.',
        ];

        let phraseIdx = 0;
        let charIdx = phrases[0].length; // text starts pre-rendered, so begin at full length
        const finalIdx = phrases.length - 1;
        const TYPE_MS = 70;
        const DELETE_MS = 38;
        const HOLD_AFTER_TYPE = 1500;
        const HOLD_BEFORE_DELETE = 600;

        const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));

        const set = (txt: string) => { target.textContent = txt; };

        const type = async () => {
          while (charIdx < phrases[phraseIdx].length) {
            charIdx++;
            set(phrases[phraseIdx].slice(0, charIdx));
            await sleep(TYPE_MS);
          }
        };

        const erase = async () => {
          while (charIdx > 0) {
            charIdx--;
            set(phrases[phraseIdx].slice(0, charIdx));
            await sleep(DELETE_MS);
          }
        };

        const run = async () => {
          // initial pause so the user reads "I write code" first
          await sleep(HOLD_AFTER_TYPE);
          while (phraseIdx < finalIdx) {
            await sleep(HOLD_BEFORE_DELETE);
            await erase();
            phraseIdx += 1;
            await type();
            await sleep(HOLD_AFTER_TYPE);
          }
          // Settle on the final phrase — stop animating, keep caret blinking.
        };

        // Only run when the hero is in view (cheap check on mount; small page).
        if (typeof IntersectionObserver !== 'undefined') {
          const io = new IntersectionObserver((entries, obs) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                run();
                obs.disconnect();
                break;
              }
            }
          }, { rootMargin: '0px' });
          io.observe(target);
        } else {
          run();
        }
      })();
    </script>

    {/* Meta strip */}
    <div class="mt-24 grid grid-cols-2 gap-x-8 gap-y-6 sm:grid-cols-4 sm:gap-x-12">
      {[
        { k: 'Based', v: 'West Lafayette, IN' },
        { k: 'Grad', v: 'May 2027' },
        { k: 'Stack', v: 'C/C++, Python, Java, Swift' },
        { k: 'Top skill', v: 'cow 🐄' },
      ].map((m) => (
        <div>
          <p class="text-[11px] uppercase tracking-[0.18em]" style="color: var(--ink-faint);">{m.k}</p>
          <p class="mt-1.5 text-sm font-medium" style="color: var(--ink-soft);">{m.v}</p>
        </div>
      ))}
    </div>
  </div>

</section>
