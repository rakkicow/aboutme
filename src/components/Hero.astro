---
import MeshGradient from '~/components/MeshGradient.astro';
---

<section id="top" class="relative isolate flex grow shrink-0 flex-col justify-center overflow-hidden pb-10 pt-24 sm:pb-12 sm:pt-28">
  <MeshGradient />


  <div class="container-x relative">
    {/* Status */}
    <div class="mb-6 inline-flex sm:mb-8">
      <div class="group relative" data-cursor-hover>
        <span class="inline-flex items-center justify-center gap-2.5 rounded-full border px-3.5 py-1.5 text-xs font-medium backdrop-blur" style="border-color: var(--hair); background: var(--surface-soft); color: var(--ink-soft);">
          <svg class="h-3.5 w-3.5 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
            <defs>
              <radialGradient id="beacon-glow" cx="50%" cy="50%" r="50%">
                <stop offset="0%" stop-color="#22C55E" stop-opacity="0.7"/>
                <stop offset="100%" stop-color="#22C55E" stop-opacity="0"/>
              </radialGradient>
            </defs>

            <circle cx="12" cy="12" r="10" fill="url(#beacon-glow)"/>

            <circle cx="12" cy="12" r="4" fill="none" stroke="#22C55E" stroke-width="1.5">
              <animate attributeName="r" values="4;11;11" dur="2.4s" repeatCount="indefinite"/>
              <animate attributeName="opacity" values="0.85;0;0" dur="2.4s" repeatCount="indefinite"/>
            </circle>

            <circle cx="12" cy="12" r="4" fill="none" stroke="#22C55E" stroke-width="1.5">
              <animate attributeName="r" values="4;11;11" dur="2.4s" begin="1.2s" repeatCount="indefinite"/>
              <animate attributeName="opacity" values="0.85;0;0" dur="2.4s" begin="1.2s" repeatCount="indefinite"/>
            </circle>

            <circle cx="12" cy="12" r="3.5" fill="#16A34A">
              <animate attributeName="r" values="3.5;4;3.5" dur="1.6s" repeatCount="indefinite"/>
            </circle>

            <circle cx="10.8" cy="10.8" r="1" fill="#86EFAC" opacity="0.95"/>
          </svg>
          {/* Sup? */}
          <span>Open to Summer '27 Internships</span>
        </span>
      </div>
    </div>

    {/* Display */}
    <h1 class="display max-w-none pr-4" style="color: var(--ink); padding-bottom:0.12em;">
      <span class="block" data-scramble="Hi, I'm">Hi, I'm</span>
      <span class="hero-name mt-1 block text-[clamp(3.5rem,9vw,7.5rem)]">
        <span>R</span><span>i</span><span>a</span>
      </span>
    </h1>

    <p class="mt-6 max-w-2xl text-base leading-relaxed sm:mt-8 sm:text-lg" style="color: var(--ink-muted);">
      <span style="color: var(--ink);">Computer Engineering Technology</span> student at
      <span style="color: var(--ink);">Purdue University</span> with minors in <span style="color: var(--ink);">Psychology</span>, <span style="color: var(--ink);">Entrepreneurship</span>, and <span style="color: var(--ink);">Computer Engineering</span>. <span class="inline-block min-w-[10.5rem] whitespace-nowrap align-baseline sm:min-w-[11.5rem]"><span data-typewriter style="color: var(--ink);">I write code.</span><span class="typewriter-caret" aria-hidden="true">|</span></span>
    </p>

    {/* CTAs */}
    <div class="mt-8 flex flex-wrap items-center gap-4 sm:mt-10">
      <a href="#eras" class="btn-primary" data-magnetic="0.18">
        See selected works
        <svg class="h-3.5 w-3.5" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="M7 2v10M3 8l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
        </svg>
      </a>
      <a href="#contact" class="say-hi" data-magnetic="0.18" aria-label="Say hi">
        <span class="say-hi-text">Say hi</span>
        <span class="say-hi-wave" aria-hidden="true">👋🏾</span>
      </a>
    </div>

    <style>
      .typewriter-caret {
        display: inline-block;
        margin-left: 1px;
        color: var(--cow-pink);
        font-weight: 300;
        animation: tw-blink 1.05s steps(1, end) infinite;
      }
      @keyframes tw-blink {
        50% { opacity: 0; }
      }

      /* "Say hi" — orange-outlined by default; on hover the label slides out and
         a waving hand takes its place. Width stays fixed (emoji is absolute) so
         there's no layout shift. */
      .say-hi {
        position: relative;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border-radius: 999px;
        padding: 0.75rem 1.5rem;
        font-size: 0.875rem;
        font-weight: 500;
        line-height: 1.25rem;
        color: var(--ember-600);
        background: rgba(255, 255, 255, 0.6);
        -webkit-backdrop-filter: blur(12px);
        backdrop-filter: blur(12px);
        box-shadow:
          inset 0 0 0 1.5px rgba(255, 122, 30, 0.55),
          0 1px 0 rgba(255, 255, 255, 0.8),
          0 8px 24px -14px rgba(255, 122, 30, 0.5);
        transition: box-shadow 300ms cubic-bezier(0.16, 1, 0.3, 1), background 300ms ease;
      }
      :global(.dark) .say-hi {
        color: var(--ember-500);
        background: rgba(255, 122, 30, 0.1);
        box-shadow:
          inset 0 0 0 1.5px rgba(255, 122, 30, 0.5),
          0 8px 24px -14px rgba(255, 122, 30, 0.55);
      }
      .say-hi:hover {
        background: rgba(255, 122, 30, 0.12);
        box-shadow:
          inset 0 0 0 1.5px rgba(255, 122, 30, 0.95),
          0 12px 30px -12px rgba(255, 122, 30, 0.55),
          0 0 30px -8px rgba(255, 144, 67, 0.5);
      }
      :global(.dark) .say-hi:hover {
        background: rgba(255, 122, 30, 0.16);
      }

      .say-hi-text {
        transition: opacity 200ms ease, transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
      }
      .say-hi-wave {
        position: absolute;
        inset: 0;
        display: grid;
        place-items: center;
        font-size: 1.15rem;
        opacity: 0;
        transform: scale(0.4) rotate(0deg);
        transform-origin: 65% 80%;
        transition: opacity 180ms ease, transform 220ms cubic-bezier(0.16, 1, 0.3, 1);
        pointer-events: none;
      }
      .say-hi:hover .say-hi-text {
        opacity: 0;
        transform: translateY(-150%);
      }
      .say-hi:hover .say-hi-wave {
        opacity: 1;
        transform: scale(1) rotate(0deg);
        animation: say-hi-wave 1.4s ease-in-out 200ms infinite;
      }
      @keyframes say-hi-wave {
        0%, 55%, 100% { transform: scale(1) rotate(0deg); }
        62% { transform: scale(1) rotate(16deg); }
        70% { transform: scale(1) rotate(-10deg); }
        78% { transform: scale(1) rotate(14deg); }
        86% { transform: scale(1) rotate(-8deg); }
        94% { transform: scale(1) rotate(6deg); }
      }

      @keyframes screen-shake {
        0%, 100% { transform: translate(0, 0); }
        10% { transform: translate(-1.5px, 1.5px); }
        20% { transform: translate(1.5px, -1.5px); }
        30% { transform: translate(-1.5px, -1.5px); }
        40% { transform: translate(1.5px, 1.5px); }
        50% { transform: translate(-1.5px, 0); }
        60% { transform: translate(1.5px, 0); }
        70% { transform: translate(0, 1.5px); }
        80% { transform: translate(0, -1.5px); }
        90% { transform: translate(-1.5px, 1.5px); }
      }
      :global(.shake-screen) {
        animation: screen-shake 0.15s ease-in-out infinite;
      }
      @keyframes shout-effect {
        0% { transform: scale(1); }
        8% { transform: scale(1.8); }
        23% { transform: scale(1.8) rotate(-4deg); }
        38% { transform: scale(1.8) rotate(4deg); }
        53% { transform: scale(1.8) rotate(-3deg); }
        68% { transform: scale(1.8) rotate(3deg); }
        83% { transform: scale(1.8) rotate(-2deg); }
        92% { transform: scale(1.1); }
        100% { transform: scale(1); }
      }
      .shout-anim {
        animation: shout-effect 1.8s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        display: inline-block;
        transform-origin: left center;
        will-change: transform;
      }
    </style>

    <script>
      (() => {
        const target = document.querySelector<HTMLElement>('[data-typewriter]');
        if (!target) return;

        const phrases = [
          'I write code.',
          'I edit videos.',
          'I 3d print.',
          'I solder circuits.',
          'I like cows.',
          'I build sites.',
          'I film movies.',
          'I make apps.',
          'I take pictures.',
          'I love chai.',
          'I model in 3D.',
        ];

        let phraseIdx = 0;
        let charIdx = phrases[0].length;
        const TYPE_MS = 70;
        const DELETE_MS = 38;
        const HOLD_AFTER_TYPE = 1500;
        const HOLD_BEFORE_DELETE = 600;


        let onScreen = true;
        if (typeof IntersectionObserver !== 'undefined') {
          const visIO = new IntersectionObserver(
            ([entry]) => { onScreen = entry.isIntersecting; },
            { rootMargin: '50px' },
          );
          visIO.observe(target);
        }
        const sleep = (ms: number) => new Promise<void>((r) => setTimeout(r, ms));
        const waitForVisible = async () => {
          while (!onScreen) await sleep(250);
        };

        const set = (txt: string) => { target.textContent = txt; };

        const type = async () => {
          while (charIdx < phrases[phraseIdx].length) {
            await waitForVisible();
            charIdx++;
            set(phrases[phraseIdx].slice(0, charIdx));
            await sleep(TYPE_MS);
          }
        };

        const erase = async () => {
          while (charIdx > 0) {
            await waitForVisible();
            charIdx--;
            set(phrases[phraseIdx].slice(0, charIdx));
            await sleep(DELETE_MS);
          }
        };

        const run = async () => {

          await sleep(HOLD_AFTER_TYPE);
          while (true) {
            await waitForVisible();
            await sleep(HOLD_BEFORE_DELETE);
            await erase();
            phraseIdx = (phraseIdx + 1) % phrases.length;
            await type();
            await sleep(HOLD_AFTER_TYPE);
          }
        };

        run();
      })();
    </script>

    <div class="mt-10 grid grid-cols-2 gap-y-6 sm:mt-14 sm:flex sm:justify-between">
      {[
        { k: 'Based', v: 'West Lafayette, IN' },
        { k: 'Grad', v: 'May 2028' },
        { k: 'Stack', v: 'Full :)', href: '#languages' },
        { k: 'Fav skill', v: 'cow', emoji: '🐄', moo: true, last: true },
      ].map((m, i) => (
        m.href ? (
          <a
            href={m.href}
            aria-label={`${m.k}: ${m.v} — jump to languages`}
            class="group block w-fit focus:outline-none max-sm:even:justify-self-end"
          >
            <p class="cow-ink text-[11px] uppercase tracking-[0.18em]" style="color: var(--ink-faint);">{m.k}</p>
            <p class="mt-1.5 inline-flex items-center gap-1 text-sm font-medium" style="color: var(--ink-soft);">
              <span class="cow-ink">{m.v}</span>
              <svg class="h-3 w-3 -translate-x-1 opacity-0 transition-all duration-300 group-hover:translate-x-0 group-hover:opacity-100 group-hover:text-[#DC9BB5]" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M7 2v10M3 8l4 4 4-4" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </p>
          </a>
        ) : m.moo ? (
          <button
            type="button"
            data-moo
            aria-label={`${m.k}: ${m.v} ${m.emoji} — press for a moo`}
            class="group block w-fit cursor-pointer appearance-none border-0 bg-transparent p-0 text-left focus:outline-none max-sm:even:justify-self-end"
          >
            <p class="text-[11px] uppercase tracking-[0.18em]" style="color: var(--ink-faint);">{m.k}</p>
            <p class="mt-1.5 inline-flex items-center gap-1 text-sm font-medium transition-transform duration-200 group-active:scale-90" style="color: var(--ink-soft);">
              <span>{m.v}</span>
              <span data-moo-emoji class="inline-block origin-bottom">{m.emoji}</span>
            </p>
          </button>
        ) : (
          <div class="w-fit max-sm:even:justify-self-end">
            <p class="text-[11px] uppercase tracking-[0.18em]" style="color: var(--ink-faint);">{m.k}</p>
            <p class="mt-1.5 text-sm font-medium" style="color: var(--ink-soft);">{m.v}</p>
          </div>
        )
      ))}
    </div>
  </div>

  {/* Easter egg — tapping the "cow" top-skill plays a moo */}
  <script>
    (() => {
      const btn = document.querySelector<HTMLButtonElement>('[data-moo]');
      if (!btn) return;
      const emojiSpan = btn.querySelector<HTMLElement>('[data-moo-emoji]');
      const audio = new Audio('/assets/moo.mp3');
      btn.addEventListener('click', () => {
        document.body.classList.add('shake-screen');
        if (emojiSpan) {
          emojiSpan.classList.remove('shout-anim');
          void emojiSpan.offsetWidth; // trigger reflow
          emojiSpan.classList.add('shout-anim');
        }
        setTimeout(() => document.body.classList.remove('shake-screen'), 1800);

        audio.currentTime = 0;
        audio.play().catch(() => {});
      });
    })();
  </script>

</section>
