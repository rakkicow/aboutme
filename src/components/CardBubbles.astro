---
// My Works!
---

<div class="pointer-events-none absolute inset-0 -z-0 overflow-hidden rounded-[28px]">
  <div class="absolute inset-0" style="background: linear-gradient(135deg, #5E9FFF 0%, #1E7AFF 35%, #0846B8 70%, #002C82 100%);"></div>

  <div class="absolute -left-20 -top-20 h-72 w-72 rounded-full animate-mesh-drift" style="background: radial-gradient(circle, rgba(168,210,255,0.85), transparent 60%); filter: blur(40px);"></div>
  <div class="absolute -right-16 bottom-0 h-80 w-80 rounded-full animate-mesh-drift-2" style="background: radial-gradient(circle, rgba(140,255,225,0.5), transparent 65%); filter: blur(50px);"></div>
  <div class="absolute left-1/3 top-1/2 h-64 w-64 rounded-full animate-mesh-drift-3" style="background: radial-gradient(circle, rgba(220,155,181,0.4), transparent 70%); filter: blur(55px);"></div>

  <svg class="absolute inset-0 h-full w-full opacity-[0.08]" preserveAspectRatio="none" aria-hidden="true">
    <defs>
      <pattern id="grid-bubbles" width="22" height="22" patternUnits="userSpaceOnUse">
        <path d="M 22 0 L 0 0 0 22" fill="none" stroke="#ffffff" stroke-width="0.5" />
      </pattern>
    </defs>
    <rect width="100%" height="100%" fill="url(#grid-bubbles)" />
  </svg>

  <div class="absolute -top-1/2 left-1/2 h-[140%] w-[180%] -translate-x-1/2 rotate-12 opacity-25 animate-mesh-drift-2" style="background: linear-gradient(75deg, transparent 40%, rgba(255,255,255,0.6) 50%, transparent 60%);"></div>

  <div class="absolute inset-0 rounded-[28px]" style="box-shadow: inset 0 1px 0 rgba(255,255,255,0.4), inset 0 -1px 0 rgba(0,0,0,0.2);"></div>
</div>

{/* Bubbles */}
<div class="relative aspect-[16/10] w-full overflow-hidden rounded-2xl">
  {/* Incoming */}
  <div class="absolute left-5 top-6 max-w-[60%]">
    <div
      class="rounded-3xl rounded-bl-md px-4 py-2.5 text-[13px] font-semibold text-ink shadow-[0_12px_32px_-8px_rgba(0,30,80,0.4)]"
      style="background: #FFFFFF;"
    >
      <span>iMessage on Android?</span>
    </div>
  </div>

  {/* Outgoing */}
  <div class="absolute right-5 top-24 max-w-[60%]">
    <div
      class="rounded-3xl rounded-br-md px-4 py-2.5 text-[13px] font-semibold text-white shadow-[0_12px_32px_-8px_rgba(0,30,80,0.55)]"
      style="background: linear-gradient(180deg, #3B8BFF 0%, #1E7AFF 100%);"
    >
      <span>Yup, ofc!</span>
    </div>
  </div>


  {/* Typing Indicator */}
  <div class="absolute left-10 bottom-6 max-w-[35%]">
    <div
      class="rounded-3xl rounded-bl-md px-4 py-2.5 shadow-[0_8px_24px_-6px_rgba(0,30,80,0.4)]"
      style="background: #FFFFFF;"
    >
      <span class="flex items-center gap-1">
        <span class="inline-block h-1.5 w-1.5 animate-bounce rounded-full bg-ink/45" style="animation-delay:0ms"></span>
        <span class="inline-block h-1.5 w-1.5 animate-bounce rounded-full bg-ink/45" style="animation-delay:140ms"></span>
        <span class="inline-block h-1.5 w-1.5 animate-bounce rounded-full bg-ink/45" style="animation-delay:280ms"></span>
      </span>
    </div>
  </div>
</div>
