---
---

<div
  id="cursor"
  class="cursor-fx pointer-events-none fixed left-0 top-0 z-[60] h-8 w-8 -translate-x-1/2 -translate-y-1/2 rounded-full"
  style="
    background: radial-gradient(circle, rgba(255,122,30,0.18) 0%, rgba(255,122,30,0) 70%);
    mix-blend-mode: multiply;
    transition: width 280ms cubic-bezier(0.16, 1, 0.3, 1), height 280ms cubic-bezier(0.16, 1, 0.3, 1);
  "
></div>
<div
  id="cursor-dot"
  class="cursor-fx pointer-events-none fixed left-0 top-0 z-[60] h-1.5 w-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full"
  style="background: #FF6A05; box-shadow: 0 0 12px rgba(255,106,5,0.6);"
></div>

<style>
  /* Show custom cursor on any device with a hover-capable pointer (mouse/trackpad),
     regardless of viewport size. Hide on touch-only. */
  .cursor-fx { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .cursor-fx { display: block; }
  }
</style>

<script>
  const cursor = document.getElementById('cursor');
  const dot = document.getElementById('cursor-dot');
  const hasFinePointer =
    typeof window !== 'undefined' &&
    window.matchMedia('(hover: hover) and (pointer: fine)').matches;

  if (cursor && dot && hasFinePointer) {
    let mouseX = 0, mouseY = 0;
    let curX = 0, curY = 0;
    let rafId: number | null = null;

    const animate = () => {
      const dx = mouseX - curX;
      const dy = mouseY - curY;
      const settled = Math.abs(dx) < 0.5 && Math.abs(dy) < 0.5;
      if (settled) {
        curX = mouseX;
        curY = mouseY;
        cursor.style.transform = `translate(${curX}px, ${curY}px) translate(-50%, -50%)`;
        rafId = null;
        return;
      }
      curX += dx * 0.18;
      curY += dy * 0.18;
      cursor.style.transform = `translate(${curX}px, ${curY}px) translate(-50%, -50%)`;
      rafId = requestAnimationFrame(animate);
    };

    const kick = () => {
      if (rafId === null) rafId = requestAnimationFrame(animate);
    };

    window.addEventListener('mousemove', (e) => {
      mouseX = e.clientX;
      mouseY = e.clientY;
      dot.style.transform = `translate(${mouseX}px, ${mouseY}px) translate(-50%, -50%)`;
      kick();
    }, { passive: true });

    document.addEventListener('visibilitychange', () => {
      if (document.hidden && rafId !== null) {
        cancelAnimationFrame(rafId);
        rafId = null;
      } else if (!document.hidden) {
        kick();
      }
    });

    const enlarge = () => {
      cursor.style.width = '64px';
      cursor.style.height = '64px';
    };
    const shrink = () => {
      cursor.style.width = '32px';
      cursor.style.height = '32px';
    };

    document.querySelectorAll('a, button, [data-cursor-hover]').forEach((el) => {
      el.addEventListener('mouseenter', enlarge);
      el.addEventListener('mouseleave', shrink);
    });
  }
</script>
