---
import { webShelf } from '~/data/projects';
---

<dialog
  id="web-shelf"
  data-shelf-modal
  aria-label="Web shelf"
>
  {/* Backdrop — clicking it closes the shelf */}
  <div data-shelf-close class="absolute inset-0" style="background: rgba(10, 10, 16, 0.55); backdrop-filter: blur(10px); -webkit-backdrop-filter: blur(10px);"></div>

  {/* Panel wrapped in a shell so the close button floats just outside the corner */}
  <div class="relative w-full max-w-5xl">
    <button type="button" data-shelf-close class="shelf-arrow absolute -right-3 -top-3 z-30" aria-label="Close shelf">
      <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18" stroke-linecap="round" /></svg>
    </button>
    <div class="relative max-h-[88vh] w-full overflow-y-auto rounded-[28px] border p-6 sm:p-10" style="border-color: var(--hair); background: var(--canvas); color: var(--ink); box-shadow: var(--shadow-glow-sm);">

    <div class="grid items-end gap-6 lg:grid-cols-[1fr,auto]">
      <div>
        <p class="eyebrow">Web shelf</p>
        <h3 class="h2 mt-4 max-w-[18ch]">
          It was all by <span class="h-italic text-gradient-pink-animated">design</span>.
        </h3>
        <p class="mt-5 max-w-md text-sm leading-relaxed" style="color: var(--ink-muted);">
          A rotating archive of small sites I've shipped for clubs, family, and
          friends. Drag, scroll, or use the arrows to peek through.
        </p>
      </div>

      {/* Arrow controls */}
      <div class="flex items-end justify-end gap-2">
        <button type="button" data-shelf-prev class="shelf-arrow" aria-label="Scroll shelf left">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M15 18l-6-6 6-6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
        <button type="button" data-shelf-next class="shelf-arrow" aria-label="Scroll shelf right">
          <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 18l6-6-6-6" stroke-linecap="round" stroke-linejoin="round" /></svg>
        </button>
      </div>
    </div>

    {/* Horizontal scroll-snap shelf */}
    <div
      data-shelf-track
      class="no-scrollbar mt-6 flex snap-x snap-mandatory gap-5 overflow-x-auto overflow-y-hidden scroll-smooth pb-2 pt-2"
      style="scroll-padding-left: 0.5rem; overscroll-behavior-x: contain; overscroll-behavior-y: auto;"
    >
    {webShelf.map((s, i) => (
      <a
        href={s.href}
        target="_blank"
        rel="noopener noreferrer"
        class="group card-lift relative block snap-start shrink-0 w-[78vw] sm:w-[360px] lg:w-[400px] overflow-hidden rounded-2xl border"
        style="border-color: var(--hair); background: var(--surface); box-shadow: 0 1px 0 rgba(255,255,255,0.08) inset, 0 4px 16px -8px rgba(15,15,16,0.16);"
      >
        {/* Mini browser window */}
        <div class="relative aspect-[16/10] w-full overflow-hidden border-b" style="border-color: var(--hair); background: var(--canvas);">
          <div class="absolute inset-x-0 top-0 z-10 flex items-center gap-1.5 border-b px-2.5 py-1.5 backdrop-blur" style="border-color: var(--hair); background: var(--surface-soft);">
            <span class="h-2 w-2 rounded-full bg-[#FF5F57]"></span>
            <span class="h-2 w-2 rounded-full bg-[#FEBC2E]"></span>
            <span class="h-2 w-2 rounded-full bg-[#28C840]"></span>
            <span class="ml-2 flex-1 truncate rounded-md px-2 py-0.5 text-[9px]" style="background: var(--hair); color: var(--ink-muted);">{s.liveUrl}</span>
          </div>

          {/* Screenshot at rest; the live site fades in over it on hover.
              Only the hovered card ever holds an iframe — that's what kept
              memory (and the old flicker) in check. */}
          <div
            class="absolute inset-x-0 bottom-0 top-[28px] overflow-hidden"
            data-live-slot
            data-live-src={s.liveUrl}
            data-live-title={`${s.name} live preview`}
            style="background: var(--surface);"
          >
            <img
              src={s.shot}
              alt={`${s.name} — screenshot`}
              loading="lazy"
              decoding="async"
              class="h-full w-full object-cover object-top"
            />
          </div>

          <div class="pointer-events-none absolute inset-x-0 bottom-0 top-[28px] z-[2] grid place-items-end justify-items-center pb-3 opacity-0 transition-opacity duration-300 group-hover:opacity-100" style="background: linear-gradient(180deg, transparent 60%, rgba(10, 10, 16, 0.5));">
            <p class="text-[10px] uppercase tracking-[0.2em] text-white/90">live · click to visit ↗</p>
          </div>

          <span class="pointer-events-none absolute inset-x-0 bottom-0 block h-px bg-gradient-to-r from-transparent via-cow-300 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></span>
        </div>

        <div class="p-4">
          <div class="flex items-baseline justify-between">
            <span class="font-mono text-[10px]" style="color: var(--ink-faint);">{`0${i + 1}`}</span>
            <span class="font-mono text-[10px]" style="color: var(--ink-faint);">{s.year}</span>
          </div>
          <h4 class="font-display mt-2 text-lg leading-tight tracking-tight" style="color: var(--ink);">{s.name}</h4>
          <p class="mt-1 text-[10px] uppercase tracking-[0.15em] text-cow-600 dark:text-cow-300">{s.purpose}</p>
          <p class="mt-2 text-xs leading-snug" style="color: var(--ink-muted);">{s.detail}</p>
        </div>
      </a>
    ))}
      </div>
    </div>
  </div>
</dialog>

<style>
  /* Native <dialog> in the top layer — immune to ancestor transforms, always
     centered in the viewport. The dialog is a full-bleed transparent flex
     container; the blur layer inside it doubles as the click-to-close target. */
  dialog[data-shelf-modal] {
    position: fixed;
    inset: 0;
    margin: 0;
    width: 100vw;
    height: 100vh;
    max-width: none;
    max-height: none;
    padding: 1rem;
    border: 0;
    background: transparent;
    display: none;
    align-items: center;
    justify-content: center;
    overscroll-behavior: contain;
  }
  dialog[data-shelf-modal][open] {
    display: flex;
  }
  dialog[data-shelf-modal]::backdrop {
    background: transparent;
  }
  @media (min-width: 640px) {
    dialog[data-shelf-modal] {
      padding: 2rem;
    }
  }

  .shelf-arrow {
    display: inline-grid;
    place-items: center;
    height: 38px;
    width: 38px;
    border-radius: 999px;
    border: 1px solid var(--hair);
    background: var(--surface);
    color: var(--ink);
    transition: transform 280ms cubic-bezier(0.16, 1, 0.3, 1), background 240ms ease, box-shadow 240ms ease;
  }
  .shelf-arrow:hover {
    transform: translateY(-2px);
    background: var(--cow-pink-soft);
    box-shadow: 0 12px 28px -10px rgba(220, 155, 181, 0.45);
  }
  .shelf-arrow:active { transform: translateY(0); }
</style>

<script>
  // Live-on-hover previews. The screenshot stays underneath, the iframe fades
  // in once its document has painted, and it's torn down shortly after the
  // pointer leaves — so at most one sub-site is ever resident in memory.
  // Only on hover-capable pointers: on touch there's no hover, and swiping
  // would rapidly mount/unmount full-site iframes (flicker + broken layout),
  // so mobile just shows the static screenshots.
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  if (canHover) document.querySelectorAll<HTMLElement>('[data-live-slot]').forEach((slot) => {
    const card = slot.closest('a');
    if (!card) return;
    let killTimer: number | null = null;

    const mount = () => {
      if (killTimer !== null) {
        clearTimeout(killTimer);
        killTimer = null;
      }
      if (slot.querySelector('iframe')) return;
      const iframe = document.createElement('iframe');
      iframe.src = slot.dataset.liveSrc ?? '';
      iframe.title = slot.dataset.liveTitle ?? '';
      iframe.setAttribute('sandbox', 'allow-scripts allow-same-origin');
      iframe.className =
        'absolute left-0 top-0 origin-top-left border-0 opacity-0 transition-opacity duration-500';
      iframe.setAttribute('style', 'width:200%;height:200%;transform:scale(0.5);');
      iframe.addEventListener('load', () => {
        iframe.classList.remove('opacity-0');
      });
      slot.appendChild(iframe);
    };

    const scheduleUnmount = () => {
      if (killTimer !== null) clearTimeout(killTimer);
      killTimer = window.setTimeout(() => {
        slot.querySelector('iframe')?.remove();
        killTimer = null;
      }, 400);
    };

    card.addEventListener('mouseenter', mount);
    card.addEventListener('focusin', mount);
    card.addEventListener('mouseleave', scheduleUnmount);
    card.addEventListener('focusout', scheduleUnmount);
  });

  // Modal open/close — "See the shelf →" (any #web-shelf link) opens it;
  // the X, the blur backdrop, or Escape (native dialog behavior) closes it.
  // While open, page scroll is paused (Lenis stopped + body overflow hidden)
  // so wheel gestures only move the shelf itself.
  const modal = document.querySelector<HTMLDialogElement>('[data-shelf-modal]');
  if (modal) {
    const lenis = () => (window as unknown as { __lenis?: { stop(): void; start(): void } }).__lenis;
    // The dialog paints in the top layer, above everything outside it — so the
    // custom cursor must live INSIDE the dialog while it's open to stay visible.
    const cursorFx = ['cursor', 'cursor-dot']
      .map((id) => document.getElementById(id))
      .filter((el): el is HTMLElement => !!el)
      .map((el) => ({ el, home: el.parentElement }));
    const openModal = (e: Event) => {
      e.preventDefault();
      modal.showModal();
      document.body.style.overflow = 'hidden';
      lenis()?.stop();
      cursorFx.forEach(({ el }) => modal.appendChild(el));
    };
    document.querySelectorAll<HTMLAnchorElement>('a[href="#web-shelf"]').forEach((a) => {
      a.addEventListener('click', openModal);
    });
    modal.querySelectorAll('[data-shelf-close]').forEach((el) => {
      el.addEventListener('click', () => modal.close());
    });
    // Fires on modal.close() and on Escape alike.
    modal.addEventListener('close', () => {
      document.body.style.overflow = '';
      lenis()?.start();
      cursorFx.forEach(({ el, home }) => home?.appendChild(el));
      // Release any live preview still mounted
      modal.querySelectorAll('[data-live-slot] iframe').forEach((f) => f.remove());
    });
  }

  const track = document.querySelector<HTMLElement>('[data-shelf-track]');
  if (track) {
    const step = () => {
      const card = track.querySelector<HTMLElement>('a');
      return (card?.offsetWidth ?? 360) + 20;
    };

    document.querySelector('[data-shelf-next]')?.addEventListener('click', () => {
      track.scrollBy({ left: step(), behavior: 'smooth' });
    });
    document.querySelector('[data-shelf-prev]')?.addEventListener('click', () => {
      track.scrollBy({ left: -step(), behavior: 'smooth' });
    });

    // Wheel — advance exactly one card per gesture, no matter how far the
    // trackpad is flicked (a cooldown swallows the rest of the momentum).
    let wheelCooling = false;
    let wheelAcc = 0;
    track.addEventListener('wheel', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('iframe')) return;
      e.preventDefault();
      if (wheelCooling) return;
      wheelAcc += Math.abs(e.deltaX) > Math.abs(e.deltaY) ? e.deltaX : e.deltaY;
      if (Math.abs(wheelAcc) > 40) {
        const dir = wheelAcc > 0 ? 1 : -1;
        wheelAcc = 0;
        wheelCooling = true;
        setTimeout(() => (wheelCooling = false), 600);
        track.scrollBy({ left: dir * step(), behavior: 'smooth' });
      }
    }, { passive: false });

    // Drag-to-scrub
    let isDown = false;
    let startX = 0;
    let scrollLeft = 0;
    track.addEventListener('mousedown', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest('iframe') || target.closest('button')) return;
      isDown = true;
      startX = e.pageX - track.offsetLeft;
      scrollLeft = track.scrollLeft;
      track.style.cursor = 'grabbing';
    });
    const release = () => {
      isDown = false;
      track.style.cursor = '';
    };
    track.addEventListener('mouseleave', release);
    track.addEventListener('mouseup', release);
    track.addEventListener('mousemove', (e) => {
      if (!isDown) return;
      e.preventDefault();
      const x = e.pageX - track.offsetLeft;
      track.scrollLeft = scrollLeft - (x - startX) * 1.4;
    });
  }
</script>
