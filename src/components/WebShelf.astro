---
import { webShelf } from '~/data/projects';
---

<div id="web-shelf" class="mt-20 grid items-end gap-10 lg:grid-cols-[1fr,2fr]">
  <div class="reveal">
    <p class="eyebrow">Web shelf</p>
    <h3 class="h2 mt-4 max-w-[18ch]">
      The sites <br /><span class="h-italic text-gradient-pink">behind</span> the third card.
    </h3>
    <p class="mt-5 max-w-md text-sm leading-relaxed" style="color: var(--ink-muted);">
      A rotating archive of small sites I've shipped for clubs, family, and
      friends since high school. Hover any tile to peek at the live build.
    </p>
  </div>

  <div class="reveal grid gap-5 sm:grid-cols-3">
    {webShelf.map((s, i) => (
      <a
        href={s.href}
        target="_blank"
        rel="noopener noreferrer"
        class="group card-lift relative block overflow-hidden rounded-2xl border"
        style="border-color: var(--hair); background: var(--surface); box-shadow: 0 1px 0 rgba(255,255,255,0.08) inset, 0 4px 16px -8px rgba(15,15,16,0.16);"
      >
        {/* Mini browser window */}
        <div class="relative aspect-[4/3] w-full overflow-hidden border-b" style="border-color: var(--hair); background: var(--canvas);">
          {/* Window chrome */}
          <div class="absolute inset-x-0 top-0 z-10 flex items-center gap-1.5 border-b px-2.5 py-1.5 backdrop-blur" style="border-color: var(--hair); background: var(--surface-soft);">
            <span class="h-2 w-2 rounded-full bg-[#FF5F57]"></span>
            <span class="h-2 w-2 rounded-full bg-[#FEBC2E]"></span>
            <span class="h-2 w-2 rounded-full bg-[#28C840]"></span>
            <span class="ml-2 flex-1 truncate rounded-md px-2 py-0.5 text-[9px]" style="background: var(--hair); color: var(--ink-muted);">{s.liveUrl}</span>
          </div>

          {/* Live iframe preview */}
          <iframe
            src={s.liveUrl}
            title={`${s.name} live preview`}
            loading="lazy"
            sandbox="allow-scripts allow-same-origin"
            class="absolute inset-x-0 bottom-0 h-[calc(100%-1.75rem)] w-[200%] origin-top-left scale-50 border-0 transition-transform duration-700 group-hover:scale-[0.55]"
          ></iframe>

          {/* Fallback overlay */}
          <div class="pointer-events-none absolute inset-x-0 bottom-0 top-7 z-[1] grid place-items-center text-center transition-opacity duration-700 group-hover:opacity-0" style="background: linear-gradient(135deg, var(--cow-pink-soft), var(--surface));">
            <div>
              <p class="text-[10px] uppercase tracking-[0.2em]" style="color: var(--ink-faint);">Live preview</p>
              <p class="mt-1 text-sm font-medium" style="color: var(--ink-soft);">{s.name}</p>
              <p class="mt-3 text-[10px]" style="color: var(--ink-faint);">hover to peek</p>
            </div>
          </div>

          {/* Glow on hover */}
          <span class="pointer-events-none absolute inset-x-0 bottom-0 block h-px bg-gradient-to-r from-transparent via-cow-300 to-transparent opacity-0 transition-opacity duration-500 group-hover:opacity-100"></span>
        </div>

        {/* Caption */}
        <div class="p-5">
          <div class="flex items-start justify-between">
            <span class="font-mono text-[10px]" style="color: var(--ink-faint);">{`0${i + 1}`}</span>
            <span class="font-mono text-[10px]" style="color: var(--ink-faint);">{s.year}</span>
          </div>
          <h4 class="font-display mt-3 text-lg tracking-tight" style="color: var(--ink);">{s.name}</h4>
          <p class="mt-1.5 text-xs uppercase tracking-[0.15em] text-cow-600 dark:text-cow-300">{s.purpose}</p>
          <p class="mt-3 text-sm leading-relaxed" style="color: var(--ink-muted);">{s.detail}</p>
        </div>
      </a>
    ))}
  </div>
</div>
