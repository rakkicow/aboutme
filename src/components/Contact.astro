---
import { bio } from '~/data/resume';

const handles = [
  {
    label: 'Site',
    value: 'rakshita.me',
    href: 'https://rakshita.me',
    badge: '(you are here!)',
  },
  {
    label: 'LinkedIn',
    value: 'in/rakshita-gupta-4571a7251',
    href: bio.linkedin,
  },
  {
    label: 'Email',
    value: bio.email,
    href: `mailto:${bio.email}`,
  },
  {
    label: 'YouTube · CDI',
    value: 'youtube.com/c/cdiofficial',
    href: bio.youtube,
  },
];
---

<section id="contact" class="relative py-14 sm:py-20">
  <div class="container-x">
    <div class="relative overflow-hidden rounded-[36px] border p-10 sm:p-16 lg:p-24" style="border-color: var(--hair); background: var(--surface);">
      {/* Inner mesh */}
      <div class="pointer-events-none absolute inset-0 -z-0 overflow-hidden">
        <div class="absolute -left-20 -top-20 h-[40rem] w-[40rem] rounded-full animate-mesh-drift" style="background: radial-gradient(circle, rgba(255,144,67,0.55), rgba(255,144,67,0) 60%); filter: blur(80px);"></div>
        <div class="absolute -right-32 bottom-0 h-[40rem] w-[40rem] rounded-full animate-mesh-drift-2" style="background: radial-gradient(circle, rgba(220,155,181,0.6), rgba(220,155,181,0) 65%); filter: blur(90px);"></div>
      </div>

      <div class="relative grid gap-16 lg:grid-cols-[1.4fr,1fr]">
        <div class="reveal">
          <p class="eyebrow">Contact</p>
          <h2 class="display mt-6 max-w-[13ch] pr-8 leading-[1.05]" style="padding-bottom:0.15em;">
            Got an <span class="h-italic text-gradient-pink pr-2">idea?</span><br />
            Send it.
          </h2>
          <p class="mt-8 max-w-md text-lg leading-relaxed" style="color: var(--ink-muted);">
            I'm always down to talk about hardware, weird interfaces, or the
            kind of small projects that won't leave your head. Drop a line.
          </p>

          <div class="mt-10 flex flex-wrap gap-3">
            <a href={`mailto:${bio.email}`} class="btn-primary" data-magnetic="0.2">
              {bio.email}
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2.5" />
                <path d="M3.5 6.5l8.5 7 8.5-7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </a>
            <button
              type="button"
              class="btn-ghost"
              data-magnetic="0.2"
              data-copy={bio.email}
            >
              <span data-copy-label>Copy email</span>
            </button>
          </div>
        </div>

        <ul class="reveal grid grid-cols-2 gap-4 self-end lg:grid-cols-1">
          {handles.map((h) => (
            <li>
              <a
                href={h.href}
                target={h.href.startsWith('http') ? '_blank' : undefined}
                rel={h.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="group relative block overflow-hidden rounded-2xl border p-5 backdrop-blur transition-all duration-500 hover:-translate-y-0.5"
                style="border-color: var(--hair); background: var(--surface-soft); box-shadow: 0 1px 0 rgba(255,255,255,0.15) inset;"
              >
                {/* Hover glow */}
                <span class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100" style="background: radial-gradient(120% 80% at 50% 100%, rgba(220,155,181,0.25), transparent 60%);"></span>

                <p class="relative text-[10px] uppercase tracking-[0.2em]" style="color: var(--ink-faint);">
                  {h.label}
                  {h.badge && (
                    <span class="ml-2 inline-flex items-center gap-1 rounded-full bg-cow-300/20 px-2 py-0.5 text-[9px] font-medium normal-case tracking-normal text-cow-600 dark:bg-cow-300/15 dark:text-cow-200">
                      <span class="inline-block h-1 w-1 animate-pulse rounded-full bg-cow-500"></span>
                      {h.badge}
                    </span>
                  )}
                </p>
                <p class="relative mt-2 flex items-center justify-between text-sm font-medium group-hover:text-ember-700 dark:group-hover:text-cow-300" style="color: var(--ink-soft);">
                  <span class="truncate">{h.value}</span>
                  <span class="ml-3 inline-block transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">↗</span>
                </p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const text = btn.dataset.copy;
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
          const label = btn.querySelector('[data-copy-label]');
          if (label) {
            const original = label.textContent;
            label.textContent = 'Copied ✓';
            setTimeout(() => { label.textContent = original; }, 1600);
          }
        } catch {
          /* silent */
        }
      });
    });
  </script>
</section>
