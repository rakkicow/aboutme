---
import { bio, resumeVisualPdf, resumeFullPdf } from '~/data/resume';

const handles = [
  {
    key: 'site',
    label: 'Site',
    icon: 'site',
    copy: 'https://rakshita.me',
    href: 'https://rakshita.me',
    isHere: true,
  },
  {
    key: 'linkedin',
    label: 'LinkedIn',
    icon: 'linkedin',
    copy: bio.linkedin,
    href: bio.linkedin,
  },
  {
    key: 'insta',
    label: 'Insta',
    icon: 'instagram',
    copy: 'https://www.instagram.com/rakhicow/',
    href: 'https://www.instagram.com/rakhicow/',
  },
  {
    key: 'youtube',
    label: 'YouTube',
    icon: 'youtube',
    copy: bio.youtube,
    href: bio.youtube,
  },
  {
    key: 'resume-visual',
    label: 'Resume (Visual)',
    icon: 'resume',
    copy: `https://rakshita.me${resumeVisualPdf}`,
    href: resumeVisualPdf,
    download: 'RGupta - ResumeVis.pdf',
  },
  {
    key: 'resume-full',
    label: 'Resume (Full)',
    icon: 'resume',
    copy: `https://rakshita.me${resumeFullPdf}`,
    href: resumeFullPdf,
    download: 'RGupta - ResumeFull.pdf',
  },
];
---

<section id="contact" class="relative py-10 sm:py-20">
  <div class="container-x">
    <div class="relative overflow-hidden rounded-[28px] sm:rounded-[36px] border p-6 sm:p-16 lg:p-24" style="border-color: var(--hair); background: var(--surface);">
      {/* Inner mesh */}
      <div class="pointer-events-none absolute inset-0 -z-0 overflow-hidden">
        <div class="absolute -left-20 -top-20 h-[40rem] w-[40rem] rounded-full animate-mesh-drift" style="background: radial-gradient(circle, rgba(255,144,67,0.55), rgba(255,144,67,0) 60%); filter: blur(80px);"></div>
        <div class="absolute -right-32 bottom-0 h-[40rem] w-[40rem] rounded-full animate-mesh-drift-2" style="background: radial-gradient(circle, rgba(220,155,181,0.6), rgba(220,155,181,0) 65%); filter: blur(90px);"></div>
      </div>

      <div class="relative grid gap-10 sm:gap-16 lg:grid-cols-[1.4fr,1fr]">
        <div class="reveal">
          <p class="eyebrow">Contact</p>
          <h2 class="display mt-6 max-w-[14ch] pr-10 leading-[1.05]" style="padding-bottom:0.15em;">
            Wanna <span class="h-italic text-gradient-pink" style="padding-right:0.18em; margin-right:0.05em;">collab?</span><br />
            Speak now.
          </h2>
          <p class="mt-6 sm:mt-8 max-w-md text-base sm:text-lg leading-relaxed" style="color: var(--ink-muted);">
            I've got a blank space in my inbox. I'm always down to talk about
            your wildest tech dreams.
          </p>

          <div class="contact-mail-group mt-8 sm:mt-10 inline-flex items-stretch overflow-hidden rounded-full">
            <a
              href={`mailto:${bio.email}`}
              class="btn-primary !rounded-none !rounded-l-full !border-0"
              data-magnetic="0.2"
            >
              <svg class="h-3.5 w-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <rect x="3" y="5" width="18" height="14" rx="2.5" />
                <path d="M3.5 6.5l8.5 7 8.5-7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              {bio.email}
            </a>
            <button
              type="button"
              data-copy={bio.email}
              aria-label="Copy email"
              class="contact-copy-btn"
            >
              <svg class="h-4 w-4" data-copy-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <rect x="9" y="9" width="11" height="11" rx="2" />
                <path d="M5 15V6a2 2 0 0 1 2-2h9" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
              <svg class="hidden h-4 w-4" data-check-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                <path d="M5 12l5 5L20 7" stroke-linecap="round" stroke-linejoin="round" />
              </svg>
            </button>
          </div>
        </div>

        <ul class="reveal grid grid-cols-2 gap-3 sm:gap-4 self-end lg:grid-cols-1">
          {handles.map((h) => (
            <li class="relative">
              <a
                href={h.href}
                download={h.download}
                target={h.href.startsWith('http') ? '_blank' : undefined}
                rel={h.href.startsWith('http') ? 'noopener noreferrer' : undefined}
                class="group relative block overflow-hidden rounded-2xl border p-4 sm:p-5 backdrop-blur transition-all duration-500 hover:-translate-y-0.5"
                style="border-color: var(--hair); background: var(--surface-soft); box-shadow: 0 1px 0 rgba(255,255,255,0.15) inset;"
              >
                {/* Hover glow */}
                <span class="pointer-events-none absolute inset-0 opacity-0 transition-opacity duration-500 group-hover:opacity-100" style="background: radial-gradient(120% 80% at 50% 100%, rgba(220,155,181,0.25), transparent 60%);"></span>

                <p class="relative flex items-center gap-1.5 text-[10px] uppercase tracking-[0.2em]" style="color: var(--ink-faint);">
                  <span>{h.label}</span>
                  {h.isHere && (
                    <span
                      class="inline-block h-1.5 w-1.5 animate-pulse rounded-full bg-cow-500"
                      title="you are here"
                      aria-label="you are here"
                      style="box-shadow: 0 0 0 3px rgba(220,155,181,0.25);"
                    ></span>
                  )}
                </p>
                {/* Brand logo instead of a link string — never truncates on narrow screens */}
                <p class="relative mt-2 flex items-center justify-between pr-7 group-hover:text-ember-700 dark:group-hover:text-cow-300" style="color: var(--ink-soft);">
                  <span class="inline-flex h-6 w-6 items-center justify-center">
                    {h.icon === 'site' && (
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><circle cx="12" cy="12" r="9" /><path d="M3 12h18" stroke-linecap="round" /><path d="M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18Z" /></svg>
                    )}
                    {h.icon === 'linkedin' && (
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.82-2.05 3.75-2.05C20.4 8.65 21 11 21 14.1V21h-4v-6.1c0-1.45-.03-3.3-2-3.3s-2.3 1.57-2.3 3.2V21H9z" /></svg>
                    )}
                    {h.icon === 'instagram' && (
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.4" cy="6.6" r="1.1" fill="currentColor" stroke="none" /></svg>
                    )}
                    {h.icon === 'youtube' && (
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23 12s0-3.3-.42-4.88a2.5 2.5 0 0 0-1.76-1.77C19.24 5 12 5 12 5s-7.24 0-8.82.35A2.5 2.5 0 0 0 1.42 7.12 26 26 0 0 0 1 12c0 1.7.14 3.3.42 4.88a2.5 2.5 0 0 0 1.76 1.77C4.76 19 12 19 12 19s7.24 0 8.82-.35a2.5 2.5 0 0 0 1.76-1.77C22.86 15.3 23 13.7 23 12ZM9.75 15.02V8.98L15.5 12z" /></svg>
                    )}
                    {h.icon === 'resume' && (
                      <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z" stroke-linejoin="round" /><path d="M14 3v5h5M8.5 13h7M8.5 17h4.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                    )}
                  </span>
                  <span class="inline-block shrink-0 transition-transform duration-300 group-hover:translate-x-0.5 group-hover:-translate-y-0.5">{h.download ? '↓' : '↗'}</span>
                </p>
              </a>

              {/* Copy button — absolute top-right, escapes the parent <a> */}
              <button
                type="button"
                data-copy={h.copy}
                aria-label={`Copy ${h.label} link`}
                class="card-copy-btn"
              >
                <svg class="h-3.5 w-3.5" data-copy-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                  <rect x="9" y="9" width="11" height="11" rx="2" />
                  <path d="M5 15V6a2 2 0 0 1 2-2h9" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
                <svg class="hidden h-3.5 w-3.5" data-check-icon viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" aria-hidden="true">
                  <path d="M5 12l5 5L20 7" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <style>
    /* Email pill + copy share a single rounded chip — copy reads as part of the same control. */
    .contact-mail-group {
      background: rgba(255, 122, 30, 0.18);
      box-shadow: 0 8px 24px -10px rgba(255, 122, 30, 0.45);
    }
    :global(.dark) .contact-mail-group {
      background: rgba(255, 122, 30, 0.22);
    }
    .contact-copy-btn {
      display: inline-grid;
      place-items: center;
      padding: 0 1rem;
      background: transparent;
      color: #B44000;
      transition: background 220ms ease, color 220ms ease;
      cursor: pointer;
    }
    :global(.dark) .contact-copy-btn {
      color: #FFB079;
    }
    .contact-copy-btn:hover {
      background: rgba(255, 122, 30, 0.22);
      color: #8A2F00;
    }
    :global(.dark) .contact-copy-btn:hover {
      background: rgba(255, 122, 30, 0.28);
      color: #FFD2AF;
    }
    .card-copy-btn {
      position: absolute;
      top: 0.55rem;
      right: 0.55rem;
      display: inline-grid;
      place-items: center;
      height: 26px;
      width: 26px;
      border-radius: 8px;
      border: 1px solid var(--hair);
      background: var(--surface);
      color: var(--ink-muted);
      transition: background 220ms ease, color 220ms ease, transform 200ms ease;
      cursor: pointer;
      z-index: 2;
    }
    .card-copy-btn:hover {
      background: var(--cow-pink-soft);
      color: var(--ink);
      transform: translateY(-1px);
    }
    .card-copy-btn[data-copied='true'] {
      background: var(--cow-pink-soft);
      color: var(--cow-pink);
    }
  </style>

  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) => {
      btn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const text = btn.dataset.copy;
        if (!text) return;
        try {
          await navigator.clipboard.writeText(text);
        } catch {
          /* silent */
        }
        const copyIcon = btn.querySelector<HTMLElement>('[data-copy-icon]');
        const checkIcon = btn.querySelector<HTMLElement>('[data-check-icon]');
        if (copyIcon && checkIcon) {
          copyIcon.classList.add('hidden');
          checkIcon.classList.remove('hidden');
          btn.dataset.copied = 'true';
          setTimeout(() => {
            copyIcon.classList.remove('hidden');
            checkIcon.classList.add('hidden');
            delete btn.dataset.copied;
          }, 1600);
        }
      });
    });
  </script>
</section>
