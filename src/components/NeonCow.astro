---
// neon cow
const COW_SRC = '/assets/cow.png';
---

<button
  type="button"
  class="neon-cow group relative inline-block focus:outline-none"
  aria-label="moo!"
  data-cursor-hover
  data-neon-cow
>
  {/* moo bubble */}
  <span
    class="moo pointer-events-none absolute -top-4 left-4 -translate-y-full select-none rounded-2xl rounded-bl-md px-3.5 py-1.5 opacity-0 scale-90 transition-all duration-300 group-hover:opacity-100 group-hover:scale-100"
    style="background:#DC9BB5; color:#0F0F10; font-family:'Fraunces Variable', Fraunces, serif; font-style:italic; font-weight:600; font-size:15px; line-height:1; letter-spacing:-0.01em; box-shadow:0 10px 28px -8px rgba(220,155,181,0.55), 0 0 0 1px rgba(220,155,181,0.4) inset;"
  >moo!</span>

  <div class="cow-stage relative inline-block h-28 sm:h-32 lg:h-36 aspect-[5/4]">
    {/* base cow */}
    <div
      class="cow-base absolute inset-0"
      style={`-webkit-mask: url(${COW_SRC}) center / contain no-repeat; mask: url(${COW_SRC}) center / contain no-repeat; background: var(--ink);`}
    ></div>

    {/* trail */}
    <canvas
      class="cow-trail absolute inset-0 h-full w-full pointer-events-none"
      data-cow-canvas
      style={`-webkit-mask: url(${COW_SRC}) center / contain no-repeat; mask: url(${COW_SRC}) center / contain no-repeat;`}
    ></canvas>
  </div>
</button>

<style>
  .neon-cow {
    color: var(--ink);
    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
    background: transparent;
    border: 0;
    padding: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
  }
  .neon-cow:hover {
    transform: translateY(-2px);
  }
  .cow-base {
    transition: background 400ms ease;
  }
  .neon-cow:hover .cow-base,
  .neon-cow[data-painting='true'] .cow-base {
    /* dim */
    background: var(--ink-muted);
  }
  /* tap */
  .neon-cow[data-moo='true'] .moo {
    opacity: 1;
    transform: translateY(-100%) scale(1);
  }
</style>

<script>
  // pink trail
  document.querySelectorAll<HTMLElement>('[data-neon-cow]').forEach((host) => {
    const stage = host.querySelector<HTMLElement>('.cow-stage');
    const canvas = host.querySelector<HTMLCanvasElement>('[data-cow-canvas]');
    if (!stage || !canvas) return;

    const ctx = canvas.getContext('2d');
    if (!ctx) return;

    const dpr = Math.min(window.devicePixelRatio || 1, 2);

    const resize = () => {
      const rect = stage.getBoundingClientRect();
      canvas.width = Math.max(1, rect.width * dpr);
      canvas.height = Math.max(1, rect.height * dpr);
      canvas.style.width = `${rect.width}px`;
      canvas.style.height = `${rect.height}px`;
    };
    resize();
    window.addEventListener('resize', resize);

    type Drop = { x: number; y: number; t: number; r: number };
    const drops: Drop[] = [];

    let lastDrop = 0;

    const addDropAt = (clientX: number, clientY: number) => {
      const rect = stage.getBoundingClientRect();
      const x = (clientX - rect.left) * dpr;
      const y = (clientY - rect.top) * dpr;
      const now = performance.now();
      if (now - lastDrop < 18) return;
      lastDrop = now;
      drops.push({ x, y, t: now, r: 36 * dpr });
    };

    host.addEventListener('mousemove', (e) => addDropAt(e.clientX, e.clientY));
    host.addEventListener('mouseleave', () => { lastDrop = 0; });

    // touch
    let touchStartTime = 0;
    let touchStartX = 0;
    let touchStartY = 0;
    let didDrag = false;

    host.addEventListener('touchstart', (e) => {
      const t = e.touches[0];
      touchStartTime = performance.now();
      touchStartX = t.clientX;
      touchStartY = t.clientY;
      didDrag = false;
      host.dataset.painting = 'true';
    }, { passive: true });

    host.addEventListener('touchmove', (e) => {
      const t = e.touches[0];
      const dx = t.clientX - touchStartX;
      const dy = t.clientY - touchStartY;
      if (Math.hypot(dx, dy) > 6) didDrag = true;
      addDropAt(t.clientX, t.clientY);
    }, { passive: true });

    host.addEventListener('touchend', () => {
      delete host.dataset.painting;
      const elapsed = performance.now() - touchStartTime;
      if (!didDrag && elapsed < 300) {
        host.dataset.moo = 'true';
        setTimeout(() => { delete host.dataset.moo; }, 1100);
      }
      lastDrop = 0;
    });
    host.addEventListener('touchcancel', () => {
      delete host.dataset.painting;
      lastDrop = 0;
    });

    const LIFESPAN = 2500;

    // visibility
    let onScreen = false;
    let rafId: number | null = null;

    const render = () => {
      if (!onScreen && !drops.length) {
        rafId = null;
        return;
      }
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      const now = performance.now();
      while (drops.length && now - drops[0].t > LIFESPAN) drops.shift();

      for (const d of drops) {
        const age = (now - d.t) / LIFESPAN;
        const alpha = Math.pow(1 - age, 1.4);
        const radius = d.r * (1 + age * 0.8);
        const grad = ctx.createRadialGradient(d.x, d.y, 0, d.x, d.y, radius);
        grad.addColorStop(0, `rgba(220, 155, 181, ${alpha})`);
        grad.addColorStop(0.45, `rgba(255, 122, 30, ${alpha * 0.5})`);
        grad.addColorStop(1, 'rgba(220, 155, 181, 0)');
        ctx.fillStyle = grad;
        ctx.beginPath();
        ctx.arc(d.x, d.y, radius, 0, Math.PI * 2);
        ctx.fill();
      }

      rafId = requestAnimationFrame(render);
    };

    const start = () => { if (rafId === null) rafId = requestAnimationFrame(render); };

    const io = new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      if (onScreen) start();
    }, { rootMargin: '100px' });
    io.observe(stage);
  });
</script>
