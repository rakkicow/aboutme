---
// terminal card
export interface Props {
  isStandalone?: boolean;
}
const { isStandalone = false } = Astro.props;
---

{isStandalone ? null : (
<div class="pointer-events-none absolute inset-0 -z-0 overflow-hidden rounded-[28px]">
  <div class="absolute inset-0" style="background: linear-gradient(165deg, #2E3A52 0%, #232E44 50%, #1A2235 100%);"></div>

  <div class="absolute -top-20 -right-12 h-72 w-72 rounded-full animate-mesh-drift" style="background: radial-gradient(circle, rgba(220,155,181,0.7), transparent 60%); filter: blur(60px);"></div>
  <div class="absolute -bottom-24 -left-10 h-72 w-72 rounded-full animate-mesh-drift-2" style="background: radial-gradient(circle, rgba(57,255,20,0.18), transparent 65%); filter: blur(80px);"></div>
  <div class="absolute right-1/4 top-1/2 h-48 w-48 rounded-full animate-mesh-drift-3" style="background: radial-gradient(circle, rgba(184,91,130,0.45), transparent 65%); filter: blur(50px);"></div>

  {/* grid */}
  <div class="card-grid absolute inset-0 opacity-[0.08]" style="--grid-cell: 32px;" aria-hidden="true"></div>
</div>
)}

{/* terminal window */}
<div class={isStandalone ? "w-full h-full" : "-mx-2 w-[calc(100%+16px)] sm:mx-0 sm:w-full"} style="container-type: inline-size;">
<div class={`term-window relative flex w-full flex-col overflow-hidden transition-all duration-300 ease-out ${isStandalone ? 'bg-black h-[100svh]' : 'bg-[#0E1620]/95 backdrop-blur-sm rounded-2xl border border-cow-300/20 shadow-2xl cursor-pointer hover:shadow-[0_20px_40px_rgba(0,0,0,0.4)] hover:border-cow-300/40'}`} data-standalone={isStandalone ? "true" : "false"}>
  {/* title bar */}
  <div class="flex items-center justify-between border-b border-cow-300/15 bg-white/[0.04] px-3 py-2">
    <div class="group flex items-center gap-1.5">
      <span id="term-close-btn" class="relative flex h-3 w-3 cursor-pointer items-center justify-center rounded-full bg-[#FF5F57]" title="Exit Interactive Mode">
        <svg class="opacity-0 transition-opacity duration-100 group-hover:opacity-100 w-2 h-2 text-black/60" viewBox="0 0 10 10">
          <path stroke="currentColor" stroke-linecap="round" stroke-width="1.2" d="M2 2l6 6M8 2L2 8"></path>
        </svg>
      </span>
      <span id="term-minimize-btn" class="relative flex h-3 w-3 cursor-pointer items-center justify-center rounded-full bg-[#FEBC2E]" title="Scroll to Next Section">
        <svg class="opacity-0 transition-opacity duration-100 group-hover:opacity-100 w-2 h-2 text-black/60" viewBox="0 0 10 10">
          <path stroke="currentColor" stroke-linecap="round" stroke-width="1.5" d="M2 5h6"></path>
        </svg>
      </span>
      <span id="term-fullscreen-btn" class="relative flex h-3 w-3 cursor-pointer items-center justify-center rounded-full bg-[#28C840]" title="Toggle Fullscreen">
        <svg class="opacity-0 transition-opacity duration-100 group-hover:opacity-100 w-1.5 h-1.5 text-black/60" viewBox="0 0 6 6">
          <path fill="currentColor" d="M3.5,0 L6,0 L6,2.5 L5,1.5 L3.5,3 L3,2.5 L4.5,1 L3.5,0 Z M2.5,6 L0,6 L0,3.5 L1,4.5 L2.5,3 L3,3.5 L1.5,5 L2.5,6 Z"/>
        </svg>
      </span>
    </div>
    <span class="font-mono text-[10px] text-cow-200">ria@rakshita.me<span class="term-title-extra"> — zsh — 80×24</span></span>
    <span class="w-10"></span>
  </div>

  {/* body */}
  <div class="term-body relative grow px-3 py-2.5 font-mono leading-[1.45] overflow-y-auto overflow-x-auto scrollbar-hide">
    <div id="term-history">
      <div class="text-cow-300">~/ <span class="text-cow-400">$</span> <span style="color:#39FF14;">neofetch</span></div>

    {/* columns */}
    <div class="term-grid mt-1.5 grid grid-cols-[max-content_1fr] gap-x-3 items-center">
      {/* cow */}
      <pre class="term-cow justify-self-center px-2 leading-[1.1]" style="color:#DC9BB5; text-shadow: 0 0 8px rgba(220,155,181,0.25);">
\|/          (__)    
     `\------(oo)
       ||    (__)
       ||w--||     \|/
   \|/
</pre>

      {/* info */}
      <pre class="leading-[1.45]" style="text-shadow: 0 0 8px rgba(57,255,20,0.15);"><span style="color:#39FF14;">ria</span><span style="color:#7CE57C;">@</span><span style="color:#39FF14;">rakshita.me</span>
<span style="color:#7CE57C;">─────────────────</span>
<span style="color:#DC9BB5;">OS</span><span style="color:#7CE57C;">: macOS</span>
<span style="color:#DC9BB5;">Host</span><span style="color:#7CE57C;">: MacBook Air M5</span>
<span style="color:#DC9BB5;">Uptime</span><span style="color:#7CE57C;">: </span><span data-uptime style="color:#7CE57C;">…</span>
<span style="color:#DC9BB5;">Resolution</span><span style="color:#7CE57C;">: </span><span data-resolution style="color:#7CE57C;">…</span>
<span style="color:#DC9BB5;">Weather</span><span style="color:#7CE57C;">: </span><a href="/weather" class="wx-line" data-weather-link data-weather style="color:#7CE57C;">…</a>
<span style="color:#DC9BB5;">Coffee</span><span style="color:#7CE57C;">: </span><span style="color:#FFB37A;">critical</span>
<span style="color:#DC9BB5;">Cow</span><span style="color:#7CE57C;">: </span><span style="color:#DC9BB5;">🐄 essential</span></pre>
    </div>

    {/* now playing */}
    <div class="np-row mt-2" data-np-row>
      <span class="shrink-0" data-np-label style="color:#DC9BB5;">Playing</span><span class="shrink-0" style="color:#7CE57C;">:&nbsp;</span>
      <span class="np-wave" data-np-wave aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></span>
      <a class="np-text" data-np-link href="https://open.spotify.com" target="_blank" rel="noopener noreferrer" style="color:#7CE57C;"><span data-np-text>…</span></a>
    </div>

    </div>

    {/* output */}
    <div id="term-interactive-output"></div>

    {/* prompt */}
    <div class="mt-2 text-cow-300 flex items-center cursor-text" id="term-prompt-line">
      <span class="shrink-0">~/</span> <span class="text-cow-400 shrink-0 mx-1.5">$</span> 
      {/* spacer */}
      <span class="typer shrink-0" id="auto-typer" style="color:#39FF14; white-space:pre;"></span>
      <div class="relative flex-1 m-0 flex items-center">
        <span class="inline-block h-3 w-[7px] shrink-0 animate-caret absolute left-0 pointer-events-none" id="term-caret" style="background:#39FF14;"></span>
        <form id="term-form" class="hidden w-full m-0">
          <input type="text" id="term-input" autocomplete="off" spellcheck="false" class="w-full bg-transparent border-none outline-none text-transparent caret-transparent font-mono p-0 m-0 leading-none pl-2" />
        </form>
      </div>
    </div>
  </div>

  {/* scanline */}
  <div class="pointer-events-none absolute inset-0" style="background: linear-gradient(180deg, transparent 0%, rgba(57,255,20,0.04) 50%, transparent 100%); background-size: 100% 4px;"></div>
</div>
</div>

<style>
  /* emoji fallback */
  .term-body {
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas,
      'Liberation Mono', 'Courier New', monospace, 'Apple Color Emoji',
      'Segoe UI Emoji', 'Noto Color Emoji';
  }
  /* sizing */
  .term-window:not([data-standalone="true"]) {
    min-height: 62.5cqw;
  }
  .term-window:not([data-standalone="true"]) .term-body {
    font-size: clamp(7.5px, 1.8cqw, 24px);
  }
  .term-window[data-standalone="true"] .term-body {
    font-size: clamp(13px, 2.5vw, 36px);
  }
  .term-cow {
    font-size: 1.08em;
  }
  /* clip */
  .term-grid > pre:last-child {
    min-width: 0;
    white-space: pre-wrap;
    word-break: break-word;
  }
  /* narrow */
  @container (max-width: 550px) {
    .term-grid {
      grid-template-columns: 1fr;
      row-gap: 12px;
      justify-items: start;
    }
    .term-title-extra {
      display: none;
    }
  }
  @media (max-width: 550px) {
    .term-window[data-standalone="true"] .term-grid {
      grid-template-columns: 1fr;
      row-gap: 12px;
      justify-items: start;
    }
    .term-window[data-standalone="true"] .term-title-extra {
      display: none;
    }
  }

  /* now playing */
  .np-row {
    display: none;
    align-items: center;
    min-width: 0;
  }
  .np-row.np-on {
    display: flex;
  }
  .np-text {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .np-text:hover {
    color: #39ff14 !important;
  }
  /* weather link */
  .wx-line {
    text-decoration: none;
    cursor: pointer;
    transition: color 0.2s ease;
  }
  .wx-line:hover {
    color: #39ff14 !important;
  }
  /* bars */
  .np-wave {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    height: 1.05em;
    margin-right: 0.55em;
    flex-shrink: 0;
  }
  .np-wave span {
    width: 2px;
    border-radius: 2px;
    background: #39ff14;
    box-shadow: 0 0 6px rgba(57, 255, 20, 0.45);
  }
  .np-wave span:nth-child(1) { animation: np-eq1 1.7s ease-in-out infinite; }
  .np-wave span:nth-child(2) { animation: np-eq2 2.1s ease-in-out infinite; }
  .np-wave span:nth-child(3) { animation: np-eq3 1.45s ease-in-out infinite; }
  .np-wave span:nth-child(4) { animation: np-eq4 2.3s ease-in-out infinite; }
  .np-wave span:nth-child(5) { animation: np-eq5 1.85s ease-in-out infinite; }
  @keyframes np-eq1 {
    0%, 100% { height: 35%; }
    30% { height: 85%; }
    55% { height: 45%; }
    80% { height: 95%; }
  }
  @keyframes np-eq2 {
    0%, 100% { height: 80%; }
    25% { height: 40%; }
    50% { height: 100%; }
    75% { height: 30%; }
  }
  @keyframes np-eq3 {
    0%, 100% { height: 55%; }
    35% { height: 100%; }
    65% { height: 25%; }
  }
  @keyframes np-eq4 {
    0%, 100% { height: 40%; }
    20% { height: 90%; }
    45% { height: 55%; }
    70% { height: 100%; }
  }
  @keyframes np-eq5 {
    0%, 100% { height: 70%; }
    30% { height: 30%; }
    60% { height: 90%; }
    85% { height: 45%; }
  }
  /* paused */
  .np-wave[data-paused] {
    display: none;
  }
</style>

<script>
  // uptime
  const epoch = new Date(2026, 4, 29, 2, 0, 0).getTime(); // month starts at 0
  const uptimeEls = document.querySelectorAll<HTMLElement>('[data-uptime]');
  const resEls = document.querySelectorAll<HTMLElement>('[data-resolution]');

  const fmtUptime = (ms: number) => {
    if (ms < 0) return '0 mins';
    const totalMin = Math.floor(ms / 60000);
    const mins = totalMin % 60;
    const totalHr = Math.floor(totalMin / 60);
    const hrs = totalHr % 24;
    const days = Math.floor(totalHr / 24);
    if (days > 0) return `${days}d ${hrs}h ${mins}m`;
    if (hrs > 0) return `${hrs}h ${mins}m`;
    return `${mins} mins`;
  };

  const updateRes = () => {
    const w = window.innerWidth;
    const h = window.innerHeight;
    const text = `${w}×${h}`;
    resEls.forEach((el) => (el.textContent = text));
  };

  const tickUptime = () => {
    const now = Date.now();
    const text = fmtUptime(now - epoch);
    uptimeEls.forEach((el) => (el.textContent = text));
  };

  if (uptimeEls.length) {
    tickUptime();
    setInterval(tickUptime, 30000); // refresh
  }
  if (resEls.length) {
    updateRes();
    window.addEventListener('resize', updateRes);
  }

  // weather
  const wxEls = document.querySelectorAll<HTMLElement>('[data-weather]');
  if (wxEls.length) {
    // emoji
    const wxEmoji = (code: number, isDay: boolean): string => {
      // safe emoji only
      if (code === 0) return isDay ? '☀️' : '🌙';
      if (code <= 2) return isDay ? '⛅' : '☁️';
      if (code === 3) return '☁️';
      if (code <= 48) return '☁️';
      if (code <= 67) return '☔';
      if (code <= 77) return '❄️';
      if (code <= 82) return '☔';
      if (code <= 86) return '❄️';
      return '⚡';
    };

    const loadWeather = async () => {
      try {
        const res = await fetch(
          'https://api.open-meteo.com/v1/forecast?latitude=40.4259&longitude=-86.9081' +
            '&current=temperature_2m,weather_code,is_day&temperature_unit=fahrenheit&timezone=auto'
        );
        if (!res.ok) return;
        const cur = (await res.json())?.current;
        if (!cur) return;
        const text = `${Math.round(cur.temperature_2m)}°${wxEmoji(Number(cur.weather_code), cur.is_day === 1)} in W. Lafayette, IN`;
        wxEls.forEach((el) => (el.textContent = text));
      } catch {
        /* offline */
      }
    };
    loadWeather();
    setInterval(loadWeather, 900000); // 15 min
  }

  // now playing
  const LASTFM_USER = 'monicow';
  const LASTFM_API_KEY = 'dbfa4fc22fc71c3ff51db00e997de815';

  const npRows = document.querySelectorAll<HTMLElement>('[data-np-row]');

  // colors
  const extractColors = (img: HTMLImageElement): string[] => {
    const size = 24;
    const canvas = document.createElement('canvas');
    canvas.width = size;
    canvas.height = size;
    const ctx = canvas.getContext('2d', { willReadFrequently: true });
    if (!ctx) return [];
    ctx.drawImage(img, 0, 0, size, size);
    let data: Uint8ClampedArray;
    try {
      data = ctx.getImageData(0, 0, size, size).data;
    } catch {
      return []; // cors blocked
    }
    const buckets = new Map<number, { r: number; g: number; b: number; n: number; score: number }>();
    for (let i = 0; i < data.length; i += 4) {
      const r = data[i], g = data[i + 1], b = data[i + 2];
      const max = Math.max(r, g, b);
      const sat = max === 0 ? 0 : (max - Math.min(r, g, b)) / max;
      const key = ((r >> 4) << 8) | ((g >> 4) << 4) | (b >> 4);
      const e = buckets.get(key) ?? { r: 0, g: 0, b: 0, n: 0, score: 0 };
      e.r += r; e.g += g; e.b += b; e.n++;
      e.score += 0.15 + sat + (max > 50 && max < 245 ? 0.3 : 0);
      buckets.set(key, e);
    }
    const sorted = [...buckets.values()]
      .sort((a, b) => b.score - a.score)
      .map((e) => ({ r: e.r / e.n, g: e.g / e.n, b: e.b / e.n }));
    const picked: { r: number; g: number; b: number }[] = [];
    for (const c of sorted) {
      if (picked.every((p) => Math.hypot(p.r - c.r, p.g - c.g, p.b - c.b) > 60)) picked.push(c);
      if (picked.length === 3) break;
    }
    return picked.map((p) => {
      const mx = Math.max(p.r, p.g, p.b, 1);
      const s = mx < 120 ? 120 / mx : 1; // brighten
      return `rgb(${(p.r * s) | 0}, ${(p.g * s) | 0}, ${(p.b * s) | 0})`;
    });
  };

  const applyWaveColors = (colors: string[]) => {
    npRows.forEach((row) => {
      row.querySelectorAll<HTMLElement>('[data-np-wave] span').forEach((bar, i) => {
        const col = colors.length ? colors[i % colors.length] : '';
        bar.style.background = col;
        bar.style.boxShadow = col ? `0 0 6px ${col}` : '';
      });
    });
  };

  if (LASTFM_USER && LASTFM_API_KEY && npRows.length) {
    let lastArt = '';
    const endpoint =
      'https://ws.audioscrobbler.com/2.0/?' +
      new URLSearchParams({
        method: 'user.getrecenttracks',
        user: LASTFM_USER,
        api_key: LASTFM_API_KEY,
        format: 'json',
        limit: '1',
      });
    const updateNowPlaying = async () => {
      try {
        const res = await fetch(endpoint);
        if (!res.ok) return;
        const data = await res.json();
        const t = data?.recenttracks?.track?.[0];
        if (!t?.name) return;
        const isPlaying = t['@attr']?.nowplaying === 'true';
        npRows.forEach((row) => {
          row.classList.add('np-on');
          const label = row.querySelector<HTMLElement>('[data-np-label]');
          if (label) label.textContent = isPlaying ? 'Playing' : 'Last Played';
          row.querySelector<HTMLElement>('[data-np-wave]')?.toggleAttribute('data-paused', !isPlaying);
          const text = row.querySelector<HTMLElement>('[data-np-text]');
          if (text) text.textContent = `${t.name} — ${t.artist?.['#text'] ?? ''}`;
          const link = row.querySelector<HTMLAnchorElement>('[data-np-link]');
          if (link && t.url) link.href = t.url;
        });

        // bar colors
        type LfmImage = { size: string; '#text': string };
        const art = (t.image as LfmImage[] | undefined)?.find((i) => i.size === 'medium')?.['#text'] || '';

        // expose track
        window._currentTrack = {
          name: t.name,
          artist: t.artist?.['#text'] ?? '',
          artUrl: (t.image as LfmImage[] | undefined)?.find((i) => i.size === 'extralarge')?.['#text'] || art,
          url: t.url || 'https://last.fm',
          isPlaying,
          colors: window._currentTrack?.colors || []
        };

        if (art && art !== lastArt) {
          lastArt = art;
          const img = new Image();
          img.crossOrigin = 'anonymous';
          img.onload = () => {
            const colors = extractColors(img);
            if (window._currentTrack) window._currentTrack.colors = colors;
            applyWaveColors(colors);
            window.dispatchEvent(new CustomEvent('trackupdate'));
          };
          img.onerror = () => {
            applyWaveColors([]);
            window.dispatchEvent(new CustomEvent('trackupdate'));
          };
          img.src = art;
        } else if (!art && lastArt) {
          lastArt = '';
          applyWaveColors([]);
          window.dispatchEvent(new CustomEvent('trackupdate'));
        } else {
          // same track
          window.dispatchEvent(new CustomEvent('trackupdate'));
        }
      } catch {
        /* failed */
      }
    };
    updateNowPlaying();
    // poll
    setInterval(updateNowPlaying, 12000);
    document.addEventListener('visibilitychange', () => {
      if (!document.hidden) updateNowPlaying();
    });
  }

  // typing
  const commands = [
    'npm run dev',
    'git status',
    'git push origin main',
    'ssh cow@rakshita.me',
    'ls -la',
    'astro build',
    'chmod +x moo.sh',
    'sudo apt-get update',
    'sbx run',
    'whatsong',
    'weather',
    'walloftext',
    'hack',
    'sudo rm -rf /',
    'echo "moo 🐄"',
    'cat milk.txt'
  ];

  const typerEls = document.querySelectorAll<HTMLElement>('.typer');
  if (typerEls.length) {
    let onScreen = false;
    let running = false;
    let interactive = false;
    let inGame = false;
    let lastCmdIdx = -1;

    const termWindow = document.querySelector('.term-window') as HTMLElement;
    const autoTyper = document.getElementById('auto-typer') as HTMLElement;
    const termForm = document.getElementById('term-form') as HTMLFormElement;
    const termInput = document.getElementById('term-input') as HTMLInputElement;
    const termCaret = document.getElementById('term-caret') as HTMLElement;
    const interactiveOutput = document.getElementById('term-interactive-output') as HTMLElement;
    const termBody = document.querySelector('.term-body') as HTMLElement;

    const wait = (ms: number) =>
      new Promise<void>((resolve) => {
        const start = performance.now();
        const check = () => {
          if (!onScreen || interactive) return resolve(); // stop
          if (performance.now() - start >= ms) return resolve();
          requestAnimationFrame(check);
        };
        check();
      });

    const loop = async () => {
      if (running) return;
      running = true;
      while (onScreen && !interactive) {
        for (const el of typerEls) {
          if (interactive) break;
          let cmdIdx;
          do {
            cmdIdx = Math.floor(Math.random() * commands.length);
          } while (cmdIdx === lastCmdIdx && commands.length > 1);
          lastCmdIdx = cmdIdx;
          const cmd = commands[cmdIdx];
          el.textContent = '';
          for (let c = 0; c < cmd.length; c++) {
            if (!onScreen || interactive) break;
            el.textContent += cmd[c];
            await wait(70 + Math.random() * 60);
          }
          await wait(1800);
          for (let c = cmd.length; c > 0; c--) {
            if (!onScreen || interactive) break;
            el.textContent = cmd.slice(0, c - 1);
            await wait(30);
          }
          await wait(400);
        }
      }
      running = false;
    };

    const io = new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      if (onScreen && !interactive) loop();
    }, { rootMargin: '100px' });
    io.observe(typerEls[0]);

    // game
    if (termWindow && termForm && termInput) {
      const termHistory = document.getElementById('term-history') as HTMLElement;
      let gameLoaded = false;

      const activateTerminal = async () => {
        if (!interactive) {
          interactive = true;
          // lock height
          if (!document.fullscreenElement) {
            termWindow.style.height = termWindow.getBoundingClientRect().height + 'px';
          }
          // keep typer
          autoTyper.textContent = ''; // clear
          if (termHistory) termHistory.style.display = 'none';
          termForm.classList.remove('hidden');
          termForm.classList.add('flex');
          termInput.focus();
          
          // greeting
          const msg = document.createElement('div');
          msg.className = 'mt-1 mb-2 opacity-80';
          msg.innerHTML = '<span style="color:#FEBC2E">Terminal overridden.</span> Manual input enabled.<br/>Type <span style="color:#39FF14">help</span> to view commands.';
          interactiveOutput.appendChild(msg);
          termBody.scrollTop = termBody.scrollHeight;

          // load game
          if (!gameLoaded) {
            gameLoaded = true;
            try {
              // @ts-ignore
              const { initGame } = await import('../lib/terminalPlus.ts');
              initGame(termForm, termInput, interactiveOutput, termBody, termCaret, () => {

                // on exit
                interactive = false;
                termWindow.style.height = ''; // unlock
                autoTyper.style.display = 'inline';
                if (termHistory) termHistory.style.display = 'block';
                termForm.classList.add('hidden');
                termForm.classList.remove('flex');
                interactiveOutput.innerHTML = '';
                termInput.blur();
                if (onScreen) loop();
              });
            } catch (err) {
               console.error("Failed to load terminal game engine:", err);
            }
          }
        } else {
          termInput.focus();
        }
      };

      termWindow.addEventListener('click', (e) => {
        e.stopPropagation(); // stop click
        activateTerminal();
      });

      // track link
      const npLinks = document.querySelectorAll('[data-np-link]');
      npLinks.forEach(link => {
        link.addEventListener('click', async (e) => {
          e.preventDefault();
          e.stopPropagation();
          await activateTerminal();
          setTimeout(() => {
            if ((window as any)._runTerminalCommand) {
              (window as any)._runTerminalCommand('whatsong');
            }
          }, 50);
        });
      });

      // weather link
      document.querySelectorAll('[data-weather-link]').forEach(link => {
        link.addEventListener('click', async (e) => {
          e.preventDefault();
          e.stopPropagation();
          await activateTerminal();
          setTimeout(() => {
            if ((window as any)._runTerminalCommand) {
              (window as any)._runTerminalCommand('weather');
            }
          }, 50);
        });
      });
      const fullscreenBtn = document.getElementById('term-fullscreen-btn');
      if (fullscreenBtn) {
        fullscreenBtn.addEventListener('click', async (e) => {
          e.stopPropagation();
          const isStandalone = termWindow.getAttribute('data-standalone') === 'true';
          if (!isStandalone) {
             window.location.href = '/terminal';
             return;
          }
          if (!document.fullscreenElement) {
            await document.documentElement.requestFullscreen().catch(() => {});
            if (!interactive) activateTerminal();
          } else {
            if (document.exitFullscreen) document.exitFullscreen();
          }
        });
      }

      const closeBtn = document.getElementById('term-close-btn');
      if (closeBtn) {
        closeBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          if (document.fullscreenElement && document.exitFullscreen) document.exitFullscreen();
          if (interactive && (window as any)._runTerminalCommand) {
            (window as any)._runTerminalCommand('exit');
          }
          const isStandalone = termWindow.getAttribute('data-standalone') === 'true';
          if (isStandalone) {
             window.location.href = '/';
          }
        });
      }

      const minimizeBtn = document.getElementById('term-minimize-btn');
      if (minimizeBtn) {
        minimizeBtn.addEventListener('click', (e) => {
          e.stopPropagation();
          if (document.fullscreenElement && document.exitFullscreen) document.exitFullscreen();
          const isStandalone = termWindow.getAttribute('data-standalone') === 'true';
          if (isStandalone) {
             window.location.href = '/#eras';
             return;
          }
          const workSection = document.getElementById('eras');
          if (workSection) {
             workSection.scrollIntoView({ behavior: 'smooth' });
          }
        });
      }

      document.addEventListener('fullscreenchange', () => {
        if (document.fullscreenElement === termWindow) {
          termWindow.style.height = '100vh';
          termWindow.style.width = '100vw';
          termWindow.style.maxWidth = 'none';
        } else {
          termWindow.style.width = '';
          termWindow.style.maxWidth = '';
          if (interactive) {
            termWindow.style.height = termWindow.getBoundingClientRect().height + 'px';
          } else {
            termWindow.style.height = '';
          }
        }
        
        // resize
        setTimeout(() => {
          if ((window as any)._runTerminalCommand) {
            const out = document.getElementById('term-interactive-output');
            if (out && out.querySelector('.whatsong-view')) {
              (window as any)._runTerminalCommand('whatsong');
            }
          }
        }, 100);
      });
    }
  }
</script>
