---
// og image
import '~/styles/global.css';
import Monogram from '~/components/Monogram.astro';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <meta name="robots" content="noindex, nofollow" />
    <style>
      html,
      body {
        margin: 0;
        padding: 0;
      }
      astro-dev-toolbar {
        display: none !important;
      }
      .og {
        width: 1200px;
        height: 630px;
        position: relative;
        overflow: hidden;
        background: radial-gradient(120% 90% at 82% 18%, #ffe9d8 0%, #fdf7f2 45%, #fafafa 100%);
        display: flex;
        flex-direction: column;
        justify-content: center;
        padding: 0 96px;
        box-sizing: border-box;
      }
      .blob {
        position: absolute;
        border-radius: 999px;
        filter: blur(70px);
      }
      .b1 {
        width: 460px;
        height: 460px;
        right: -80px;
        top: -120px;
        background: radial-gradient(circle, rgba(255, 122, 30, 0.55), transparent 65%);
      }
      .b2 {
        width: 380px;
        height: 380px;
        right: 120px;
        bottom: -160px;
        background: radial-gradient(circle, rgba(220, 155, 181, 0.45), transparent 65%);
      }
      .mono {
        margin-bottom: 40px;
      }
      .name {
        font-family: 'Fraunces Variable', Fraunces, serif;
        font-variation-settings: 'opsz' 144, 'SOFT' 55;
        font-size: 130px;
        line-height: 0.95;
        letter-spacing: -0.035em;
        color: #0f0f10;
        margin: 0;
      }
      .role {
        margin: 26px 0 0;
        font-family: 'Inter Variable', Inter, sans-serif;
        font-size: 34px;
        font-weight: 500;
        letter-spacing: 0.32em;
        text-transform: uppercase;
        color: #b44000;
      }
      .url {
        position: absolute;
        left: 96px;
        bottom: 60px;
        font-family: 'Inter Variable', Inter, sans-serif;
        font-size: 26px;
        font-weight: 500;
        letter-spacing: 0.04em;
        color: rgba(15, 15, 16, 0.5);
      }
    </style>
  </head>
  <body>
    <div class="og">
      <span class="blob b1"></span>
      <span class="blob b2"></span>
      <div class="mono"><Monogram size={96} stroke={1.2} withGlow /></div>
      <h1 class="name">Rakshita&nbsp;Gupta</h1>
      <p class="role">Computer Engineer</p>
      <span class="url">rakshita.me</span>
    </div>
  </body>
</html>
