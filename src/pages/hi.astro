---
// link hub: rakshita.me/hi (resume QR + NFC target)
// Standalone on purpose: Base.astro ships GSAP, Lenis, and the custom cursor.
import '~/styles/global.css';
import Monogram from '~/components/Monogram.astro';
import { bio, resumeFullPdf } from '~/data/resume';
import Analytics from '~/components/Analytics.astro';

const title = 'Ria Gupta · Links';
const description =
  'Quick links for Rakshita (Ria) Gupta, a Computer Engineering Technology student at Purdue (Class of 2028): LinkedIn, resume, projects, GitHub, and email.';

const site = Astro.site ?? new URL('https://rakshita.me');
const canonical = new URL('/hi', site).href;
const ogImage = new URL('/assets/og.png', site).href;
const githubHandle = new URL(bio.github).pathname.split('/').filter(Boolean)[0];

type IconName = 'resume' | 'projects' | 'github' | 'portfolio' | 'email';

// same drawings as Contact.astro where one exists
const icons: Record<IconName, { filled?: boolean; body: string }> = {
  resume: {
    body: '<path d="M14 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V8z"/><path d="M14 3v5h5M8.5 13h7M8.5 17h4.5"/>',
  },
  projects: {
    body: '<rect x="3.5" y="3.5" width="7" height="7" rx="2"/><rect x="13.5" y="3.5" width="7" height="7" rx="2"/><rect x="3.5" y="13.5" width="7" height="7" rx="2"/><rect x="13.5" y="13.5" width="7" height="7" rx="2"/>',
  },
  github: {
    filled: true,
    body: '<path d="M12 .297c-6.63 0-12 5.373-12 12 0 5.303 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 18.07 3.633 17.7 3.633 17.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 22.092 24 17.592 24 12.297c0-6.627-5.373-12-12-12"/>',
  },
  portfolio: {
    body: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18"/><path d="M12 3a15 15 0 0 1 0 18 15 15 0 0 1 0-18Z"/>',
  },
  email: {
    body: '<rect x="3" y="5" width="18" height="14" rx="2.5"/><path d="M3.5 6.5l8.5 7 8.5-7"/>',
  },
};

const strokeAttrs = {
  fill: 'none',
  stroke: 'currentColor',
  'stroke-width': '1.8',
  'stroke-linecap': 'round',
  'stroke-linejoin': 'round',
};

// #eras = "Selected works" on the home page (same target as the hero CTA)
const links: { label: string; href: string; icon: IconName; meta?: string }[] = [
  { label: 'Full Resume', href: resumeFullPdf, icon: 'resume', meta: 'PDF' },
  { label: 'GitHub', href: bio.github, icon: 'github', meta: githubHandle },
  { label: 'Portfolio', href: '/', icon: 'portfolio', meta: 'rakshita.me' },
  { label: 'Email', href: `mailto:${bio.email}`, icon: 'email', meta: bio.email },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FAFAFA" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0A0E1A" media="(prefers-color-scheme: dark)" />
    <link rel="preload" href="/assets/allura-rgme.woff2" as="font" type="font/woff2" crossorigin />

    {/* social (mirrors Base.astro) */}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Rakshita Gupta" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Rakshita Gupta — Computer Engineer" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content={ogImage} />

    {/* icons */}
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/favicon-192.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    {/* theme: same rg-theme key + .dark class as Base.astro */}
    <script is:inline>
      (() => {
        let stored = null;
        try {
          stored = localStorage.getItem('rg-theme');
        } catch {}
        const dark = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
        if (dark) document.documentElement.classList.add('dark');
        // lets iOS Safari apply :active press styles
        document.addEventListener('touchstart', () => {}, { passive: true });
      })();
    </script>
    {/* no-JS: follow the system theme (values mirror .dark in global.css).
        :root:not(.dark) outranks the :root rules in the stylesheets linked below. */}
    <noscript>
      <style is:inline>
        @media (prefers-color-scheme: dark) {
          :root:not(.dark) {
            color-scheme: dark;
            --canvas: #0A0E1A;
            --surface: #131826;
            --surface-soft: rgba(19, 24, 38, 0.7);
            --ink: #F6F0FA;
            --ink-soft: rgba(246, 240, 250, 0.85);
            --hair: rgba(246, 240, 250, 0.08);
            --cow-pink-soft: #2D1A26;
            --hub-accent: #DC9BB5;
            --hub-glow-1: rgba(255, 122, 30, 0.12);
            --hub-glow-2: rgba(184, 91, 130, 0.2);
            --hub-cta-glow: 0 14px 34px -16px rgba(255, 106, 5, 0.5), 0 0 60px -22px rgba(220, 155, 181, 0.55);
            --hub-card-shadow: 0 20px 44px -28px rgba(0, 0, 0, 0.7);
          }
        }
      </style>
    </noscript>
    <Analytics />
  </head>
  <body class="hub-page">
    <div class="hub">
      <main>
        <header>
          <div class="mono" aria-hidden="true">
            <Monogram size={60} stroke={1.3} />
          </div>
          <h1 class="name font-display">Rakshita (Ria) Gupta</h1>
          <p class="degree">
            <span class="nw">Computer Engineering Technology,</span>
            <span class="nw">Purdue · Class of 2028</span>
          </p>
          <p class="focus">Hardware · Software · UX</p>
          <p class="status">
            <span class="beacon" aria-hidden="true"></span>
            Open to Summer ’27 internships
          </p>
        </header>

        <nav class="actions" aria-label="Links">
          <a class="cta" href={bio.linkedin}>
            <span class="cta-badge" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3zM9 9h3.8v1.7h.05c.53-1 1.82-2.05 3.75-2.05C20.4 8.65 21 11 21 14.1V21h-4v-6.1c0-1.45-.03-3.3-2-3.3s-2.3 1.57-2.3 3.2V21H9z" />
              </svg>
            </span>
            <span class="cta-label">Connect on LinkedIn</span>
          </a>

          <ul class="links" role="list">
            {links.map((l) => (
              <li>
                <a class="row" href={l.href}>
                  <svg
                    class:list={['icon', icons[l.icon].filled && 'icon-solid']}
                    viewBox="0 0 24 24"
                    aria-hidden="true"
                    {...(icons[l.icon].filled ? { fill: 'currentColor' } : strokeAttrs)}
                    set:html={icons[l.icon].body}
                  />
                  <span class="label">{l.label}</span>
                  {l.meta && <span class="meta">{l.meta}</span>}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </main>

    </div>

    <style>
      /* page tokens; site tokens (--canvas, --surface, --ink, --hair...) come from global.css */
      :global(:root) {
        color-scheme: light;
        --hub-accent: #9A4267; /* cow-600, 6:1 on canvas */
        --hub-glow-1: rgba(255, 144, 67, 0.2);
        --hub-glow-2: rgba(220, 155, 181, 0.2);
        --hub-cta-glow: 0 14px 30px -14px rgba(228, 82, 0, 0.55), 0 0 44px -18px rgba(255, 144, 67, 0.6);
        --hub-card-shadow: 0 1px 2px rgba(15, 15, 16, 0.04), 0 20px 40px -28px rgba(15, 15, 16, 0.22);
      }
      :global(.dark) {
        color-scheme: dark;
        --hub-accent: #DC9BB5; /* cow-300 */
        --hub-glow-1: rgba(255, 122, 30, 0.12);
        --hub-glow-2: rgba(184, 91, 130, 0.2);
        --hub-cta-glow: 0 14px 34px -16px rgba(255, 106, 5, 0.5), 0 0 60px -22px rgba(220, 155, 181, 0.55);
        --hub-card-shadow: 0 20px 44px -28px rgba(0, 0, 0, 0.7);
      }

      /* glows anchored to the column, not the viewport corners */
      :global(body.hub-page) {
        background-image:
          radial-gradient(520px 340px at calc(50% - 190px) -40px, var(--hub-glow-1), transparent 70%),
          radial-gradient(460px 320px at calc(50% + 210px) -60px, var(--hub-glow-2), transparent 70%);
        background-repeat: no-repeat;
      }
      /* global.css hides the pointer for the custom cursor, which this page skips */
      @media (hover: hover) and (pointer: fine) {
        :global(body.hub-page),
        :global(body.hub-page *) {
          cursor: auto;
        }
        :global(body.hub-page a) {
          cursor: pointer;
        }
      }

      .hub {
        box-sizing: border-box;
        max-width: 440px;
        margin-inline: auto;
        display: flex;
        flex-direction: column;
        min-height: 100vh;
        min-height: 100svh;
        padding:
          max(36px, env(safe-area-inset-top))
          max(20px, env(safe-area-inset-right))
          max(36px, env(safe-area-inset-bottom))
          max(20px, env(safe-area-inset-left));
      }
      /* auto margins centre the column but collapse to 0 when it outgrows the
         viewport, so a short screen scrolls from the top instead of clipping it */
      .hub > main {
        margin-block: auto;
      }

      /* identity */
      .mono {
        display: flex;
      }
      .name {
        margin-top: 22px;
        font-size: clamp(1.75rem, 8.6vw, 2.5rem);
        font-weight: 500;
        line-height: 1.05;
        letter-spacing: -0.03em;
        color: var(--ink);
        text-wrap: balance;
      }
      .degree,
      .meta,
      .foot {
        color: var(--ink-soft);
        color: color-mix(in srgb, var(--ink) 64%, transparent);
      }
      .degree {
        margin-top: 10px;
        font-size: 1rem;
        line-height: 1.45;
      }
      .nw {
        white-space: nowrap;
      }
      .focus {
        margin-top: 4px;
        font-size: 1rem;
        line-height: 1.45;
        font-weight: 560;
        color: var(--hub-accent);
      }
      .status {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        margin-top: 18px;
        padding: 6px 13px 6px 11px;
        border-radius: 999px;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--ink-soft);
        background: var(--surface-soft);
        box-shadow: inset 0 0 0 1px var(--hair);
      }
      .beacon {
        position: relative;
        flex: none;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #16A34A;
        box-shadow: 0 0 0 3px rgba(34, 197, 94, 0.2);
      }

      /* actions */
      .actions {
        margin-top: 28px;
      }
      .cta {
        display: grid;
        grid-template-columns: 44px 1fr 44px;
        align-items: center;
        min-height: 64px;
        padding: 10px;
        border: 1px solid transparent; /* visible in forced-colors mode */
        border-radius: 999px;
        color: #fff;
        /* ember-700 -> ember-800; start shifted so white text stays >= 4.5:1 */
        background: linear-gradient(180deg, #E45200 -20%, #B44000 100%);
        box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.28), var(--hub-cta-glow);
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
        transition: transform 160ms cubic-bezier(0.16, 1, 0.3, 1), filter 160ms ease;
      }
      .cta-badge {
        display: grid;
        place-items: center;
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: #fff;
        color: #0A66C2; /* LinkedIn blue */
      }
      .cta-badge svg {
        width: 20px;
        height: 20px;
      }
      .cta-label {
        text-align: center;
        font-size: 1.125rem;
        font-weight: 620;
        letter-spacing: -0.01em;
      }
      .cta:active {
        filter: brightness(0.94);
      }

      .links {
        margin-top: 12px;
        overflow: hidden;
        border-radius: 22px;
        background: var(--surface);
        box-shadow: 0 0 0 1px var(--hair), var(--hub-card-shadow);
      }
      .row {
        position: relative;
        display: flex;
        align-items: center;
        gap: 14px;
        min-height: 56px;
        padding: 8px 18px;
        font-size: 1rem;
        font-weight: 550;
        color: var(--ink);
        -webkit-tap-highlight-color: transparent;
        touch-action: manipulation;
        transition: background-color 160ms ease;
      }
      li + li .row::before {
        content: '';
        position: absolute;
        top: 0;
        right: 0;
        left: 54px;
        border-top: 1px solid var(--hair);
        border-top-color: color-mix(in srgb, var(--ink) 9%, transparent);
      }
      .icon {
        flex: none;
        width: 22px;
        height: 22px;
        color: var(--ink-soft);
        transition: color 160ms ease;
      }
      /* solid brand mark reads heavier than the stroked icons */
      .icon-solid {
        width: 20px;
        height: 20px;
        margin-inline: 1px;
      }
      .label {
        flex: 1 0 auto;
      }
      .meta {
        min-width: 0;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        font-size: 0.875rem;
        font-weight: 450;
      }
      .row:active {
        background: var(--cow-pink-soft);
      }
      .row:active .icon {
        color: var(--hub-accent);
      }
      /* hide the hairlines touching a highlighted row */
      .row:active::before,
      li:active + li .row::before {
        opacity: 0;
      }
      @media (hover: hover) and (pointer: fine) {
        .row:hover {
          background: var(--cow-pink-soft);
        }
        .row:hover .icon {
          color: var(--hub-accent);
        }
        .row:hover::before,
        li:hover + li .row::before {
          opacity: 0;
        }
        .cta:hover {
          filter: brightness(1.06);
        }
      }

      /* focus */
      .cta:focus-visible {
        outline: 2px solid var(--ink);
        outline-offset: 3px;
      }
      .row:focus-visible {
        outline: none;
      }
      .row:focus-visible::after {
        content: '';
        position: absolute;
        inset: 4px;
        border-radius: 16px;
        box-shadow: 0 0 0 2px var(--ink);
      }
      @media (forced-colors: active) {
        .row:focus-visible {
          outline: 2px solid CanvasText;
          outline-offset: -4px;
        }
      }

      .foot {
        padding-top: 28px;
        font-size: 0.8125rem;
      }

      @media (prefers-reduced-motion: no-preference) {
        .cta:active {
          transform: scale(0.985);
        }
        .beacon::after {
          content: '';
          position: absolute;
          inset: 0;
          border-radius: 50%;
          border: 1.5px solid #22C55E;
          animation: hub-ping 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
        }
        @keyframes hub-ping {
          0% {
            transform: scale(1);
            opacity: 0.8;
          }
          80%,
          100% {
            transform: scale(2.8);
            opacity: 0;
          }
        }
      }

      @media (max-width: 350px) {
        .cta {
          grid-template-columns: 44px 1fr 8px;
        }
      }
      @media (min-width: 640px) {
        .hub {
          padding-block: 48px;
        }
      }
    </style>
  </body>
</html>
