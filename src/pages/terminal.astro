---
import '~/styles/global.css';
import CardTerminal from '~/components/CardTerminal.astro';
---
<!doctype html>
<html lang="en" class="bg-black h-full w-full overflow-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Terminal</title>
    <style is:global>
      #loader {
        --brand-rgb: 57, 255, 20;
      }
      .background-glow {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        width: 240px;
        height: 240px;
        border-radius: 50%;
        background: radial-gradient(circle, rgba(var(--brand-rgb), 0.2) 0%, transparent 70%);
        filter: blur(20px);
        z-index: 0;
        pointer-events: none;
      }
      .section-loading {
        position: relative;
        z-index: 1;
      }
      ul.list-bars {
        list-style: none;
        display: flex;
        align-items: center;
        padding: 0;
        margin: 0;
      }
      ul.list-bars li {
        margin: 0 7px;
        width: 12px;
        border-radius: 12px;
        background: linear-gradient(180deg, rgba(255, 255, 255, 0.2) 0%, rgba(255, 255, 255, 0) 100%),
                    linear-gradient(180deg, rgba(var(--brand-rgb), 0.9) 0%, rgba(var(--brand-rgb), 0.6) 100%);
        border: 1px solid rgba(255, 255, 255, 0.15);
        box-shadow: 
          0 8px 24px rgba(var(--brand-rgb), 0.3),
          inset 0 1px 1px rgba(255, 255, 255, 0.2),
          inset 0 -2px 6px rgba(var(--brand-rgb), 0.4);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        animation: loader-animate 0.8s cubic-bezier(0.4, 0, 0.2, 1) infinite alternate;
      }
      ul.list-bars li:nth-child(odd) { animation-delay: -0.8s; }
      ul.list-bars li:nth-child(even) { animation-delay: 0s; }
      @keyframes loader-animate {
        from { height: 12px; }
        to { height: 80px; }
      }
      .cursor-fx { display: none; }
      @media (hover: hover) and (pointer: fine) {
        .cursor-fx { display: block; }
        /* hide cursor */
        * { cursor: none !important; }
      }
      /* caret */
      #term-caret {
        height: 1.25em !important;
        width: 1ch !important;
      }
    </style>
  </head>
  <body class="h-full w-full m-0 p-0 overflow-hidden text-cow-300 bg-black">
    <div id="loader" class="absolute inset-0 bg-black z-50 flex flex-col justify-center items-center">
      <div class="background-glow"></div>
      <div class="section-loading">
        <ul class="list-bars">
          <li></li><li></li><li></li><li></li><li></li><li></li><li></li>
        </ul>
      </div>
    </div>
    <div class="w-full h-full p-0 sm:p-0">
      <CardTerminal isStandalone={true} />
    </div>

    <div id="term-cursor" class="cursor-fx pointer-events-none fixed left-0 top-0 z-[60] h-8 w-8 -translate-x-1/2 -translate-y-1/2 rounded-full" style="background: radial-gradient(circle, rgba(57,255,20,0.18) 0%, rgba(57,255,20,0) 70%); transition: width 280ms cubic-bezier(0.16, 1, 0.3, 1), height 280ms cubic-bezier(0.16, 1, 0.3, 1);"></div>
    <div id="term-cursor-dot" class="cursor-fx pointer-events-none fixed left-0 top-0 z-[60] h-1.5 w-1.5 -translate-x-1/2 -translate-y-1/2 rounded-full" style="background: #39FF14; box-shadow: 0 0 12px rgba(57,255,20,0.6);"></div>

    <script>
      window.addEventListener('load', () => {
        setTimeout(() => {
          const loader = document.getElementById('loader');
          if (loader) {
            loader.style.transition = 'opacity 0.5s';
            loader.style.opacity = '0';
            setTimeout(() => loader.remove(), 500);
          }
        }, 800);
      });

      const cursor = document.getElementById('term-cursor');
      const dot = document.getElementById('term-cursor-dot');
      const hasFinePointer = typeof window !== 'undefined' && window.matchMedia('(hover: hover) and (pointer: fine)').matches;

      if (cursor && dot && hasFinePointer) {
        window.addEventListener('mousemove', (e) => {
          const x = e.clientX;
          const y = e.clientY;
          dot.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%)`;
          cursor.style.transform = `translate(${x}px, ${y}px) translate(-50%, -50%)`;
        }, { passive: true });

        // cursor
        document.body.addEventListener('mouseover', (e) => {
          const target = e.target as HTMLElement;
          if (target.closest('input, .cursor-text, #term-prompt-line')) {
            // i-beam
            cursor.style.width = '4px';
            cursor.style.height = '24px';
            cursor.style.borderRadius = '2px';
            dot.style.opacity = '0'; // hide dot
          } else if (target.closest('a, button, [data-cursor-hover], .cursor-pointer')) {
            // enlarge
            cursor.style.width = '64px';
            cursor.style.height = '64px';
            cursor.style.borderRadius = '50%';
            dot.style.opacity = '1';
          }
        });
        document.body.addEventListener('mouseout', (e) => {
          const target = e.target as HTMLElement;
          if (target.closest('input, .cursor-text, #term-prompt-line, a, button, [data-cursor-hover], .cursor-pointer')) {
            // restore
            cursor.style.width = '32px';
            cursor.style.height = '32px';
            cursor.style.borderRadius = '50%';
            dot.style.opacity = '1';
          }
        });
      }
    </script>
  </body>
</html>
