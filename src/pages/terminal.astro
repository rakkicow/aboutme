---
import CardTerminal from '~/components/CardTerminal.astro';
---
<!doctype html>
<html lang="en" class="bg-black h-full w-full overflow-hidden">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Terminal</title>
    <style>
      @keyframes bootPulse {
        0% { opacity: 0; }
        50% { opacity: 1; }
        100% { opacity: 0; }
      }
      .boot-text {
        color: #39FF14;
        font-family: monospace;
        font-size: 1.5rem;
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        animation: bootPulse 1s infinite;
      }
    </style>
  </head>
  <body class="h-full w-full m-0 p-0 overflow-hidden text-cow-300 bg-black">
    <div id="loader" class="absolute inset-0 bg-black z-50 flex flex-col justify-center items-center">
      <div class="boot-text">Loading OS...</div>
    </div>
    <div class="w-full h-full p-0 sm:p-0">
      <CardTerminal isStandalone={true} />
    </div>
    <script>
      window.addEventListener('load', () => {
        setTimeout(() => {
          const loader = document.getElementById('loader');
          if (loader) {
            loader.style.transition = 'opacity 0.5s';
            loader.style.opacity = '0';
            setTimeout(() => loader.remove(), 500);
          }
        }, 800);
      });
    </script>
  </body>
</html>
